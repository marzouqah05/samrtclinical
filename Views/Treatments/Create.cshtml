@model WebApplication1.Models.Treatment

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("تسجيل علاج جديد", "Log New Treatment");
    var appointments = ViewBag.Appointments as List<WebApplication1.Models.Appointment> ?? new List<WebApplication1.Models.Appointment>();
    var selectedAppId = ViewBag.SelectedAppointmentId as int?;
}

<div class="max-w-7xl mx-auto px-4 py-8" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back Navigation Link ── *@
    <div class="max-w-2xl mx-auto mb-5">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-medium text-[#727A76] dark:text-[#9CA8A3] hover:text-[#202725] dark:hover:text-[#EAEFEA] transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى سجل العلاجات", "Back to Treatments List")</span>
        </a>
    </div>

    @* ── Solid Dual-Theme Olive Card ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm max-w-2xl mx-auto overflow-hidden p-6 sm:p-8 space-y-5">

        @* ── Card Header ── *@
        <div class="flex items-center gap-3.5 pb-5 border-b border-[#E5E9E7] dark:border-[#2B3833]">
            <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-base shrink-0 border border-[#49665A]/20">
                <i class="fa-solid fa-notes-medical"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0">
                    @T("تسجيل علاج سريري جديد", "Log New Treatment")
                </h1>
                <p class="text-xs text-[#6B7D75] dark:text-[#9CA8A3] m-0 mt-0.5">
                    @T("توثيق الإجراءات السريرية والتشخيص والوصفة الطبية وتكلفة العلاج", "Document clinical procedures, diagnoses, prescriptions, and treatment billing")
                </p>
            </div>
        </div>

        @* ── Form Body ── *@
        <form asp-action="Create" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs"></div>

            @* 1. Appointment Selection *@
            <div>
                <label asp-for="AppointmentId" class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("الموعد المرتبط", "Linked Appointment") *
                </label>
                <select asp-for="AppointmentId"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition">
                    <option value="">@T("-- اختر المريض / الجلسة المعيّنة --", "-- Select Patient / Assigned Session --")</option>
                    @foreach (var app in appointments)
                    {
                        var isSelected = (selectedAppId.HasValue && selectedAppId.Value == app.AppointmentId) || (Model?.AppointmentId == app.AppointmentId);
                        <option value="@app.AppointmentId" selected="@isSelected">
                            #@app.AppointmentId - @(app.Patient?.PatientName ?? "N/A") (Dr. @(app.Doctor?.DoctorName ?? "N/A")) - @app.AppointmentDate.ToString("dd/MM/yyyy")
                        </option>
                    }
                </select>
                <span asp-validation-for="AppointmentId" class="text-rose-500 text-[11px] mt-1 block"></span>
            </div>

            @* 2. Date & Cost 2-Columns Grid *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="TreatmentDate" class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                        @T("تاريخ العلاج", "Treatment Date") *
                    </label>
                    <input asp-for="TreatmentDate" type="date"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" />
                    <span asp-validation-for="TreatmentDate" class="text-rose-500 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="TreatmentCost" class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                        @T("تكلفة العلاج (JOD)", "Treatment Cost (JOD)") *
                    </label>
                    <input asp-for="TreatmentCost" type="number" step="0.01"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition"
                           placeholder="0.00" />
                    <span asp-validation-for="TreatmentCost" class="text-rose-500 text-[11px] mt-1 block"></span>
                </div>
            </div>

            @* 3. Procedure Description *@
            <div>
                <label asp-for="TreatmentDesc" class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("وصف الإجراء / العلاج", "Procedure / Treatment Description") *
                </label>
                <input asp-for="TreatmentDesc" type="text"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition"
                       placeholder="@T("مثال: علاج عصب السن، حشوة تجميلية، تنظيف لثة...", "e.g. Root Canal Therapy, Composite Restoration...")" />
                <span asp-validation-for="TreatmentDesc" class="text-rose-500 text-[11px] mt-1 block"></span>
            </div>

            @* 4. Diagnosis *@
            <div>
                <label asp-for="Diagnosis" class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("التشخيص السريري", "Clinical Diagnosis")
                </label>
                <textarea asp-for="Diagnosis" rows="2"
                          class="w-full px-3.5 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition resize-y"
                          placeholder="@T("وصف نتائج الفحص والتشخيص السريري...", "Describe oral or clinical examination findings...")"></textarea>
                <span asp-validation-for="Diagnosis" class="text-rose-500 text-[11px] mt-1 block"></span>
            </div>

            @* 5. Prescription Notes *@
            <div>
                <label asp-for="PrescriptionNotes" class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("الوصفة الطبية وملاحظات الأدوية", "Prescription & Medication Notes")
                </label>
                <textarea asp-for="PrescriptionNotes" rows="3"
                          class="w-full px-3.5 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition resize-y"
                          placeholder="@T("اكتب الأدوية والجرعات وإرشادات العناية المنزلية...", "Write prescriptions, dosages, or home care guidelines...")"></textarea>
                <span asp-validation-for="PrescriptionNotes" class="text-rose-500 text-[11px] mt-1 block"></span>
            </div>

            @* Form Actions *@
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <a asp-action="Index"
                   class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
                    <i class="fa-solid fa-cloud-arrow-up text-xs"></i>
                    <span>@T("حفظ السجل", "Commit Record")</span>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}