@model WebApplication1.Models.Patient

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("تعديل ملف المريض", "Edit Patient Profile");
}

<div class="max-w-3xl mx-auto px-4 py-8" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back Navigation Link ── *@
    <div class="mb-5">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-medium text-[#727A76] dark:text-[#9CA8A3] hover:text-[#202725] dark:hover:text-[#EAEFEA] transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى قائمة المرضى", "Back to Patients List")</span>
        </a>
    </div>

    @* ── Outer Card Wrapper ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-2xl shadow-sm max-w-3xl mx-auto overflow-hidden">

        @* ── Form Card Header ── *@
        <div class="px-6 py-5 border-b border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 border border-[#49665A]/20 flex items-center justify-center text-[#49665A] text-base shrink-0">
                <i class="fa-solid fa-user-pen"></i>
            </div>
            <div>
                <h1 class="text-sm sm:text-base font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                    @T("تعديل ملف المريض", "Edit Patient Profile")
                </h1>
                <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0">
                    @T("تحديث البيانات الأساسية ومعلومات الاتصال والسجل الطبي للمريض.", "Update baseline demographics, contact information, and medical profile.")
                </p>
            </div>
        </div>

        @* ── Form Inner Body ── *@
        <form asp-action="Edit" method="post" class="p-6 sm:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="PatientNumber" />
            <input type="hidden" asp-for="NationalId" />

            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs"></div>

            @* ── Section 1: Demographics & Contact ── *@
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-[#49665A] dark:text-[#9CA8A3] mb-4 block">
                    @T("معلومات المريض الأساسية", "Patient Information")
                </span>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- National ID & Patient Number (Readonly Reference) -->
                    <div>
                        <label class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("الرقم الوطني / رقم الملف", "National ID / Record #")
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-id-card absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input value="@Model?.NationalId (@Model?.PatientNumber)" disabled
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#EAEFEA]/40 dark:bg-[#121A17] text-[#727A76] dark:text-[#9CA8A3] text-xs cursor-not-allowed opacity-80" />
                        </div>
                    </div>

                    <!-- Full Name -->
                    <div>
                        <label asp-for="PatientName" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("الاسم الكامل", "Full Name") *
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="PatientName"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                                   placeholder="@T("مثال: أحمد محمد", "e.g. John Doe")" />
                        </div>
                        <span asp-validation-for="PatientName" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label asp-for="DOB" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("تاريخ الميلاد", "Date of Birth") *
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-calendar absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="DOB" type="date"
                                   value="@Model?.DOB.ToString("yyyy-MM-dd")"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition" />
                        </div>
                        <span asp-validation-for="DOB" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Phone Number -->
                    <div>
                        <label asp-for="PhoneNumber" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("رقم الهاتف", "Phone Number") *
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-phone absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="PhoneNumber"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                                   placeholder="@T("مثال: 0791234567", "e.g. 0791234567")" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>
                </div>
            </div>

            @* ── Section 2: Clinical Parameters ── *@
            <div class="pt-4 border-t border-[#DDE3DF] dark:border-[#2B3833]">
                <span class="text-xs font-bold uppercase tracking-wider text-[#49665A] dark:text-[#9CA8A3] mb-4 block">
                    @T("المعلمات السريرية والحساسية", "Clinical Parameters & Allergies")
                </span>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Blood Type -->
                    <div>
                        <label asp-for="BloodType" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("فصيلة الدم", "Blood Type")
                        </label>
                        <select asp-for="BloodType"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition">
                            <option value="">@T("-- غير محدد --", "-- Unspecified --")</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                        <span asp-validation-for="BloodType" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Chronic Diseases -->
                    <div>
                        <label asp-for="ChronicDiseases" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("الأمراض المزمنة", "Chronic Diseases")
                        </label>
                        <input asp-for="ChronicDiseases"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                               placeholder="@T("مثال: السكري، ارتفاع ضغط الدم", "e.g. Diabetes, Hypertension")" />
                        <span asp-validation-for="ChronicDiseases" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Allergies -->
                    <div class="sm:col-span-2">
                        <label asp-for="Allergies" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("الحساسية الدوائية والغذائية", "Drug & Food Allergies")
                        </label>
                        <input asp-for="Allergies"
                               class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                               placeholder="@T("مثال: البنسلين، أسبيرين، مكسرات (أو NKDA)", "e.g. Penicillin, Aspirin, Peanuts (or NKDA)")" />
                        <span asp-validation-for="Allergies" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Notes -->
                    <div class="sm:col-span-2">
                        <label asp-for="Notes" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("ملاحظات إدارية / سريرية خاصة", "Special Administrative / Clinical Notes")
                        </label>
                        <textarea asp-for="Notes" rows="3"
                                  class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition resize-y"
                                  placeholder="@T("أدخل أية ملاحظات إضافية بخصوص ملف المريض...", "Enter any additional notes regarding patient profile...")"></textarea>
                        <span asp-validation-for="Notes" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <a asp-action="Index"
                   class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>@T("حفظ التغييرات", "Save Changes")</span>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}