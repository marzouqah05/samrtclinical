@model WebApplication1.Models.Patient

@{
    var _isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إضافة مريض جديد", "Add New Patient");
    var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<style>
    .patient-form-card .form-control, 
    .patient-form-card .form-select {
        padding: 0.65rem 0.9rem;
        border-radius: 0.75rem;
        border: 1px solid #DDE3DF;
        background-color: #F6F7F5;
        color: #202725;
        font-size: 0.8rem;
        width: 100% !important;
        transition: all 0.15s ease-in-out;
    }

    .patient-form-card .form-control:focus, 
    .patient-form-card .form-select:focus {
        background-color: #ffffff;
        border-color: #49665A;
        box-shadow: 0 0 0 1px #49665A;
        outline: none;
        color: #202725;
    }

    .patient-form-card .field-validation-error,
    .patient-form-card span.field-validation-error {
        display: block !important;
        margin-top: 0.25rem !important;
        font-size: 0.75rem !important;
        color: #f43f5e !important;
        width: 100% !important;
        clear: both !important;
    }

    .patient-form-card .field-validation-valid {
        display: none !important;
    }
</style>

<div dir="@(_isAr ? "rtl" : "ltr")" class="py-4">
    <!-- Main Card Container matching Appointments/Create -->
    <div class="patient-form-card bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-2xl p-6 sm:p-8 shadow-sm max-w-4xl mx-auto">
        
        <!-- Header -->
        <div class="flex items-center gap-3 pb-6 border-b border-[#DDE3DF] dark:border-[#2B3833] mb-6">
            <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <div>
                <h2 class="text-base sm:text-lg font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                    @T("إضافة مريض جديد", "Add New Patient")
                </h2>
                <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0 mt-0.5">
                    @T("إنشاء ملف طبي شامل وسجل أساسي للمريض في النظام.", "Create a comprehensive medical record and baseline profile for a new patient.")
                </p>
            </div>
        </div>

        <form asp-action="Create" method="post" id="patientForm" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs mb-4"></div>
            }

            <!-- 2-Column Responsive Grid -->
            <div class="row g-3">
                <!-- Row 1: Full Name & National ID -->
                <div class="col-md-6">
                    <label asp-for="PatientName" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-user text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("الاسم الكامل", "Full Name") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="PatientName" class="form-control w-100" placeholder="@T("مثال: أحمد علي", "e.g. Ahmed Ali")" />
                    <span asp-validation-for="PatientName" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NationalId" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-id-card text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("الرقم الوطني", "National ID") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="NationalId" class="form-control w-100" placeholder="@T("أدخل الرقم الوطني", "Enter National ID")" maxlength="50" />
                    <span asp-validation-for="NationalId" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <!-- Row 2: Date of Birth & Phone Number -->
                <div class="col-md-6">
                    <label asp-for="DOB" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-calendar-days text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("تاريخ الميلاد", "Date of Birth") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="DOB" type="date" max="@todayStr" class="form-control w-100" />
                    <span asp-validation-for="DOB" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-phone text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("رقم الهاتف", "Phone Number") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="PhoneNumber" class="form-control w-100" placeholder="079xxxxxxx" />
                    <span asp-validation-for="PhoneNumber" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <!-- Row 3: Blood Type & Allergies -->
                <div class="col-md-6">
                    <label asp-for="BloodType" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-droplet text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("فصيلة الدم", "Blood Type")
                    </label>
                    <select asp-for="BloodType" class="form-select form-control w-100">
                        <option value="">@T("-- اختر فصيلة الدم --", "-- Select Blood Type --")</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                    <span asp-validation-for="BloodType" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Allergies" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-hand-dots text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("الحساسية", "Allergies")
                    </label>
                    <input asp-for="Allergies" class="form-control w-100" placeholder="@T("مثال: البنسلين، أسبيرين", "e.g. Penicillin, Aspirin")" />
                    <span asp-validation-for="Allergies" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <!-- Row 4: Chronic Diseases -->
                <div class="col-12">
                    <label asp-for="ChronicDiseases" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-heart-pulse text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("الأمراض المزمنة", "Chronic Diseases")
                    </label>
                    <input asp-for="ChronicDiseases" class="form-control w-100" placeholder="@T("مثال: السكري، ارتفاع ضغط الدم", "e.g. Diabetes, Hypertension")" />
                    <span asp-validation-for="ChronicDiseases" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>

                <!-- Row 5: Clinical Notes -->
                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-semibold block text-xs text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-notes-medical text-[#49665A] @(_isAr ? "ms-1.5" : "me-1.5")"></i>@T("ملاحظات سريرية", "Clinical Notes")
                    </label>
                    <textarea asp-for="Notes" rows="3" class="form-control w-100" placeholder="@T("أضف أي ملاحظات طبية أو إدارية خاصة بملف المريض...", "Add any clinical or administrative notes regarding patient...")"></textarea>
                    <span asp-validation-for="Notes" class="text-rose-500 text-danger text-[11px] mt-1 block"></span>
                </div>
            </div>

            <!-- Action Buttons matching Appointments/Create -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <a asp-action="Index"
                   class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5 text-decoration-none">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5 border-0">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>@T("حفظ بيانات المريض", "Save Patient")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const draftKey = 'patient_create_draft';
            const form = document.getElementById('patientForm');
            if (!form) return;

            const fieldNames = ['PatientName', 'NationalId', 'DOB', 'PhoneNumber', 'BloodType', 'Allergies', 'ChronicDiseases', 'Notes'];

            // Auto-restore draft from sessionStorage on language switch
            try {
                const saved = sessionStorage.getItem(draftKey);
                if (saved) {
                    const data = JSON.parse(saved);
                    fieldNames.forEach(function (name) {
                        const input = form.elements[name];
                        if (input && data[name] !== undefined && data[name] !== null && data[name] !== '') {
                            input.value = data[name];
                        }
                    });
                }
            } catch (e) {
                console.warn('Draft restore error:', e);
            }

            // Auto-save draft on input/change
            function saveDraft() {
                try {
                    const data = {};
                    fieldNames.forEach(function (name) {
                        const input = form.elements[name];
                        if (input) {
                            data[name] = input.value;
                        }
                    });
                    sessionStorage.setItem(draftKey, JSON.stringify(data));
                } catch (e) {
                    console.warn('Draft save error:', e);
                }
            }

            form.addEventListener('input', saveDraft);
            form.addEventListener('change', saveDraft);

            // Clear draft when successfully submitting
            form.addEventListener('submit', function () {
                sessionStorage.removeItem(draftKey);
            });

            // Clear draft when clicking cancel
            const cancelBtn = form.querySelector('a[href*="Index"]');
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function () {
                    sessionStorage.removeItem(draftKey);
                });
            }
        })();
    </script>
}