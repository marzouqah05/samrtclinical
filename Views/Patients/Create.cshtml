@model WebApplication1.Models.Patient

@{
    var _isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إضافة مريض جديد", "Add New Patient");
    var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    .field-validation-error,
    span.field-validation-error {
        display: block !important;
        margin-top: 0.25rem !important;
        font-size: 0.825rem !important;
        font-weight: 500 !important;
        color: #dc3545 !important;
        width: 100% !important;
        clear: both !important;
    }

    .field-validation-valid {
        display: none !important;
    }

    .input-validation-error {
        border-color: #dc3545 !important;
    }

    .input-validation-error:focus {
        border-color: #b02a37 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

<div class="container-fluid py-4" style="max-width: 900px;" dir="@(_isAr ? "rtl" : "ltr")">
    @* Back Link *@
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small fw-medium d-inline-flex align-items-center gap-2">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى قائمة المرضى", "Back to Patients List")</span>
        </a>
    </div>

    @* Form Card *@
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header p-4 rounded-top-3 border-0" style="background-color: #0f172a !important;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h5 class="card-title mb-1 fw-bold text-white d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-plus text-primary"></i>
                        @T("إضافة مريض جديد", "Add New Patient")
                    </h5>
                    <p class="card-text text-white-50 small mb-0">
                        @T("إنشاء ملف طبي وسجل أساسي لمريض جديد في النظام.", "Create a medical profile and baseline record for a new patient.")
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="patientForm" novalidate>
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 px-3 small rounded-2"></div>
                }

                <div class="row g-3">
                    @* Full Name *@
                    <div class="col-md-6">
                        <label asp-for="PatientName" class="form-label fw-medium text-secondary mb-1">
                            @T("الاسم الكامل", "Full Name") <span class="text-danger">*</span>
                        </label>
                        <input asp-for="PatientName" class="form-control" placeholder="@T("مثال: أحمد علي", "e.g. Ahmed Ali")" />
                        <span asp-validation-for="PatientName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* National ID *@
                    <div class="col-md-6">
                        <label asp-for="NationalId" class="form-label fw-medium text-secondary mb-1">
                            @T("الرقم الوطني", "National ID") <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NationalId" class="form-control" placeholder="@T("أدخل الرقم الوطني", "Enter National ID")" maxlength="50" />
                        <span asp-validation-for="NationalId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Date of Birth *@
                    <div class="col-md-6">
                        <label asp-for="DOB" class="form-label fw-medium text-secondary mb-1">
                            @T("تاريخ الميلاد", "Date of Birth") <span class="text-danger">*</span>
                        </label>
                        <input asp-for="DOB" type="date" max="@todayStr" class="form-control" />
                        <span asp-validation-for="DOB" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Phone Number *@
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-medium text-secondary mb-1">
                            @T("رقم الهاتف", "Phone Number") <span class="text-danger">*</span>
                        </label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="079xxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Blood Type *@
                    <div class="col-md-6">
                        <label asp-for="BloodType" class="form-label fw-medium text-secondary mb-1">
                            @T("فصيلة الدم", "Blood Type")
                        </label>
                        <select asp-for="BloodType" class="form-select">
                            <option value="">@T("-- اختر فصيلة الدم --", "-- Select Blood Type --")</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                        <span asp-validation-for="BloodType" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Allergies *@
                    <div class="col-md-6">
                        <label asp-for="Allergies" class="form-label fw-medium text-secondary mb-1">
                            @T("الحساسية", "Allergies")
                        </label>
                        <input asp-for="Allergies" class="form-control" placeholder="@T("مثال: البنسلين، أسبيرين", "e.g. Penicillin, Aspirin")" />
                        <span asp-validation-for="Allergies" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Chronic Diseases *@
                    <div class="col-12">
                        <label asp-for="ChronicDiseases" class="form-label fw-medium text-secondary mb-1">
                            @T("الأمراض المزمنة", "Chronic Diseases")
                        </label>
                        <input asp-for="ChronicDiseases" class="form-control" placeholder="@T("مثال: السكري، ارتفاع ضغط الدم", "e.g. Diabetes, Hypertension")" />
                        <span asp-validation-for="ChronicDiseases" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Clinical Notes *@
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-medium text-secondary mb-1">
                            @T("ملاحظات سريرية", "Clinical Notes")
                        </label>
                        <textarea asp-for="Notes" rows="3" class="form-control" placeholder="@T("أضف أي ملاحظات طبية أو إدارية خاصة بملف المريض...", "Add any clinical or administrative notes regarding patient...")"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @* Submit / Cancel Buttons *@
                    <div class="col-12 d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-xmark me-1 ms-1"></i>
                            <span>@T("إلغاء", "Cancel")</span>
                        </a>
                        <button type="submit" class="btn btn-primary px-4" style="background-color: #0f172a; border-color: #0f172a;">
                            <i class="fa-solid fa-floppy-disk me-1 ms-1"></i>
                            <span>@T("حفظ بيانات المريض", "Save Patient")</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const draftKey = 'patient_create_draft';
            const form = document.getElementById('patientForm');
            if (!form) return;

            const fieldNames = ['PatientName', 'NationalId', 'DOB', 'PhoneNumber', 'BloodType', 'Allergies', 'ChronicDiseases', 'Notes'];

            // Restore draft data from sessionStorage if present (e.g. after language switch)
            try {
                const saved = sessionStorage.getItem(draftKey);
                if (saved) {
                    const data = JSON.parse(saved);
                    fieldNames.forEach(function (name) {
                        const input = form.elements[name];
                        if (input && data[name] !== undefined && data[name] !== null && data[name] !== '') {
                            input.value = data[name];
                        }
                    });
                }
            } catch (e) {
                console.warn('Could not restore patient form draft:', e);
            }

            // Save form changes to sessionStorage
            function saveDraft() {
                try {
                    const data = {};
                    let hasValue = false;
                    fieldNames.forEach(function (name) {
                        const input = form.elements[name];
                        if (input) {
                            data[name] = input.value;
                            if (input.value) hasValue = true;
                        }
                    });
                    if (hasValue) {
                        sessionStorage.setItem(draftKey, JSON.stringify(data));
                    }
                } catch (e) {
                    console.warn('Could not save patient form draft:', e);
                }
            }

            form.addEventListener('input', saveDraft);
            form.addEventListener('change', saveDraft);

            // Clear draft when submitting
            form.addEventListener('submit', function () {
                sessionStorage.removeItem(draftKey);
            });

            // Clear draft on cancel button click
            const cancelBtn = document.querySelector('.btn-outline-secondary');
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function () {
                    sessionStorage.removeItem(draftKey);
                });
            }
        })();
    </script>
}