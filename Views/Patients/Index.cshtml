@model IEnumerable<WebApplication1.Models.Patient>
@using System.Text.Json

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("قائمة المرضى", "Patients List");

    List<string>? importErrors = null;
    if (TempData["ImportErrors"] != null)
    {
        try
        {
            importErrors = JsonSerializer.Deserialize<List<string>>(TempData["ImportErrors"]!.ToString()!);
        }
        catch { }
    }
}

<div dir="@(_isAr ? "rtl" : "ltr")" class="space-y-5">

    @* ─── Header & Top Actions ─── *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-lg font-bold text-[#202725] m-0 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-sm shrink-0">
                    <i class="fa-solid fa-users"></i>
                </span>
                @T("قائمة المرضى", "Patients List")
            </h2>
            <p class="text-[#727A76] text-xs m-0 mt-1 ms-10">@T("عرض وبحث وإدارة سجلات المرضى والبيانات الطبية", "View, search, and manage patient records and medical histories")</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <!-- 📥 Import Patients Button -->
            <button type="button"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-[#DDE3DF] text-[#49665A] text-sm font-medium rounded-lg hover:bg-[#F6F7F5] transition-colors shadow-[0_1px_2px_rgba(0,0,0,0.04)]"
                    data-bs-toggle="modal" data-bs-target="#importPatientsModal"
                    title="@T("استيراد بيانات المرضى من ملف CSV", "Bulk import patients from CSV")">
                <i class="fa-solid fa-file-import text-sm"></i>
                <span>@T("استيراد المرضى", "Import Patients")</span>
            </button>

            <!-- 📤 Export to CSV Button -->
            <a asp-action="Export"
               class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-[#DDE3DF] text-[#2E7D5B] text-sm font-medium rounded-lg hover:bg-[#EAF5F0] transition-colors shadow-[0_1px_2px_rgba(0,0,0,0.04)]"
               title="@T("تصدير جميع بيانات المرضى إلى ملف CSV", "Export all patients to CSV")">
                <i class="fa-solid fa-file-excel text-sm"></i>
                <span>@T("تصدير CSV", "Export to CSV")</span>
            </a>

            <!-- ➕ Add New Patient Button -->
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 bg-[#49665A] text-white text-sm font-medium rounded-lg hover:bg-[#3D574D] transition-colors shadow-sm">
                <i class="fa-solid fa-user-plus text-sm"></i>
                <span>@T("إضافة مريض جديد", "Add New Patient")</span>
            </a>
        </div>
    </div>

    @* ─── Notification Alerts ─── *@
    @if (TempData["Success"] != null)
    {
        <div class="flex items-start gap-3 bg-[#EAF5F0] border border-[#2E7D5B]/20 rounded-xl p-4">
            <i class="fa-solid fa-circle-check text-[#2E7D5B] text-base mt-0.5 shrink-0"></i>
            <div class="flex-1 min-w-0">
                <span class="text-sm font-semibold text-[#2E7D5B]">@T("تم بنجاح!", "Success!")</span>
                <span class="text-sm text-[#2E7D5B]/80 ms-1">@TempData["Success"]</span>
            </div>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="flex items-start gap-3 bg-[#FDF6EC] border border-[#B47318]/20 rounded-xl p-4">
            <i class="fa-solid fa-triangle-exclamation text-[#B47318] text-base mt-0.5 shrink-0"></i>
            <div class="flex-1 min-w-0">
                <span class="text-sm font-semibold text-[#B47318]">@T("تنبيه:", "Notice:")</span>
                <span class="text-sm text-[#B47318]/80 ms-1">@TempData["Warning"]</span>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-start gap-3 bg-[#FCEEEE] border border-[#B83A38]/20 rounded-xl p-4">
            <i class="fa-solid fa-circle-exclamation text-[#B83A38] text-base mt-0.5 shrink-0"></i>
            <div class="flex-1 min-w-0">
                <span class="text-sm font-semibold text-[#B83A38]">@T("خطأ:", "Error:")</span>
                <span class="text-sm text-[#B83A38]/80 ms-1">@TempData["Error"]</span>
            </div>
        </div>
    }

    @* ─── Detailed Import Error Log ─── *@
    @if (importErrors != null && importErrors.Any())
    {
        <div class="bg-white border border-[#DDE3DF] rounded-xl overflow-hidden shadow-[0_1px_2px_rgba(0,0,0,0.04)]">
            <button type="button"
                    class="w-full flex items-center justify-between px-5 py-3.5 hover:bg-[#F6F7F5] transition-colors"
                    onclick="this.nextElementSibling.classList.toggle('hidden')">
                <div class="flex items-center gap-2 text-sm font-semibold text-[#202725]">
                    <i class="fa-solid fa-list-check text-[#B47318]"></i>
                    <span>@T("تفاصيل الصفوف المستبعدة والملاحظات أثناء الاستيراد", "Details of Skipped Rows & Validation Notes") (@importErrors.Count)</span>
                </div>
                <span class="text-[11px] text-[#727A76] border border-[#DDE3DF] px-2 py-0.5 rounded-md">@T("اضغط للتفاصيل", "Click to view") <i class="fa-solid fa-chevron-down ms-1"></i></span>
            </button>
            <div class="hidden border-t border-[#DDE3DF]">
                <ul class="divide-y divide-[#DDE3DF] max-h-52 overflow-y-auto">
                    @foreach (var err in importErrors)
                    {
                        <li class="flex items-start gap-2 px-5 py-2.5 text-xs text-[#B83A38]">
                            <i class="fa-solid fa-circle-xmark mt-0.5 shrink-0"></i>
                            <span>@err</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @* ─── Search Bar ─── *@
    <form asp-action="Index" method="get">
        <div class="flex max-w-xl">
            <input type="text" name="search"
                   class="flex-1 bg-white border border-[#DDE3DF] border-e-0 text-[#202725] text-sm rounded-s-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#49665A] focus:border-[#49665A] placeholder:text-[#727A76]"
                   placeholder="@T("ابحث بالاسم أو رقم الهاتف أو الهوية...", "Search by name, phone, or national ID...")"
                   value="@ViewContext.HttpContext.Request.Query["search"]" />
            <button type="submit"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#49665A] hover:bg-[#3D574D] text-white text-sm font-medium rounded-e-lg transition-colors">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>@T("بحث", "Search")</span>
            </button>
        </div>
    </form>

    @* ─── Patients Table ─── *@
    <div class="bg-white rounded-xl border border-[#DDE3DF] shadow-[0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-start">
                <thead>
                    <tr class="bg-[#F6F7F5] border-b border-[#DDE3DF]">
                        <th class="py-3 px-5 text-start text-[11px] font-semibold uppercase tracking-wider text-[#727A76]">
                            @T("اسم المريض", "Patient Name")
                        </th>
                        <th class="py-3 px-5 text-start text-[11px] font-semibold uppercase tracking-wider text-[#727A76]">
                            @T("رقم الهاتف", "Phone Number")
                        </th>
                        <th class="py-3 px-5 text-start text-[11px] font-semibold uppercase tracking-wider text-[#727A76]">
                            @T("رقم الهوية", "National ID")
                        </th>
                        <th class="py-3 px-5 text-end text-[11px] font-semibold uppercase tracking-wider text-[#727A76]">
                            @T("الإجراءات", "Actions")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="bg-white hover:bg-[#F6F7F5]/60 border-b border-[#DDE3DF] transition-colors">
                                <td class="py-3.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-full bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-xs font-bold shrink-0">
                                            @(item.PatientName?.Length > 0 ? item.PatientName.Substring(0, 1).ToUpper() : "P")
                                        </div>
                                        <span class="text-sm font-semibold text-[#202725]">@item.PatientName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-5 text-sm text-[#727A76]">@item.PhoneNumber</td>
                                <td class="py-3.5 px-5 text-sm text-[#727A76] font-mono">@item.NationalId</td>
                                <td class="py-3.5 px-5 text-end">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.PatientId"
                                           class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#F6F7F5] border border-[#DDE3DF] hover:bg-[#DDE3DF] text-[#727A76] text-xs font-medium transition-colors"
                                           title="@T("تعديل", "Edit")">
                                            <i class="fa-solid fa-pen text-[10px]"></i>
                                            @T("تعديل", "Edit")
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.PatientId"
                                           class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#49665A]/10 border border-[#49665A]/20 hover:bg-[#49665A]/20 text-[#49665A] text-xs font-medium transition-colors"
                                           title="@T("تفاصيل", "Details")">
                                            <i class="fa-solid fa-circle-info text-[10px]"></i>
                                            @T("تفاصيل", "Details")
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.PatientId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white border border-[#DDE3DF] hover:bg-[#FCEEEE] hover:border-[#B83A38]/20 text-[#727A76] hover:text-[#B83A38] text-xs font-medium transition-colors"
                                                    onclick="return confirm('@T("هل أنت متأكد من حذف هذا المريض؟ سيتم حذف جميع المواعيد المرتبطة به أيضاً!", "Are you sure you want to delete this patient? All related appointments will be permanently deleted as well!")')"
                                                    title="@T("حذف", "Delete")">
                                                <i class="fa-solid fa-trash text-[10px]"></i>
                                                @T("حذف", "Delete")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="py-16 text-center">
                                <i class="fa-solid fa-user-slash text-3xl block mb-3 text-[#DDE3DF]"></i>
                                <span class="text-sm text-[#727A76]">@T("لا يوجد مرضى مطابقون لمعايير البحث.", "No patient records matched your search criteria.")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── 📥 Import Patients Modal (Strict SaaS Medical UI) ─── *@
<div class="modal fade" id="importPatientsModal" tabindex="-1" aria-labelledby="importPatientsModalLabel" aria-hidden="true" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 bg-white overflow-hidden">
            
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                    </div>
                    <div>
                        <h5 class="font-semibold text-slate-900 text-lg m-0" id="importPatientsModalLabel">
                            @T("استيراد بيانات المرضى دفعة واحدة", "Bulk Import Patients")
                        </h5>
                        <p class="text-sm text-slate-500 m-0 mt-0.5">
                            @T("رفع ملف CSV أو Excel لإضافة وتحديث سجلات المرضى سريعاً", "Upload CSV or Excel file to quickly import or update patient records")
                        </p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors" data-bs-dismiss="modal" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form method="post" enctype="multipart/form-data" asp-action="Import" id="importPatientsForm" onsubmit="handleImportSubmit(event)">
                @Html.AntiForgeryToken()

                <!-- Template Download Banner -->
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center shrink-0 font-bold font-mono text-xs">
                            CSV
                        </div>
                        <div>
                            <div class="text-sm font-semibold text-slate-900">
                                @T("قالب بيانات المرضى القياسي", "Standard Patient Data Template")
                            </div>
                            <div class="text-xs text-slate-500 mt-0.5">
                                @T("حمّل القالب المعتمد للتعرف على صيغة الأعمدة وترتيبها المطلوب", "Download the verified template to match required column headers and formatting")
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("DownloadTemplate")" class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl border border-emerald-200 bg-emerald-50/80 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold transition-colors shrink-0">
                        <svg class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>@T("تحميل قالب CSV", "Download CSV Template")</span>
                    </a>
                </div>

                <!-- Dropzone / File Upload -->
                <div class="mb-6">
                    <div id="patientDropzone"
                         class="relative border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-xl p-6 text-center cursor-pointer transition-colors bg-slate-50/30 hover:bg-blue-50/20 group">
                        
                        <input type="file" id="patientFileInput" name="file" class="hidden" accept=".csv, .xlsx, .xls" required onchange="handlePatientFileSelected(this)" />
                        
                        <!-- Empty / Prompt State -->
                        <div id="dropzonePrompt" class="py-2">
                            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-slate-100 group-hover:bg-blue-100 text-slate-400 group-hover:text-blue-600 flex items-center justify-center transition-colors">
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                            </div>
                            <p class="text-sm font-medium text-slate-800 mb-1">
                                <span class="text-blue-600 hover:underline">@T("اضغط لتصفح الملف", "Click to browse")</span>
                                @T("أو اسحب وأفلت الملف هنا", "or drag and drop your file here")
                            </p>
                            <p class="text-xs text-slate-400 m-0">
                                @T("الصيغ المدعومة: .csv, .xlsx (الحد الأقصى 10MB)", "Supported formats: .csv, .xlsx (Max 10MB)")
                            </p>
                        </div>

                        <!-- Selected File State -->
                        <div id="dropzoneFileSelected" class="hidden flex items-center justify-between p-3.5 bg-white border border-blue-200 rounded-xl text-start shadow-xs">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-lg bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-file-csv text-lg"></i>
                                </div>
                                <div class="min-w-0">
                                    <p id="patientSelectedFileName" class="text-sm font-semibold text-slate-900 truncate m-0"></p>
                                    <p id="patientSelectedFileSize" class="text-xs text-slate-500 m-0 mt-0.5"></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="event.stopPropagation(); document.getElementById('patientFileInput').click();" class="px-2.5 py-1 text-xs font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition-colors">
                                    @T("تغيير", "Change")
                                </button>
                                <button type="button" onclick="event.stopPropagation(); removePatientSelectedFile();" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors" title="@T("إزالة الملف", "Remove file")">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Required Columns Specs -->
                <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 mb-6">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                            @T("الأعمدة المطلوبة في الملف ومواصفاتها:", "Required Columns Specifications:")
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                        <div class="p-2.5 rounded-lg bg-white border border-slate-200 flex items-start gap-2">
                            <span class="bg-slate-100 text-slate-700 font-mono text-xs px-2 py-1 rounded shrink-0 font-semibold">NationalID</span>
                            <span class="text-xs text-slate-600 self-center">@T("10 خانات فريدة", "10 digits, Unique")</span>
                        </div>
                        <div class="p-2.5 rounded-lg bg-white border border-slate-200 flex items-start gap-2">
                            <span class="bg-slate-100 text-slate-700 font-mono text-xs px-2 py-1 rounded shrink-0 font-semibold">FullName</span>
                            <span class="text-xs text-slate-600 self-center">@T("مطلوب (3 - 150 حرفاً)", "Required (3-150 chars)")</span>
                        </div>
                        <div class="p-2.5 rounded-lg bg-white border border-slate-200 flex items-start gap-2">
                            <span class="bg-slate-100 text-slate-700 font-mono text-xs px-2 py-1 rounded shrink-0 font-semibold">Phone</span>
                            <span class="text-xs text-slate-600 self-center">@T("مطلوب للتواصل", "Required")</span>
                        </div>
                        <div class="p-2.5 rounded-lg bg-white border border-slate-200 flex items-start gap-2">
                            <span class="bg-slate-100 text-slate-700 font-mono text-xs px-2 py-1 rounded shrink-0 font-semibold">DateOfBirth</span>
                            <span class="text-xs text-slate-600 self-center">YYYY-MM-DD</span>
                        </div>
                        <div class="p-2.5 rounded-lg bg-white border border-slate-200 flex items-start gap-2 sm:col-span-2 lg:col-span-2">
                            <span class="bg-slate-100 text-slate-700 font-mono text-xs px-2 py-1 rounded shrink-0 font-semibold">Gender</span>
                            <span class="text-xs text-slate-600 self-center">Male / Female (@T("ذكر أو أنثى", "Male or Female"))</span>
                        </div>
                    </div>
                </div>

                <!-- Actions Footer -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200">
                    <button type="button" class="h-11 px-5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold transition" data-bs-dismiss="modal">
                        @T("إلغاء", "Cancel")
                    </button>
                    <button type="submit" id="btnSubmitPatientImport" class="h-11 px-6 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-2">
                        <svg id="importIcon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                        <span id="importSpinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                        <span id="importText">@T("بدء الاستيراد", "Start Import")</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropzone = document.getElementById('patientDropzone');
        const fileInput = document.getElementById('patientFileInput');
        if (!dropzone || !fileInput) return;

        dropzone.addEventListener('click', function (e) {
            if (e.target.closest('button')) return;
            fileInput.click();
        });

        ['dragenter', 'dragover'].forEach(eventName => {
            dropzone.addEventListener(eventName, function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.add('border-blue-500', 'bg-blue-50/30');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.remove('border-blue-500', 'bg-blue-50/30');
            });
        });

        dropzone.addEventListener('drop', function (e) {
            if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                handlePatientFileSelected(fileInput);
            }
        });
    });

    function handlePatientFileSelected(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const nameEl = document.getElementById('patientSelectedFileName');
            const sizeEl = document.getElementById('patientSelectedFileSize');
            const promptEl = document.getElementById('dropzonePrompt');
            const selectedEl = document.getElementById('dropzoneFileSelected');

            if (nameEl) nameEl.textContent = file.name;
            if (sizeEl) {
                const sizeKb = (file.size / 1024).toFixed(1);
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                sizeEl.textContent = file.size > 1024 * 1024 ? `${sizeMb} MB` : `${sizeKb} KB`;
            }

            if (promptEl) promptEl.classList.add('hidden');
            if (selectedEl) {
                selectedEl.classList.remove('hidden');
                selectedEl.classList.add('flex');
            }
        }
    }

    function removePatientSelectedFile() {
        const fileInput = document.getElementById('patientFileInput');
        const promptEl = document.getElementById('dropzonePrompt');
        const selectedEl = document.getElementById('dropzoneFileSelected');

        if (fileInput) fileInput.value = '';
        if (promptEl) promptEl.classList.remove('hidden');
        if (selectedEl) {
            selectedEl.classList.add('hidden');
            selectedEl.classList.remove('flex');
        }
    }

    function handleImportSubmit(e) {
        const btn = document.getElementById('btnSubmitPatientImport');
        const icon = document.getElementById('importIcon');
        const spinner = document.getElementById('importSpinner');
        const text = document.getElementById('importText');

        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-80', 'cursor-not-allowed');
        }
        if (icon) icon.classList.add('hidden');
        if (spinner) spinner.classList.remove('hidden');
        if (text) text.textContent = '@T("جاري الاستيراد...", "Importing...")';
    }
</script>