@model WebApplication1.Models.Patient

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("حذف المريض", "Delete Patient");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>

    body {
        background: #f5f7fb;
    }

    .delete-container {
        max-width: 750px;
        margin: auto;
    }

    .delete-card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .delete-header {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        padding: 35px;
        color: white;
        text-align: center;
    }

    .delete-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        font-size: 38px;
        margin-bottom: 20px;
    }

    .delete-header h2 {
        margin: 0;
        font-weight: bold;
    }

    .delete-header p {
        margin-top: 10px;
        opacity: 0.9;
    }

    .delete-body {
        padding: 35px;
    }

    .patient-info {
        background: #f8fafc;
        border-radius: 22px;
        padding: 25px;
    }

    .patient-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #3b82f6;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
        font-weight: bold;
        margin: auto;
        margin-bottom: 20px;
    }

    .info-item {
        margin-bottom: 18px;
    }

    .info-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-value {
        font-weight: 600;
        font-size: 16px;
        color: #0f172a;
    }

    .warning-box {
        background: #fee2e2;
        color: #b91c1c;
        padding: 18px;
        border-radius: 18px;
        margin-top: 25px;
    }

    .delete-btn {
        background: #ef4444;
        border: none;
        border-radius: 16px;
        padding: 14px 28px;
        font-weight: 600;
        transition: 0.3s;
    }

        .delete-btn:hover {
            background: #dc2626;
            transform: translateY(-2px);
        }

    .back-btn {
        border-radius: 16px;
        padding: 14px 24px;
    }

</style>

<div class="delete-container" dir="@(_isAr ? "rtl" : "ltr")">

    <div class="delete-card">

        <!-- Header -->
        <div class="delete-header">

            <div class="delete-icon">
                <i class="fa-solid fa-trash"></i>
            </div>

            <h2>@T("حذف المريض", "Delete Patient")</h2>

            <p>
                @T("هل أنت متأكد من حذف هذا المريض نهائياً؟", "Are you sure you want to permanently delete this patient?")
            </p>

        </div>

        <!-- Body -->
        <div class="delete-body">

            <div class="patient-info text-center">

                <div class="patient-avatar">
                    @Model.PatientName.Substring(0, 1).ToUpper()
                </div>

                <h3 class="fw-bold mb-4">
                    @Model.PatientName
                </h3>

                <div class="row text-start">

                    <!-- DOB -->
                    <div class="col-md-6 info-item">

                        <div class="info-label">
                            @T("تاريخ الميلاد", "Date of Birth")
                        </div>

                        <div class="info-value">
                            @Model.DOB.ToShortDateString()
                        </div>

                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 info-item">

                        <div class="info-label">
                            @T("رقم الهاتف", "Phone Number")
                        </div>

                        <div class="info-value">
                            @Model.PhoneNumber
                        </div>

                    </div>

                </div>

            </div>

            <!-- Warning -->
            <div class="warning-box">

                <i class="fa-solid fa-triangle-exclamation"></i>

                @T("لا يمكن التراجع عن هذا الإجراء. قد تتأثر جميع معلومات المواعيد المرتبطة أيضاً.", "This action cannot be undone. All related appointment information may also be affected.")

            </div>

            <!-- Buttons -->
            <form asp-action="Delete" class="mt-4">

                <input type="hidden" asp-for="PatientId" />

                <div class="d-flex gap-3">

                    <button type="submit"
                            class="btn btn-danger delete-btn">

                        <i class="fa-solid fa-trash"></i>
                        @T("حذف المريض", "Delete Patient")

                    </button>

                    <a asp-action="Index"
                       class="px-4 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-xmark text-xs"></i>
                        <span>@T("إلغاء", "Cancel")</span>
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>