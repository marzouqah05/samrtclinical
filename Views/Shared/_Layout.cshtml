@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization
@{
    var _culture = CultureInfo.CurrentCulture;
    var _isRtl = _culture.TextInfo.IsRightToLeft;
    var _lang = _culture.TwoLetterISOLanguageName;
    var _isAr = _lang == "ar";
    Func<string, string, string> T = (ar, en) => _isAr ? ar : en;
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    var clinicSettings = await SettingsService.GetSettingsAsync();
    var clinicName = !string.IsNullOrWhiteSpace(clinicSettings.ClinicName) ? clinicSettings.ClinicName : T("المركز الطبي", "ClinicFlow OS");
    var clinicLogo = clinicSettings.LogoUrl;
    var hasClinicLogo = !string.IsNullOrWhiteSpace(clinicLogo) && clinicLogo != "/images/logo.png";
}
<!DOCTYPE html>
<html lang="@_lang" dir="@(_isRtl ? "rtl" : "ltr")" id="app-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")@clinicName</title>

    <!-- 1. Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        canvas: '#F6F7F5',
                        brand: '#49665A',
                        brandHover: '#3D574D',
                        textMain: '#202725',
                        textMuted: '#727A76',
                        border: '#DDE3DF',
                        emeraldBg: '#EAF5F0',
                        emeraldTxt: '#2E7D5B',
                        amberBg: '#FDF6EC',
                        amberTxt: '#B47318',
                        roseBg: '#FCEEEE',
                        roseTxt: '#B83A38',
                    }
                }
            }
        }
    </script>

    <!-- 2. Google Fonts: IBM Plex Sans Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- 3. FontAwesome 6 CDN, Bootstrap Icons CDN & Local Stylesheet -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- 4. Anti-Flicker Theme Script -->
    <script>
        (function () {
            const saved = localStorage.getItem('clinic_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.setAttribute('data-theme', 'dark');
                document.documentElement.setAttribute('data-bs-theme', 'dark');
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
                document.documentElement.setAttribute('data-bs-theme', 'light');
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <style>
        body, button, input, select, textarea, p, h1, h2, h3, h4, h5, h6, span, a, label, div {
            font-family: 'IBM Plex Sans Arabic', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .fa, .fas, .far, .fal, .fad, .fab, .fa-solid, .fa-regular, .fa-brands, .fa-light, .fa-thin, .fa-duotone {
            font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands" !important;
        }

        #cf-main-sidebar::-webkit-scrollbar {
            width: 4px;
        }

        #cf-main-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        #cf-main-sidebar::-webkit-scrollbar-thumb {
            background: #DDE3DF;
            border-radius: 4px;
        }

        /* ==========================================================================
                   CLINICFLOW STRICT DARK MODE COLOR TOKENS OVERRIDE
                   ========================================================================== */
        html.dark body,
        html.dark main#cf-main-canvas,
        html[data-theme="dark"] body,
        html[data-theme="dark"] main#cf-main-canvas {
            background-color: #121816 !important;
            color: #EAEFEA !important;
        }

        /* 1. All White Containers, Filter Blocks & Cards */
        html.dark .bg-white,
        html.dark div[class*="bg-white"],
        html.dark section[class*="bg-white"],
        html.dark .card,
        html.dark .clinic-card,
        html.dark .filter-card,
        html.dark .cf-topbar,
        html.dark .cf-sidebar,
        html.dark [class*="rounded-2xl"][class*="bg-white"],
        html.dark [class*="rounded-xl"][class*="bg-white"],
        html[data-theme="dark"] .bg-white,
        html[data-theme="dark"] div[class*="bg-white"],
        html[data-theme="dark"] section[class*="bg-white"],
        html[data-theme="dark"] .card,
        html[data-theme="dark"] .clinic-card {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
        }

        /* 2. Stat Panels & Inner Light Containers */
        html.dark .metric-card,
        html.dark [class*="bg-slate-"],
        html.dark [class*="bg-gray-100"],
        html.dark [class*="bg-gray-50"],
        html[data-theme="dark"] [class*="bg-slate-"],
        html[data-theme="dark"] [class*="bg-gray-100"],
        html[data-theme="dark"] [class*="bg-gray-50"] {
            background-color: #151E1B !important;
            border-color: #2B3833 !important;
        }

        /* 3. Status Badges, Pills & Rounded Indicators */
        html.dark span[class*="rounded-full"],
        html.dark .badge,
        html.dark [class*="badge-"],
        html[data-theme="dark"] span[class*="rounded-full"],
        html[data-theme="dark"] .badge {
            background-color: #202B27 !important;
            border: 1px solid #2B3833 !important;
            color: #EAEFEA !important;
        }

            html.dark span[class*="rounded-full"] span,
            html.dark .badge span {
                color: #EAEFEA !important;
            }

        /* 4. Action Buttons (Export, Import, Details, Edit, Delete) */
        html.dark button.bg-white,
        html.dark a.bg-white,
        html.dark .btn-white,
        html.dark .btn-outline,
        html.dark button:not(.btn-primary):not(.btn-clinic-primary):not(#themeToggleBtn),
        html[data-theme="dark"] button.bg-white,
        html[data-theme="dark"] a.bg-white,
        html[data-theme="dark"] .btn-outline {
            background-color: #202B27 !important;
            border-color: #2B3833 !important;
            color: #EAEFEA !important;
        }

            html.dark button.bg-white:hover,
            html.dark a.bg-white:hover,
            html.dark .btn-white:hover {
                background-color: #283732 !important;
                color: #FFFFFF !important;
            }

        /* 5. Inputs, Selects, and Dropdowns */
        html.dark input,
        html.dark select,
        html.dark textarea,
        html[data-theme="dark"] input,
        html[data-theme="dark"] select,
        html[data-theme="dark"] textarea {
            background-color: #121816 !important;
            border-color: #2B3833 !important;
            color: #EAEFEA !important;
        }

            html.dark input::placeholder {
                color: #727A76 !important;
            }

        /* 6. Typography & Text Contrast */
        html.dark h1, html.dark h2, html.dark h3, html.dark h4, html.dark h5, html.dark h6,
        html.dark .text-gray-900, html.dark .text-slate-900, html.dark .text-[#202725],
        html[data-theme="dark"] h1, html[data-theme="dark"] h2, html[data-theme="dark"] h3,
        html[data-theme="dark"] h4, html[data-theme="dark"] h5, html[data-theme="dark"] h6 {
            color: #EAEFEA !important;
        }

        html.dark p, html.dark .text-gray-500, html.dark .text-gray-400, html.dark .text-[#727A76],
        html[data-theme="dark"] p, html[data-theme="dark"] .text-[#727A76] {
            color: #9CA8A3 !important;
        }

        html.dark label {
            color: #C5CECA !important;
        }

        /* 7. Tables */
        html.dark table thead th,
        html[data-theme="dark"] table thead th {
            background-color: #151E1B !important;
            color: #9CA8A3 !important;
            border-color: #2B3833 !important;
        }

        html.dark table tbody tr,
        html[data-theme="dark"] table tbody tr {
            border-color: #2B3833 !important;
        }

        html.dark table td,
        html[data-theme="dark"] table td {
            color: #EAEFEA !important;
        }

        html.dark table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.02) !important;
        }

        /* ── 8. Inline style="background: white/…" attribute overrides ──────── */
        /* These catch components that bypass class-based theming entirely        */
        html.dark [style*="background: white"],
        html.dark [style*="background-color: white"],
        html.dark [style*="background-color: #fff"],
        html.dark [style*="background-color: #FFF"],
        html.dark [style*="background:#fff"],
        html.dark [style*="background: #fff"],
        html.dark [style*="background:#FFF"],
        html.dark [style*="background: #FFF"] {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
            color: #EAEFEA !important;
        }

        /* ── 9. Upload dropzones & dashed border containers ─────────────────── */
        html.dark [class*="border-dashed"],
        html.dark .dropzone {
            background-color: #151E1B !important;
            border-color: #2B3833 !important;
        }

        /* ── 10. Additional muted text classes ───────────────────────────────── */
        html.dark .text-gray-600,
        html.dark .text-slate-600,
        html.dark .text-muted,
        html[data-theme="dark"] .text-gray-600,
        html[data-theme="dark"] .text-slate-600 {
            color: #9CA8A3 !important;
        }

        /* ── 11. Bridge Bootstrap [data-bs-theme="dark"] → html.dark ─────────── */
        /* Views that ship their own <style> using Bootstrap's dark attr selector  */
        /* will be overridden here so they obey ClinicFlow's Tailwind dark class   */

        /* Audit / Sessions page components */
        html.dark .audit-header-bar {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
            color: #EAEFEA !important;
        }
        html.dark .audit-header-bar h1,
        html.dark .audit-header-bar p {
            color: #EAEFEA !important;
        }
        html.dark .kpi-card {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
        }
        html.dark .kpi-value { color: #EAEFEA !important; }
        html.dark .kpi-label { color: #9CA8A3 !important; }
        html.dark .kpi-icon.blue   { background-color: #0f2a4a !important; color: #60a5fa !important; }
        html.dark .kpi-icon.green  { background-color: #0c2f1e !important; color: #34d399 !important; }
        html.dark .kpi-icon.purple { background-color: #2d1b69 !important; color: #a78bfa !important; }

        html.dark .filter-card {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
        }

        html.dark .sessions-table-card {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
        }
        html.dark .sessions-table-card thead th {
            background-color: #151E1B !important;
            color: #9CA8A3 !important;
            border-color: #2B3833 !important;
        }
        html.dark .sessions-table-card tbody tr:hover {
            background-color: rgba(255,255,255,0.02) !important;
        }
        html.dark .sessions-table-card tbody td {
            color: #EAEFEA !important;
            border-color: #2B3833 !important;
        }

        /* Audit badge-role pills */
        html.dark .badge-role.admin        { background-color: #0f2a4a !important; color: #60a5fa !important; }
        html.dark .badge-role.doctor       { background-color: #0c2f1e !important; color: #34d399 !important; }
        html.dark .badge-role.receptionist { background-color: #3d2f0a !important; color: #fbbf24 !important; }
        html.dark .badge-role.other        { background-color: #202B27 !important; color: #9CA8A3 !important; }

        /* Audit status-badge pills */
        html.dark .status-badge.online { background-color: #0c2f1e !important; color: #34d399 !important; }
        html.dark .status-badge.ended  { background-color: #202B27 !important; color: #9CA8A3 !important; }

        /* Audit device-badge */
        html.dark .device-badge {
            background-color: #202B27 !important;
            color: #9CA8A3 !important;
        }

        /* ── 12. metric-card & filter-card (used in Invoices, Appointments) ──── */
        html.dark .metric-card {
            background-color: #1B2421 !important;
            border-color: #2B3833 !important;
        }

        /* ── 13. Bootstrap bg-tertiary (table striping, thead) ──────────────── */
        html.dark .table > :not(caption) > * > * {
            background-color: transparent !important;
            color: #EAEFEA !important;
            border-color: #2B3833 !important;
        }
        html.dark .table-striped > tbody > tr:nth-of-type(odd) > * {
            background-color: rgba(255,255,255,0.015) !important;
        }

        /* ── 14. Code elements & IP addresses ───────────────────────────────── */
        html.dark code {
            background-color: #151E1B !important;
            color: #EAEFEA !important;
        }
    </style>
</head>
<body class="h-full bg-[#F8FAF9] dark:bg-[#121816] text-[#1A2621] dark:text-[#EAEFEA] antialiased transition-colors duration-200">

    <!-- Mobile Menu Backdrop -->
    <div id="cf-sidebar-backdrop" class="fixed inset-0 bg-[#202725]/40 backdrop-blur-sm z-40 md:hidden hidden" onclick="toggleMobileSidebar()"></div>

    <!-- Master App Layout Shell -->
    <div class="flex h-screen w-screen overflow-hidden">

        <!-- Fixed White Clinical Sidebar -->
        <aside id="cf-main-sidebar"
               class="fixed inset-y-0 start-0 z-50 w-64 bg-white dark:bg-[#1B2421] border-e border-[#DDE3DF] dark:border-[#2B3833] p-4 flex flex-col justify-between transition-transform duration-200 ease-in-out -translate-x-full md:translate-x-0 md:sticky md:top-0 md:h-screen md:shrink-0 overflow-y-auto shadow-[1px_0_0_0_#DDE3DF]">

            <div class="flex flex-col gap-4">
                <!-- Brand / Logo Header -->
                <div class="flex items-center gap-3 px-2 py-2 mb-1">
                    @if (hasClinicLogo)
                    {
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0 overflow-hidden">
                            <img src="@clinicLogo" alt="Clinic Logo" class="max-w-full max-h-full object-contain p-1" onerror="this.parentElement.innerHTML='<svg class=\'w-5 h-5\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\' /></svg>'" />
                        </div>
                    }
                    else
                    {
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                    }
                    <div class="min-w-0">
                        <h1 class="text-[13px] font-bold text-[#202725] dark:text-[#EAEFEA] leading-tight truncate" title="@clinicName">@clinicName</h1>
                        <span class="text-[11px] font-medium text-[#727A76] dark:text-[#9CA8A3] block truncate">@T("فئة ممتازة • سحابي", "Premium Tier • Cloud")</span>
                    </div>
                </div>

                <!-- Action Button: New Appointment -->
                <a asp-controller="Appointments" asp-action="Create"
                   class="w-full py-2.5 px-4 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2 transition-colors active:scale-[0.98]">
                    <i class="fa-solid fa-plus"></i>
                    <span>@T("موعد جديد", "New Appointment")</span>
                </a>

                <!-- Navigation Links List -->
                <nav class="flex flex-col gap-0.5 mt-1">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-[#727A76] dark:text-[#9CA8A3] px-3 py-1.5 mb-0.5">
                        @T("القائمة الرئيسية", "Navigation")
                    </div>

                    <!-- 1. Dashboard -->
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Dashboard" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-chart-pie w-5 text-center text-sm"></i>
                        <span>@T("لوحة التحكم", "Dashboard")</span>
                    </a>

                    <!-- 2. Patients -->
                    <a asp-controller="Patients" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Patients" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-users w-5 text-center text-sm"></i>
                        <span>@T("سجلات المرضى", "Patients")</span>
                    </a>

                    <!-- 3. Appointments -->
                    <a asp-controller="Appointments" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Appointments" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-calendar-check w-5 text-center text-sm"></i>
                        <span>@T("الجداول والمواعيد", "Appointments")</span>
                    </a>

                    <!-- 4. Doctors -->
                    <a asp-controller="Doctors" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Doctors" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-user-doctor w-5 text-center text-sm"></i>
                        <span>@T("الأطباء", "Doctors")</span>
                    </a>

                    <!-- 5. Departments -->
                    <a asp-controller="Departments" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Departments" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-sitemap w-5 text-center text-sm"></i>
                        <span>@T("الأقسام والتخصصات", "Departments")</span>
                    </a>

                    <!-- Divider -->
                    <div class="my-1.5 border-t border-[#DDE3DF] dark:border-[#2B3833]"></div>
                    <div class="text-[10px] font-bold uppercase tracking-widest text-[#727A76] dark:text-[#9CA8A3] px-3 py-1 mb-0.5">
                        @T("المالية", "Finance")
                    </div>

                    <!-- 6. Invoices -->
                    <a asp-controller="Invoices" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Invoices" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-file-invoice-dollar w-5 text-center text-sm"></i>
                        <span>@T("الفوترة والمدفوعات", "Invoices")</span>
                    </a>

                    <!-- 7. Expenses -->
                    <a asp-controller="Expenses" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Expenses" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-receipt w-5 text-center text-sm"></i>
                        <span>@T("المصروفات التشغيلية", "Expenses")</span>
                    </a>

                    <!-- Divider -->
                    <div class="my-1.5 border-t border-[#DDE3DF] dark:border-[#2B3833]"></div>
                    <div class="text-[10px] font-bold uppercase tracking-widest text-[#727A76] dark:text-[#9CA8A3] px-3 py-1 mb-0.5">
                        @T("الخدمات", "Clinical")
                    </div>

                    <!-- 8. Treatments -->
                    <a asp-controller="Treatments" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Treatments" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-stethoscope w-5 text-center text-sm"></i>
                        <span>@T("العلاجات والخدمات", "Treatments")</span>
                    </a>

                    <!-- 9. Settings -->
                    <a asp-controller="Settings" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Settings" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                        <i class="fa-solid fa-sliders w-5 text-center text-sm"></i>
                        <span>@T("الإعدادات والنسخ السحابي", "Settings")</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="my-1.5 border-t border-[#DDE3DF] dark:border-[#2B3833]"></div>
                        <div class="text-[10px] font-bold uppercase tracking-widest text-[#727A76] dark:text-[#9CA8A3] px-3 py-1 mb-0.5">
                            @T("الإدارة الإضافية", "Management")
                        </div>

                        <a asp-controller="Reports" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "Reports" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                            <i class="fa-solid fa-chart-line w-5 text-center text-sm"></i>
                            <span>@T("التقارير التحليلية", "Reports")</span>
                        </a>

                        <a asp-controller="AuditTrail" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors @(currentController == "AuditTrail" || currentController == "Audit" ? "bg-[#49665A] text-white shadow-sm font-semibold" : "text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                            <i class="fa-solid fa-shield-halved w-5 text-center text-sm"></i>
                            <span>@T("سجل النشاط والأمان", "Audit Trail")</span>
                        </a>
                    }
                </nav>
            </div>

            <!-- Sidebar Footer -->
            <div class="pt-3 border-t border-[#DDE3DF] dark:border-[#2B3833] mt-4">
                <div class="flex items-center justify-between text-[11px] text-[#727A76] dark:text-[#9CA8A3] px-2">
                    <span class="font-medium">ClinicFlow SaaS</span>
                    <span class="px-2 py-0.5 rounded-md bg-[#F6F7F5] dark:bg-[#151E1B] border border-[#DDE3DF] dark:border-[#2B3833] text-[#49665A] font-bold text-[10px]">v3.0</span>
                </div>
            </div>
        </aside>

        <!-- Main Viewport Area -->
        <div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden">

            <!-- Sticky Top Header Bar -->
            <header class="h-16 bg-white dark:bg-[#1B2421] border-b border-[#DDE3DF] dark:border-[#2B3833] flex items-center justify-between px-6 flex-shrink-0 z-10">

                <!-- LEFT: Mobile Toggle + Page Title -->
                <div class="flex items-center gap-3 min-w-0">
                    <button type="button"
                            class="p-2 rounded-lg text-[#727A76] dark:text-[#9CA8A3] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] hover:text-[#202725] dark:hover:text-[#EAEFEA] md:hidden transition-colors"
                            onclick="toggleMobileSidebar()">
                        <i class="fa-solid fa-bars text-base"></i>
                    </button>

                    <div class="flex items-center gap-2 md:hidden shrink-0">
                        @if (hasClinicLogo)
                        {
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0 overflow-hidden">
                                <img src="@clinicLogo" alt="Clinic Logo" class="max-w-full max-h-full object-contain p-0.5" onerror="this.parentElement.innerHTML='<svg class=\'w-4 h-4\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\' /></svg>'" />
                            </div>
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                            </div>
                        }
                    </div>

                    <div class="min-w-0">
                        <h2 class="text-base sm:text-lg font-bold text-[#202725] dark:text-[#EAEFEA] tracking-tight truncate m-0">
                            @(ViewData["Title"] ?? (currentController switch
                            {
                                "Dashboard" => T("لوحة التحكم السريرية", "Clinic Dashboard"),
                                "Patients" => T("سجلات المرضى", "Patients Directory"),
                                "Appointments" => T("الجداول والمواعيد", "Appointments"),
                                "Doctors" => T("الأطباء والعيادات", "Doctors"),
                                "Departments" => T("الأقسام والتخصصات", "Departments"),
                                "Invoices" => T("الفوترة والمدفوعات", "Invoices"),
                                "Expenses" => T("المصروفات التشغيلية", "Expenses"),
                                "Treatments" => T("العلاجات والخدمات", "Treatments"),
                                "Settings" => T("مركز التحكم والإعدادات", "Settings"),
                                "AuditTrail" => T("سجل تدقيق العمليات", "Audit Trail"),
                                "Audit" => T("سجل تدقيق العمليات", "Audit Trail"),
                                _ => clinicName
                            }))
                        </h2>
                    </div>
                </div>

                <!-- RIGHT: Theme Toggle + Language Switcher + User Profile -->
                <div class="flex items-center gap-2 flex-shrink-0">

                    <!-- Theme Switcher Button -->
                    <button id="themeToggleBtn" onclick="toggleTheme()" type="button"
                            class="p-2 rounded-lg border border-[#DDE3DF] dark:border-[#2B3833] text-[#727A76] dark:text-[#9CA8A3] hover:bg-gray-100 dark:hover:bg-[#151E1B] transition"
                            title="Toggle Theme">
                        <i id="themeIcon" class="fa-solid fa-moon text-sm"></i>
                    </button>

                    <!-- Language Switcher Pill -->
                    <div class="flex items-center bg-[#F6F7F5] dark:bg-[#151E1B] p-0.5 rounded-lg border border-[#DDE3DF] dark:border-[#2B3833]">
                        <form asp-controller="Language" asp-action="SetLanguage" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="ar" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit"
                                    class="px-2.5 py-1 rounded-md text-xs font-medium transition-all @(_isAr ? "bg-white dark:bg-[#1B2421] text-[#49665A] shadow-sm font-bold border border-[#DDE3DF] dark:border-[#2B3833]" : "text-[#727A76] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                                عربي
                            </button>
                        </form>
                        <form asp-controller="Language" asp-action="SetLanguage" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="en" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit"
                                    class="px-2.5 py-1 rounded-md text-xs font-medium transition-all @(!_isAr ? "bg-white dark:bg-[#1B2421] text-[#49665A] shadow-sm font-bold border border-[#DDE3DF] dark:border-[#2B3833]" : "text-[#727A76] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                                EN
                            </button>
                        </form>
                    </div>

                    <!-- User Profile Dropdown -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var initials = (User.Identity.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U");
                        <div class="relative">
                            <div class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] cursor-pointer transition-colors border border-transparent hover:border-[#DDE3DF] dark:hover:border-[#2B3833]"
                                 onclick="toggleDropdown('cf-user-dropdown')">
                                <div class="w-8 h-8 rounded-full bg-[#49665A]/10 border border-[#49665A]/20 text-[#49665A] font-bold text-xs flex items-center justify-center shrink-0">
                                    @initials
                                </div>
                                <div class="hidden sm:block text-start leading-tight">
                                    <span class="text-xs font-bold text-[#202725] dark:text-[#EAEFEA] block truncate max-w-[120px]">@User.Identity.Name</span>
                                    <span class="text-[10px] font-semibold text-[#727A76] dark:text-[#9CA8A3] uppercase tracking-wider">
                                        @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : "Reception")
                                    </span>
                                </div>
                                <i class="fa-solid fa-chevron-down text-[10px] text-[#727A76] dark:text-[#9CA8A3] ms-0.5"></i>
                            </div>

                            <div id="cf-user-dropdown"
                                 class="hidden absolute top-full mt-2 end-0 w-52 bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-xl shadow-lg py-1.5 z-50">
                                <div class="px-3 py-2 border-b border-[#DDE3DF] dark:border-[#2B3833] mb-1">
                                    <p class="text-xs font-bold text-[#202725] dark:text-[#EAEFEA] truncate m-0">@User.Identity.Name</p>
                                    <p class="text-[11px] text-[#727A76] dark:text-[#9CA8A3] truncate m-0">@(User.IsInRole("Admin") ? T("مسؤول النظام", "System Administrator") : "Staff")</p>
                                </div>

                                <a asp-controller="Settings" asp-action="Index"
                                   class="flex items-center gap-2 px-3 py-1.5 text-xs text-[#202725] dark:text-[#EAEFEA] hover:bg-[#F6F7F5] dark:hover:bg-[#151E1B] transition-colors">
                                    <i class="fa-solid fa-sliders text-[#727A76] dark:text-[#9CA8A3] w-4"></i>
                                    <span>@T("الإعدادات", "Settings")</span>
                                </a>

                                <div class="border-t border-[#DDE3DF] dark:border-[#2B3833] my-1"></div>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="w-full flex items-center gap-2 px-3 py-1.5 text-xs text-[#B83A38] hover:bg-[#FCEEEE] dark:hover:bg-[#2A1A1A] transition-colors text-start">
                                        <i class="fa-solid fa-arrow-right-from-bracket w-4"></i>
                                        <span>@T("تسجيل الخروج", "Sign Out")</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                </div>
            </header>

            <!-- Scrollable View Canvas -->
            <main id="cf-main-canvas" class="flex-1 overflow-y-auto p-6 w-full bg-[#F8FAF9] dark:bg-[#121816] transition-colors duration-200">
                <div class="w-full max-w-7xl mx-auto space-y-6">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="cf-toast-container" class="fixed bottom-4 end-4 z-50 flex flex-col gap-2 max-w-sm w-full px-4 pointer-events-none">
        @if (TempData["Success"] != null)
        {
            <div class="pointer-events-auto bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-xl p-3.5 shadow-lg flex items-start gap-3">
                <div class="w-7 h-7 rounded-full bg-[#EAF5F0] dark:bg-[#202B27] flex items-center justify-center shrink-0 mt-0.5">
                    <i class="fa-solid fa-circle-check text-[#2E7D5B] text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h5 class="text-xs font-bold text-[#202725] dark:text-[#EAEFEA] m-0">@T("نجاح العملية", "Success")</h5>
                    <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] mt-0.5 mb-0">@TempData["Success"]</p>
                </div>
                <button type="button" class="text-[#727A76] hover:text-[#202725] p-0.5 text-sm" onclick="this.closest('.pointer-events-auto').remove()">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="pointer-events-auto bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-xl p-3.5 shadow-lg flex items-start gap-3">
                <div class="w-7 h-7 rounded-full bg-[#FCEEEE] dark:bg-[#2A1A1A] flex items-center justify-center shrink-0 mt-0.5">
                    <i class="fa-solid fa-circle-xmark text-[#B83A38] text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h5 class="text-xs font-bold text-[#202725] dark:text-[#EAEFEA] m-0">@T("تنبيه", "Error Notice")</h5>
                    <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] mt-0.5 mb-0">@TempData["Error"]</p>
                </div>
                <button type="button" class="text-[#727A76] hover:text-[#202725] p-0.5 text-sm" onclick="this.closest('.pointer-events-auto').remove()">&times;</button>
            </div>
        }
    </div>

    <!-- Global Modals -->
    <partial name="_AddUserModal" />
    <partial name="_AppointmentsModal" />

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleDropdown(id) {
            var el = document.getElementById(id);
            if (!el) return;
            var isHidden = el.classList.contains('hidden');
            document.querySelectorAll('#cf-user-dropdown').forEach(d => d.classList.add('hidden'));
            if (isHidden) el.classList.remove('hidden');
        }

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.relative')) {
                document.querySelectorAll('#cf-user-dropdown').forEach(d => d.classList.add('hidden'));
            }
        });

        function toggleMobileSidebar() {
            var sb = document.getElementById('cf-main-sidebar');
            var bd = document.getElementById('cf-sidebar-backdrop');
            if (sb && bd) {
                sb.classList.toggle('-translate-x-full');
                bd.classList.toggle('hidden');
            }
        }
    </script>

    <script>
        function applyTheme(isDark) {
            const html = document.documentElement;
            if (isDark) {
                html.classList.add('dark');
                html.setAttribute('data-theme', 'dark');
                html.setAttribute('data-bs-theme', 'dark');
                localStorage.setItem('clinic_theme', 'dark');
            } else {
                html.classList.remove('dark');
                html.setAttribute('data-theme', 'light');
                html.setAttribute('data-bs-theme', 'light');
                localStorage.setItem('clinic_theme', 'light');
            }
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = isDark ? 'fa-solid fa-sun text-sm text-amber-400' : 'fa-solid fa-moon text-sm text-[#727A76]';
            }
        }

        function toggleTheme() {
            const isCurrentlyDark = document.documentElement.classList.contains('dark');
            applyTheme(!isCurrentlyDark);
        }

        (function initTheme() {
            const saved = localStorage.getItem('clinic_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = saved ? saved === 'dark' : prefersDark;
            applyTheme(isDark);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>