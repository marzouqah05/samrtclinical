@using System.Globalization
@{
    var _culture = CultureInfo.CurrentCulture;
    var _isAr = _culture.TwoLetterISOLanguageName == "ar";
    Func<string, string, string> T = (ar, en) => _isAr ? ar : en;
}

@* ══════════════════════════════════════════════════════
   DOCTOR INTERNAL REFERRAL MODAL
══════════════════════════════════════════════════════ *@
<div id="doctorReferralModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 items-center justify-center p-4 hidden flex" style="display:none;" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-4 animate-in fade-in zoom-in-95 duration-150 text-start">
        
        <!-- Modal Header -->
        <div class="flex items-start justify-between border-b border-[#DDE3DF] dark:border-[#2B3833] pb-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 dark:bg-[#49665A]/20 text-[#49665A] dark:text-emerald-400 flex items-center justify-center text-base font-bold">
                    <i class="fa-solid fa-share-from-square"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                        @T("إحالة لعيادة أخرى", "Refer to Another Department")
                    </h3>
                    <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0" id="ref-modal-subtitle">
                        @T("تحويل المريض لقسم أو استشاري متخصص", "Send patient referral to reception for scheduling")
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeDoctorReferralModal()" class="text-[#727A76] hover:text-[#202725] dark:hover:text-[#EAEFEA] text-lg font-bold p-1">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Referral Form -->
        <form id="doctorReferralForm" onsubmit="submitDoctorReferral(event)" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="ref-patientId" name="patientId" />

            <!-- Selected Patient Highlight -->
            <div class="p-3 bg-[#F6F7F5] dark:bg-[#151E1B] rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-user-injured text-[#49665A] dark:text-emerald-400 text-xs"></i>
                    <span class="text-xs font-semibold text-[#727A76] dark:text-[#9CA8A3]">@T("المريض:", "Patient:")</span>
                    <span id="ref-patientName" class="text-xs font-bold text-[#202725] dark:text-[#EAEFEA]">—</span>
                </div>
                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    @T("إحالة داخلية", "Internal Referral")
                </span>
            </div>

            <!-- Target Department Dropdown -->
            <div>
                <label class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                    <i class="fa-solid fa-hospital-user text-[#49665A] dark:text-emerald-400 me-1"></i>
                    @T("القسم أو العيادة المستهدفة", "Target Department") *
                </label>
                <select id="ref-targetDepartmentId" name="targetDepartmentId" required onchange="onReferralDeptChanged(this.value)"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-white dark:bg-[#121A17] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition">
                    <option value="">@T("اختر القسم المستهدف...", "Select Target Department...")</option>
                </select>
            </div>

            <!-- Optional Preferred Doctor Dropdown -->
            <div>
                <label class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                    <i class="fa-solid fa-user-doctor text-[#49665A] dark:text-emerald-400 me-1"></i>
                    @T("الطبيب المفضل (اختياري - يُترك للاستقبال لتحديده)", "Preferred Doctor (Optional - can be left to Reception)")
                </label>
                <select id="ref-targetDoctorId" name="targetDoctorId"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-white dark:bg-[#121A17] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition">
                    <option value="">@T("أي طبيب متاح في القسم (اتركه للاستقبال)", "Any available doctor in department (leave to reception)")</option>
                </select>
            </div>

            <!-- Clinical Reason / Symptoms Note (MANDATORY) -->
            <div>
                <label class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                    <i class="fa-solid fa-notes-medical text-[#49665A] dark:text-emerald-400 me-1"></i>
                    @T("سبب التحويل الطبي", "Clinical Reason / سبب التحويل الطبي") <span class="text-rose-500 font-bold">*</span>
                </label>
                <textarea id="ref-referralReason" name="referralReason" rows="3" required
                          class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-white dark:bg-[#121A17] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                          placeholder="@T("مثال: الاشتباه في وجود التهاب في العصب يتطلب تقييماً متخصصاً لعلاج الجذور...", "e.g., Suspected root canal infection requiring endodontic evaluation...")"></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-[#DDE3DF] dark:border-[#2B3833]">
                <button type="button" onclick="closeDoctorReferralModal()"
                        class="px-4 py-2 border border-[#DDE3DF] dark:border-[#2B3833] bg-transparent hover:bg-gray-100 dark:hover:bg-[#121A17] text-[#727A76] dark:text-[#EAEFEA] text-xs font-semibold rounded-xl transition">
                    @T("إلغاء", "Cancel")
                </button>
                <button type="submit" id="ref-submit-btn"
                        class="px-5 py-2 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                    <span>@T("إرسال الإحالة للاستقبال", "Send Referral to Reception")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@* ── Global Floating Toast Container ───────────────────────── *@
<div id="cf-toast-container" class="fixed bottom-5 end-5 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

<script>
    let isRefDeptsLoaded = false;

    async function openReferralModal(patientId, patientName) {
        document.getElementById('ref-patientId').value = patientId || '';
        document.getElementById('ref-patientName').textContent = patientName || 'Patient';
        document.getElementById('ref-referralReason').value = '';

        const modal = document.getElementById('doctorReferralModal');
        if (modal) modal.style.display = 'flex';

        if (!isRefDeptsLoaded) {
            await loadReferralDepartments();
        }
    }

    function closeDoctorReferralModal() {
        const modal = document.getElementById('doctorReferralModal');
        if (modal) modal.style.display = 'none';
    }

    async function loadReferralDepartments() {
        const select = document.getElementById('ref-targetDepartmentId');
        if (!select) return;

        try {
            const res = await fetch('/Referrals/GetDepartments');
            if (res.ok) {
                const depts = await res.json();
                const isAr = document.documentElement.getAttribute('dir') === 'rtl';
                select.innerHTML = `<option value="">${isAr ? 'اختر القسم المستهدف...' : 'Select Target Department...'}</option>`;
                depts.forEach(d => {
                    select.innerHTML += `<option value="${d.id}">${escapeRefHtml(d.name)}</option>`;
                });
                isRefDeptsLoaded = true;
            }
        } catch (e) {
            console.error('[DoctorReferral] Error loading departments:', e);
        }
    }

    async function onReferralDeptChanged(deptId) {
        const docSelect = document.getElementById('ref-targetDoctorId');
        if (!docSelect) return;
        const isAr = document.documentElement.getAttribute('dir') === 'rtl';

        if (!deptId) {
            docSelect.innerHTML = `<option value="">${isAr ? 'أي طبيب متاح في القسم (اتركه للاستقبال)' : 'Any available doctor in department (leave to reception)'}</option>`;
            return;
        }

        docSelect.innerHTML = `<option value="">${isAr ? 'جاري تحميل الأطباء...' : 'Loading doctors...'}</option>`;

        try {
            const res = await fetch(`/Referrals/GetDoctorsByDepartment?departmentId=${deptId}`);
            if (res.ok) {
                const docs = await res.json();
                docSelect.innerHTML = `<option value="">${isAr ? 'أي طبيب متاح في القسم (اتركه للاستقبال)' : 'Any available doctor in department (leave to reception)'}</option>`;
                docs.forEach(d => {
                    docSelect.innerHTML += `<option value="${d.id}">${escapeRefHtml(d.name)}</option>`;
                });
            }
        } catch (e) {
            console.error('[DoctorReferral] Error loading doctors:', e);
            docSelect.innerHTML = `<option value="">${isAr ? 'أي طبيب متاح في القسم' : 'Any available doctor'}</option>`;
        }
    }

    async function submitDoctorReferral(event) {
        event.preventDefault();
        const reasonInput = document.getElementById('ref-referralReason');
        const reason = reasonInput?.value?.trim();
        const isAr = document.documentElement.getAttribute('dir') === 'rtl';

        if (!reason) {
            alert(isAr ? 'سبب التحويل الطبي إلزامي (يرجى كتابة التبرير السريري للمتابعة).' : 'Clinical Reason / Reason for Transfer is mandatory. Please fill in the justification.');
            reasonInput?.focus();
            return;
        }

        const btn = document.getElementById('ref-submit-btn');
        if (btn) btn.disabled = true;

        const form = document.getElementById('doctorReferralForm');
        const formData = new FormData(form);

        try {
            const res = await fetch('/Referrals/Create', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await res.json();
            if (data.success) {
                closeDoctorReferralModal();
                showCustomToast(data.message || 'Referral sent to reception for scheduling.');
            } else {
                alert(data.message || 'Failed to submit referral.');
            }
        } catch (err) {
            console.error('[DoctorReferral] Submit error:', err);
            alert('An error occurred while submitting the referral.');
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    function showCustomToast(msg) {
        const container = document.getElementById('cf-toast-container');
        if (!container) {
            alert(msg);
            return;
        }

        const toast = document.createElement('div');
        toast.className = 'pointer-events-auto bg-[#202725] text-white dark:bg-[#1B2421] dark:text-[#EAEFEA] border border-emerald-500/40 p-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 transform translate-y-2 opacity-0 text-xs font-semibold';
        toast.innerHTML = `
            <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="flex-1">${escapeRefHtml(msg)}</div>
        `;

        container.appendChild(toast);
        requestAnimationFrame(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    function escapeRefHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
</script>
