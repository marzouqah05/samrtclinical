@using System.Globalization
@using WebApplication1.Services
@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    Func<string, string, string> T = (ar, en) => _isAr ? ar : en;
    var isOwner = User.IsOwner();
}

<div id="addUserModal" class="cf-modal-overlay" style="display:none;">
    <div class="cf-modal max-w-lg w-full">
        <div class="cf-modal-header">
            <div class="d-flex align-items-center gap-2">
                <div class="cf-modal-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div>
                    <h3 class="cf-modal-title">@T("إضافة موظف جديد للنظام", "Add New Staff Member")</h3>
                    <p class="cf-modal-subtitle m-0">@T("منح صلاحيات الوصول للكوادر الطبية والإدارية", "Grant role and access permissions")</p>
                </div>
            </div>
            <button type="button" class="cf-modal-close" onclick="closeAddUserModal()">&times;</button>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" id="addUserModalForm">
            @Html.AntiForgeryToken()

            <div class="cf-form-grid-2 mb-3">
                <div>
                    <label class="cf-form-label">@T("اسم المستخدم للدخول", "Username") <span class="text-rose-500">*</span></label>
                    <input type="text" name="Username" required class="cf-form-input" placeholder="dr_smith" dir="ltr" autocomplete="username" />
                    <span class="text-[10px] text-[#727A76] block mt-0.5">@T("يستخدم لتسجيل الدخول المباشر", "Used for direct sign in")</span>
                </div>
                <div>
                    <label class="cf-form-label">@T("الاسم الكامل للموظف", "Full Name")</label>
                    <input type="text" name="FullName" class="cf-form-input" placeholder="@T("د. جون سميث", "Dr. John Smith")" />
                    <span class="text-[10px] text-[#727A76] block mt-0.5">@T("الاسم الظاهر في الملفات والتقارير", "Display name on reports")</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="cf-form-label">@T("البريد الإلكتروني المهني", "Email Address (Optional)")</label>
                <input type="email" name="Email" class="cf-form-input" placeholder="alias@clinic.local" dir="ltr" />
                <span class="text-[10px] text-[#727A76] block mt-0.5">@T("إذا تُرك فارغاً، سيتم تعيين بريد افتراضي تلقائياً (username@clinic.local)", "If omitted, default alias is auto-assigned (username@clinic.local)")</span>
            </div>

            <div class="cf-form-grid-2 mb-3">
                <div>
                    <label class="cf-form-label">@T("كلمة المرور", "Password") <span class="text-rose-500">*</span></label>
                    <input type="password" name="Password" required class="cf-form-input" placeholder="••••••••" dir="ltr" />
                </div>
                <div>
                    <label class="cf-form-label">@T("الدور الوظيفي", "Role") <span class="text-rose-500">*</span></label>
                    <select name="Role" class="cf-form-select" required>
                        @if (isOwner)
                        {
                            <option value="Admin">@T("مدير نظام (Admin)", "Administrator")</option>
                        }
                        <option value="Doctor" selected>@T("طبيب (Doctor)", "Doctor")</option>
                        <option value="Receptionist">@T("موظف استقبال (Receptionist)", "Receptionist")</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <button type="button" class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5" onclick="closeAddUserModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                    <span>@T("حفظ وتسجيل الموظف", "Save Staff Member")</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddUserModal() {
        var modal = document.getElementById('addUserModal');
        if (modal) modal.style.display = 'flex';
    }
    function closeAddUserModal() {
        var modal = document.getElementById('addUserModal');
        if (modal) modal.style.display = 'none';
    }
</script>
