@model WebApplication1.Models.Invoice

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("طباعة الفاتورة - ", "Print Invoice - ") + Model.InvoiceNumber;
    Layout = null; // نلغي اللي آوت الأساسي للموقع عشان تطلع الفاتورة لحالها بورقة بيضاء نظيفة
}

<!DOCTYPE html>
<html lang="@(_isAr ? "ar" : "en")" dir="@(_isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .invoice-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 40px;
            margin-top: 30px;
            margin-bottom: 30px;
        }
        .invoice-logo {
            font-size: 28px;
            font-weight: 700;
            color: #0d6efd;
        }
        .table-invoice th {
            background-color: #f8f9fa;
            color: #495057;
        }
        .badge-print {
            padding: 6px 12px;
            border-radius: 50px;
            font-weight: 600;
        }
        /* تنسيقات خاصة عند الطباعة الورقية */
        @@media print {
            body {
                background-color: #fff;
            }
            .invoice-card {
                box-shadow: none;
                padding: 0;
                margin: 0;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <!-- شريط التحكم العلوي (يختفي تلقائياً عند الطباعة) -->
    <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-white rounded shadow-sm no-print">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left @(_isAr ? "ms-1" : "me-1")"></i> @T("العودة للقائمة", "Back to List")
        </a>
        <button onclick="window.print();" class="btn btn-primary px-4">
            <i class="fa-solid fa-print @(_isAr ? "ms-1" : "me-1")"></i> @T("طباعة الفاتورة", "Print Invoice")
        </button>
    </div>

    <!-- كرت الفاتورة الرئيسي الرسمي -->
    <div class="invoice-card">
        <!-- ترويسة الفاتورة -->
        <div class="row align-items-center mb-5">
            <div class="col-sm-6">
                <div class="invoice-logo">
                    <i class="fa-solid fa-heart-pulse @(_isAr ? "ms-2" : "me-2")"></i>@T("ميديكير", "MediCare")
                </div>
                <p class="text-muted small mb-0">@T("نظام إدارة العيادة", "Clinic Management System")</p>
            </div>
            <div class="col-sm-6 @(_isAr ? "text-sm-start" : "text-sm-end") mt-3 mt-sm-0">
                <h3 class="text-uppercase fw-bold text-secondary">@T("إيصال / فاتورة", "Receipt / Invoice")</h3>
                <span class="text-muted">@T("رقم الفاتورة:", "Invoice No:")</span> <span class="fw-bold text-dark">#@Model.InvoiceNumber</span>
            </div>
        </div>

        <hr class="my-4" />

        <!-- تفاصيل المريض والزيارة -->
        <div class="row mb-5">
            <div class="col-sm-6">
                <h6 class="text-primary fw-bold text-uppercase mb-3">@T("فاتورة للمريض", "Billed To (Patient)")</h6>
                <h5 class="fw-bold text-dark mb-1">@Model.Patient?.PatientName</h5>
                <p class="text-muted mb-1"><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1") small"></i> @Model.Patient?.PhoneNumber</p>
                <p class="text-muted mb-0"><i class="fa-solid fa-id-card @(_isAr ? "ms-1" : "me-1") small"></i> @T("رقم المريض:", "Patient No:") @Model.Patient?.PatientNumber</p>
            </div>
            <div class="col-sm-6 @(_isAr ? "text-sm-start" : "text-sm-end") mt-4 mt-sm-0">
                <h6 class="text-primary fw-bold text-uppercase mb-3">@T("تفاصيل الفاتورة", "Invoice Details")</h6>
                <p class="text-muted mb-1"><strong>@T("التاريخ:", "Date:")</strong> @Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</p>
                <p class="text-muted mb-1">
                    <strong>@T("حالة الدفع:", "Payment Status:")</strong> 
                    @if (Model.Status == "Paid")
                    {
                        <span class="badge bg-success-subtle text-success badge-print">@T("مدفوع", "Paid")</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger badge-print">@T("غير مدفوع", "Unpaid")</span>
                    }
                </p>
                <p class="text-muted mb-0"><strong>@T("الطبيب:", "Doctor:")</strong> @(_isAr ? "د." : "Dr.") @Model.Treatment?.Appointment?.Doctor?.DoctorName</p>
            </div>
        </div>

        <!-- جدول الحسابات التفصيلي -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-invoice align-middle">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 10%">#</th>
                        <th style="width: 60%">@T("وصف الخدمة", "Service Description")</th>
                        <th class="@(_isAr ? "text-start" : "text-end")" style="width: 30%">@T("المبلغ", "Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">1</td>
                        <td>
                            <strong>@T("رسوم استشارة الطبيب", "Doctor Consultation Fee")</strong><br />
                            <small class="text-muted">@T("التخصص:", "Specialization:") @Model.Treatment?.Appointment?.Doctor?.Specialization</small>
                        </td>
                        <td class="@(_isAr ? "text-start" : "text-end")">@((Model.Treatment?.Appointment?.Doctor?.ConsultationFee ?? 0).ToString("C2"))</td>
                    </tr>
                    <tr>
                        <td class="text-center">2</td>
                        <td>
                            <strong>@T("تكلفة العلاج الطبي", "Medical Treatment Cost")</strong><br />
                            <small class="text-muted">@T("الوصف:", "Description:") @Model.Treatment?.TreatmentDesc</small>
                        </td>
                        <td class="@(_isAr ? "text-start" : "text-end")">@((Model.Treatment?.TreatmentCost ?? 0).ToString("C2"))</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- المجاميع النهائية بالأسفل -->
        <div class="row justify-content-end">
            <div class="col-md-5 col-sm-7 @(_isAr ? "text-start" : "text-end")">
                <div class="row mb-2">
                    <div class="col-7 text-muted">@T("المجموع الإجمالي:", "Gross Total:")</div>
                    <div class="col-5 fw-semibold">@Model.Amount.ToString("C2")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-7 text-muted">@T("الخصم (-):", "Discount (-):")</div>
                    <div class="col-5 text-danger">@Model.Discount.ToString("C2")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-7 text-muted">@T("الضريبة (+):", "Tax (+):")</div>
                    <div class="col-5 text-success">@Model.Tax.ToString("C2")</div>
                </div>
                <hr class="my-2" />
                <div class="row align-items-center">
                    <div class="col-7 fs-5 fw-bold text-dark">@T("صافي المبلغ المستحق:", "Net Amount Due:")</div>
                    <div class="col-5 fs-4 fw-bold text-primary">@Model.NetAmount.ToString("C2")</div>
                </div>
            </div>
        </div>

        <!-- تذييل الفاتورة السفلي -->
        <div class="mt-5 pt-4 border-top text-center text-muted small">
            <p class="mb-1">@T("شكراً لاختياركم نظام عيادة ميديكير.", "Thank you for choosing MediCare Clinic Systems.")</p>
            <p class="mb-0">@T("هذا إيصال رسمي صادر من نظام العيادة الإلكتروني.", "This is a computer-generated official clinic receipt.")</p>
        </div>
    </div>
</div>

<script>
    // Auto-open print dialog when the page loads (after a short render delay).
    window.addEventListener('load', function () {
        setTimeout(function () { window.print(); }, 400);
    });
</script>
</body>
</html>