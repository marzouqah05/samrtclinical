@model WebApplication1.Models.Invoice
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("طباعة الفاتورة - ", "Print Invoice - ") + Model.InvoiceNumber;
    Layout = null; // Standalone printable invoice

    var clinic = await SettingsService.GetSettingsAsync();
    var clinicName = !string.IsNullOrWhiteSpace(clinic.ClinicName) ? clinic.ClinicName : T("المركز الطبي", "Medical Center");
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
    var hasLogo = !string.IsNullOrWhiteSpace(clinic.LogoPath) && clinic.LogoPath != "/images/logo.png";
}

<!DOCTYPE html>
<html lang="@(_isAr ? "ar" : "en")" dir="@(_isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1a202c;
        }
        .invoice-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            padding: 40px;
            margin-top: 30px;
            margin-bottom: 30px;
            border: 1px solid #e2e8f0;
        }
        .table-invoice th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-print {
            padding: 6px 12px;
            border-radius: 50px;
            font-weight: 600;
        }
        @@media print {
            body {
                background-color: #fff !important;
                color: #0f172a !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .invoice-card {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            img.clinic-logo-print {
                max-height: 64px !important;
                max-width: 180px !important;
                object-fit: contain !important;
                image-rendering: -webkit-optimize-contrast;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Screen-only toolbar -->
    <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-white rounded-3 shadow-sm border no-print">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left @(_isAr ? "ms-1" : "me-1")"></i> @T("العودة للقائمة", "Back to List")
        </a>
        <button onclick="window.print();" class="btn btn-primary px-4">
            <i class="fa-solid fa-print @(_isAr ? "ms-1" : "me-1")"></i> @T("طباعة الفاتورة", "Print Invoice")
        </button>
    </div>

    <!-- Official Invoice Card -->
    <div class="invoice-card">
        <!-- Clinic Branding Header -->
        <div class="row align-items-center mb-4 pb-3" style="border-bottom: 2px solid #0f172a;">
            <div class="col-sm-8">
                <div class="d-flex align-items-center gap-3">
                    @if (hasLogo)
                    {
                        <img src="@clinic.LogoPath" class="clinic-logo-print shrink-0" style="max-height: 64px; max-width: 180px; object-fit: contain;" alt="@clinicName" onerror="this.parentElement.innerHTML='<div style=\'width:48px;height:48px;border-radius:12px;background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.25);color:#059669;display:flex;align-items:center;justify-content:center;\' class=\'shrink-0\'><svg style=\'width:26px;height:26px;\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\' /></svg></div>'" />
                    }
                    else
                    {
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.25);color:#059669;display:flex;align-items:center;justify-content:center;" class="shrink-0">
                            <svg style="width:26px;height:26px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                    }
                    <div>
                        <h2 class="fw-bold mb-0 text-dark" style="font-size: 22px;">@clinicName</h2>
                        <p class="text-muted small mb-1">@T("نظام الفوترة الطبية المعتمد", "Official Clinical Billing System")</p>
                        <!-- Contact info badges -->
                        <div class="small text-muted d-flex flex-wrap gap-3">
                            @if (!string.IsNullOrWhiteSpace(clinic.ClinicPhone))
                            {
                                <span><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1") text-success"></i><strong>@clinic.ClinicPhone</strong></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(clinic.ClinicAddress))
                            {
                                <span><i class="fa-solid fa-location-dot @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicAddress</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(clinic.ClinicEmail))
                            {
                                <span><i class="fa-solid fa-envelope @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicEmail</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4 @(_isAr ? "text-sm-start" : "text-sm-end") mt-3 mt-sm-0">
                <h3 class="text-uppercase fw-bold text-secondary mb-1" style="font-size: 18px;">@T("إيصال / فاتورة", "Receipt / Invoice")</h3>
                <div class="fs-5">
                    <span class="text-muted" style="font-size: 14px;">@T("رقم الفاتورة:", "Invoice No:")</span> 
                    <span class="fw-bold text-dark font-monospace">#@Model.InvoiceNumber</span>
                </div>
                <div class="text-muted small mt-1">
                    @Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")
                </div>
            </div>
        </div>

        <!-- Patient & Visit Details -->
        <div class="row mb-5">
            <div class="col-sm-6">
                <h6 class="text-primary fw-bold text-uppercase mb-3">@T("فاتورة للمريض", "Billed To (Patient)")</h6>
                <h5 class="fw-bold text-dark mb-1">@Model.Patient?.PatientName</h5>
                <p class="text-muted mb-1"><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1") small"></i> @Model.Patient?.PhoneNumber</p>
                <p class="text-muted mb-0"><i class="fa-solid fa-id-card @(_isAr ? "ms-1" : "me-1") small"></i> @T("رقم المريض:", "Patient No:") @Model.Patient?.PatientNumber</p>
            </div>
            <div class="col-sm-6 @(_isAr ? "text-sm-start" : "text-sm-end") mt-4 mt-sm-0">
                <h6 class="text-primary fw-bold text-uppercase mb-3">@T("بيانات الطبيب والدفع", "Doctor & Payment Info")</h6>
                <p class="text-muted mb-1"><strong>@T("الطبيب المعالج:", "Attending Doctor:")</strong> @(_isAr ? "د." : "Dr.") @Model.Treatment?.Appointment?.Doctor?.DoctorName</p>
                <p class="text-muted mb-1"><strong>@T("التخصص:", "Specialization:")</strong> @Model.Treatment?.Appointment?.Doctor?.Specialization</p>
                <p class="text-muted mb-0">
                    <strong>@T("حالة الدفع:", "Payment Status:")</strong> 
                    @if (Model.Status == "Paid")
                    {
                        <span class="badge bg-success-subtle text-success badge-print">@T("مدفوع بالكامل", "Paid in Full")</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger badge-print">@T("غير مدفوع (معلّق)", "Unpaid / Pending")</span>
                    }
                </p>
            </div>
        </div>

        <!-- Breakdown Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-invoice align-middle">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 8%">#</th>
                        <th style="width: 62%">@T("وصف الخدمة / العلاج", "Service / Treatment Description")</th>
                        <th class="@(_isAr ? "text-start" : "text-end")" style="width: 30%">@T("المبلغ", "Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">1</td>
                        <td>
                            <strong>@T("رسوم استشارة الطبيب", "Doctor Consultation Fee")</strong><br />
                            <small class="text-muted">@T("الطبيب:", "Doctor:") @(_isAr ? "د." : "Dr.") @Model.Treatment?.Appointment?.Doctor?.DoctorName (@Model.Treatment?.Appointment?.Doctor?.Specialization)</small>
                        </td>
                        <td class="@(_isAr ? "text-start" : "text-end") fw-semibold">
                            @((Model.Treatment?.Appointment?.Doctor?.ConsultationFee ?? 0).ToString("N2")) @currency
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">2</td>
                        <td>
                            <strong>@T("تكلفة الإجراء والعلاج الطبي", "Medical Treatment Cost")</strong><br />
                            <small class="text-muted">@T("الوصف:", "Description:") @Model.Treatment?.TreatmentDesc</small>
                            @if (!string.IsNullOrEmpty(Model.Treatment?.Diagnosis))
                            {
                                <br /><small class="text-muted">@T("التشخيص:", "Diagnosis:") @Model.Treatment.Diagnosis</small>
                            }
                        </td>
                        <td class="@(_isAr ? "text-start" : "text-end") fw-semibold">
                            @((Model.Treatment?.TreatmentCost ?? 0).ToString("N2")) @currency
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Totals Summary -->
        <div class="row justify-content-end">
            <div class="col-md-5 col-sm-7 @(_isAr ? "text-start" : "text-end")">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@T("المجموع الإجمالي:", "Gross Total:")</span>
                        <span class="fw-semibold">@Model.Amount.ToString("N2") @currency</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@T("الخصم (-):", "Discount (-):")</span>
                        <span class="text-danger fw-semibold">@Model.Discount.ToString("N2") @currency</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@T("الضريبة", "VAT / Tax") (@clinic.TaxPercentage%):</span>
                        <span class="text-success fw-semibold">@Model.Tax.ToString("N2") @currency</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold text-dark">@T("صافي المبلغ المستحق:", "Net Amount Due:")</span>
                        <span class="fs-4 fw-bold text-primary">@Model.NetAmount.ToString("N2") @currency</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Official Footer -->
        <div class="mt-5 pt-4 border-top text-center text-muted small">
            <p class="mb-1">
                @T($"شكراً لاختياركم {clinicName}.", $"Thank you for choosing {clinicName}.")
            </p>
            <p class="mb-0">
                @T("هذا إيصال رسمي معتمد صادر من النظام الإلكتروني.", "This is a computer-generated official clinic receipt.")
            </p>
        </div>
    </div>
</div>

<script>
    // Auto-open print dialog when the page loads
    window.addEventListener('load', function () {
        setTimeout(function () { window.print(); }, 400);
    });
</script>
</body>
</html>