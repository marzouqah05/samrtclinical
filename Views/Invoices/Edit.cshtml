@model WebApplication1.Models.Invoice
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("تحصيل / تعديل الفاتورة", "Update Invoice & Collection");

    var clinic = await SettingsService.GetSettingsAsync();
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
}

<div class="max-w-2xl mx-auto my-8 px-4" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back Navigation Link ── *@
    <div class="mb-5">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى قائمة الفواتير", "Back to Invoices")</span>
        </a>
    </div>

    @* ── SaaS Card Container ── *@
    <div class="bg-white border border-slate-200 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-100 shadow-xl rounded-2xl p-6 text-start">

        @* ── Header Section ── *@
        <div class="flex items-center gap-3.5 pb-5 border-b border-slate-100 dark:border-slate-800 mb-6">
            <div class="w-11 h-11 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-pen-to-square text-xl"></i>
            </div>
            <div>
                <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 m-0">
                    @T("تحديث الفاتورة والتحصيل", "Update Invoice & Collection")
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 m-0 mt-0.5">
                    @T("إدارة حالة الدفع، تعديل الخصم، أو إضافة ضريبة للفاتورة", "Manage payment status, adjust discount, or apply tax for invoice")
                    <span class="font-bold text-emerald-600 dark:text-emerald-400 font-mono">#@Model.InvoiceNumber</span>
                </p>
            </div>
        </div>

        @* ── Summary Banner (Top) ── *@
        <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl p-4 flex items-center justify-between mb-6">
            <div class="flex flex-col">
                <span class="text-xs text-slate-500 dark:text-slate-400 mb-1 flex items-center gap-1.5">
                    <i class="fa-regular fa-calendar text-[11px] text-slate-400"></i>
                    @T("تاريخ الفاتورة", "Invoice Date")
                </span>
                <span class="text-sm font-semibold text-slate-900 dark:text-white">
                    @Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")
                </span>
            </div>

            <div class="flex flex-col text-end">
                <span class="text-xs text-slate-500 dark:text-slate-400 mb-1 flex items-center justify-end gap-1.5">
                    <i class="fa-solid fa-receipt text-[11px] text-emerald-500"></i>
                    @T("المبلغ الإجمالي", "Gross Amount")
                </span>
                <span class="text-base font-bold text-emerald-600 dark:text-emerald-400 font-mono">
                    @Model.Amount.ToString("N2") @currency
                </span>
            </div>
        </div>

        @* ── Edit Form ── *@
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 text-xs mb-5"></div>

            <!-- Essential Hidden Inputs to preserve integrity -->
            <input type="hidden" asp-for="InvoiceId" />
            <input type="hidden" asp-for="InvoiceNumber" />
            <input type="hidden" asp-for="InvoiceDate" />
            <input type="hidden" asp-for="Amount" />
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="TreatmentId" />

            <!-- 2-Column Grid Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <!-- Col 1: Discount Amount -->
                <div>
                    <label asp-for="Discount" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                        @T($"مبلغ الخصم ({currency})", $"Discount Amount ({currency})")
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-tag text-xs"></i>
                        </span>
                        <input asp-for="Discount" type="number" step="0.01" min="0" required
                               class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900 dark:text-slate-100 transition" />
                    </div>
                    <span asp-validation-for="Discount" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <!-- Col 2: Tax Amount -->
                <div>
                    <label asp-for="Tax" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                        @T($"مبلغ الضريبة ({currency})", $"Tax Amount ({currency})")
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-percent text-xs"></i>
                        </span>
                        <input asp-for="Tax" type="number" step="0.01" min="0" required
                               class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900 dark:text-slate-100 transition" />
                    </div>
                    <span asp-validation-for="Tax" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <!-- Full Width (spanning both cols): Payment Status dropdown -->
                <div class="sm:col-span-2">
                    <label asp-for="Status" class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                        @T("حالة الدفع والتحصيل", "Payment Status") <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-wallet text-xs"></i>
                        </span>
                        <select asp-for="Status" required
                                class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-slate-900 dark:text-slate-100 transition">
                            <option value="Unpaid">@T("غير مدفوع (معلّق)", "Unpaid (Pending)")</option>
                            <option value="Paid">@T("مدفوع (مُسدّد)", "Paid (Settled)")</option>
                        </select>
                    </div>
                    <span asp-validation-for="Status" class="text-rose-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <a asp-action="Index"
                   class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-5 py-2.5 rounded-lg text-sm font-medium transition cursor-pointer inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow-md inline-flex items-center gap-2 transition active:scale-95 cursor-pointer border-0">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>@T("حفظ التغييرات", "Save Changes")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}