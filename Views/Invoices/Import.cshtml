@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("استيراد بيانات الفواتير", "Bulk Import Invoices");
}

<div class="max-w-3xl mx-auto px-4 py-8" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back navigation link ── *@
    <div class="mb-5">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-medium text-[#727A76] dark:text-[#9CA8A3] hover:text-[#202725] dark:hover:text-[#EAEFEA] transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى سجل الفواتير", "Back to Invoices")</span>
        </a>
    </div>

    @* ── Main Import Card ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 sm:p-7 shadow-sm space-y-6">

        @* Header *@
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 border border-[#49665A]/20 flex items-center justify-center text-[#49665A] shrink-0">
                <i class="fa-solid fa-file-arrow-up text-base"></i>
            </div>
            <div>
                <h1 class="text-lg sm:text-xl font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0">
                    @T("استيراد الفواتير (Bulk Import)", "Bulk Import Invoices")
                </h1>
                <p class="text-xs text-[#6B7D75] dark:text-[#9CA8A3] m-0 mt-1">
                    @T("رفع ملف CSV لتسجيل الفواتير وحالات السداد دفعة واحدة في النظام", "Upload a CSV file to record multiple invoices and payment statuses at once")
                </p>
            </div>
        </div>

        @* ── Notification Alerts ── *@
        @if (TempData["Success"] != null)
        {
            <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-sm shrink-0"></i>
                <div><strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]</div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs flex items-center gap-2.5">
                <i class="fa-solid fa-circle-exclamation text-sm shrink-0"></i>
                <div><strong>@T("خطأ:", "Error:")</strong> @TempData["Error"]</div>
            </div>
        }

        @* ── Sample Template Card ── *@
        <div class="bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl p-4 sm:p-5 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
                    <i class="fa-solid fa-file-csv text-xl"></i>
                </div>
                <div>
                    <div class="text-[#1A2621] dark:text-[#EAEFEA] font-bold text-sm">@T("قالب الفواتير المعتمد", "Sample Invoices Template")</div>
                    <div class="text-[#6B7D75] dark:text-[#9CA8A3] text-xs mt-0.5">@T("تحميل ملف CSV جاهز يحتوي على الترويسات المطلوبة لعملية الاستيراد", "Download CSV template with required invoice headers")</div>
                </div>
            </div>
            <a asp-action="DownloadTemplate"
               class="px-3.5 py-2 bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#1B2421] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-semibold rounded-xl flex items-center gap-2 transition shrink-0">
                <i class="fa-solid fa-download text-xs"></i>
                <span>@T("تحميل القالب", "Download Template")</span>
            </a>
        </div>

        @* ── Required Columns Panel ── *@
        <div class="bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl p-4 text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
            <div class="flex items-center gap-2 mb-3">
                <i class="fa-solid fa-circle-info text-[#49665A]"></i>
                <span class="font-bold text-xs text-[#1A2621] dark:text-[#EAEFEA]">@T("الأعمدة المطلوبة في ملف الـ CSV:", "Required Columns in CSV:")</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#49665A] mt-0.5 text-[10px] shrink-0"></i>
                    <div>
                        <span class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold">InvoiceNumber:</span>
                        <span class="text-[#6B7D75] dark:text-[#9CA8A3]">@T("رقم الفاتورة (يتم إنشاؤه تلقائياً إن تُرِك فارغاً)", "Invoice Number (auto-generated if empty)")</span>
                    </div>
                </div>
                <div class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#49665A] mt-0.5 text-[10px] shrink-0"></i>
                    <div>
                        <span class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold">PatientNationalID:</span>
                        <span class="text-[#6B7D75] dark:text-[#9CA8A3]">@T("الرقم الوطني للمريض المسجل في النظام", "Registered Patient National ID")</span>
                    </div>
                </div>
                <div class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#49665A] mt-0.5 text-[10px] shrink-0"></i>
                    <div>
                        <span class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold">InvoiceDate:</span>
                        <span class="text-[#6B7D75] dark:text-[#9CA8A3]">@T("تاريخ الفاتورة بصيغة YYYY-MM-DD", "Invoice Date (YYYY-MM-DD)")</span>
                    </div>
                </div>
                <div class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#49665A] mt-0.5 text-[10px] shrink-0"></i>
                    <div>
                        <span class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold">Amount / NetAmount:</span>
                        <span class="text-[#6B7D75] dark:text-[#9CA8A3]">@T("المبالغ المالية وقيم الفاتورة", "Billing monetary amounts")</span>
                    </div>
                </div>
                <div class="flex items-start gap-2 sm:col-span-2">
                    <i class="fa-solid fa-check text-[#49665A] mt-0.5 text-[10px] shrink-0"></i>
                    <div>
                        <span class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold">Status:</span>
                        <span class="text-[#6B7D75] dark:text-[#9CA8A3]">@T("حالة الفاتورة (Paid أو Unpaid)", "Invoice Status (Paid or Unpaid)")</span>
                    </div>
                </div>
            </div>
        </div>

        @* ── Upload Form ── *@
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-2">
                    @T("اختر ملف الفواتير (CSV)", "Select Invoices CSV File") *
                </label>
                <div class="bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl p-4 text-center cursor-pointer hover:border-[#49665A] transition"
                     onclick="document.getElementById('invoiceFileInput').click()">
                    <i class="fa-solid fa-cloud-arrow-up text-2xl text-[#49665A] mb-2 block"></i>
                    <div class="text-xs font-bold text-[#1A2621] dark:text-[#EAEFEA]" id="fileSelectLabel">
                        @T("انقر لاختيار ملف CSV أو اسحبه هنا", "Click to choose CSV file or drag and drop")
                    </div>
                    <div class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] mt-1">
                        @T("يدعم فقط ملفات CSV (UTF-8)", "Supports only CSV files (UTF-8)")
                    </div>
                    <input type="file" id="invoiceFileInput" name="file" accept=".csv" class="hidden" required
                           onchange="document.getElementById('fileSelectLabel').textContent = this.files[0]?.name || '@T("انقر لاختيار ملف CSV", "Click to choose CSV file")'" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <a asp-action="Index"
                   class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
                    <i class="fa-solid fa-upload text-xs"></i>
                    <span>@T("بدء استيراد الفواتير", "Start Bulk Import")</span>
                </button>
            </div>
        </form>

    </div>
</div>
