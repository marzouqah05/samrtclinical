@model WebApplication1.Models.Invoice

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("حذف الفاتورة", "Delete Invoice");
}

<div class="container-fluid" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">
            <!-- كرت تأكيد الحذف -->
            <div class="card shadow-sm border-0 rounded-3 mt-4 border-top border-danger border-4">
                <div class="card-header bg-white border-bottom p-4 text-center">
                    <h3 class="text-danger fw-bold m-0">
                        <i class="fa-solid fa-triangle-exclamation @(_isAr ? "ms-2" : "me-2")"></i> @T("حذف الفاتورة", "Delete Invoice")
                    </h3>
                    <p class="text-muted m-0 mt-2">@T("هل أنت متأكد من حذف هذه الفاتورة؟ لا يمكن التراجع عن هذا الإجراء.", "Are you sure you want to delete this invoice? This action cannot be undone.")</p>
                </div>

                <div class="card-body p-4">
                    <!-- تفاصيل الفاتورة المراد حذفها -->
                    <div class="bg-light rounded-3 p-4 mb-4 border">
                        <div class="row g-3">
                            <div class="col-6">
                                <span class="text-muted d-block small">@T("رقم الفاتورة", "Invoice Number")</span>
                                <strong class="text-dark fs-5">#@Model.InvoiceNumber</strong>
                            </div>
                            <div class="col-6 @(_isAr ? "text-start" : "text-end")">
                                <span class="text-muted d-block small">@T("تاريخ الفاتورة", "Invoice Date")</span>
                                <strong class="text-dark">@Model.InvoiceDate.ToString("yyyy/MM/dd HH:mm")</strong>
                            </div>

                            <hr class="text-muted my-2" />

                            <div class="col-6">
                                <span class="text-muted d-block small">@T("اسم المريض", "Patient Name")</span>
                                <strong class="text-secondary">@Model.Patient?.PatientName</strong>
                            </div>
                            <div class="col-6 @(_isAr ? "text-start" : "text-end")">
                                <span class="text-muted d-block small">@T("المبلغ الصافي", "Net Amount")</span>
                                <strong class="text-primary fs-5">@Model.NetAmount.ToString("C2")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- نموذج الحذف والتأكيد -->
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="InvoiceId" />

                        <div class="d-flex gap-2 justify-content-end align-items-center">
                            <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5 text-decoration-none">
                                <i class="fa-solid fa-xmark text-xs"></i>
                                <span>@T("إلغاء، الإبقاء عليها", "Cancel, Keep It")</span>
                            </a>
                            <button type="submit" class="btn btn-danger px-4 rounded-3 fw-semibold shadow-sm">
                                <i class="fa-solid fa-trash @(_isAr ? "ms-2" : "me-2")"></i> @T("نعم، حذف نهائي", "Yes, Delete Permanently")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>