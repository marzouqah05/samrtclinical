@model WebApplication1.Models.Invoice
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("حذف الفاتورة", "Delete Invoice");

    var clinic = await SettingsService.GetSettingsAsync();
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
}

<div class="max-w-xl mx-auto my-12 px-4" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back Navigation Link ── *@
    <div class="mb-4 text-start">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى قائمة الفواتير", "Back to Invoices")</span>
        </a>
    </div>

    @* ── SaaS Card Container ── *@
    <div class="bg-white border border-slate-200 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-100 shadow-xl rounded-2xl p-6 text-center">

        @* ── Danger Header ── *@
        <div class="w-12 h-12 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center mx-auto mb-3">
            <i class="fa-solid fa-triangle-exclamation text-xl"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white m-0">
            @T("حذف الفاتورة", "Delete Invoice")
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 mb-0">
            @T("هل أنت متأكد من رغبتك في حذف هذه الفاتورة؟ لا يمكن التراجع عن هذا الإجراء.", "Are you sure you want to delete this invoice? This action cannot be undone.")
        </p>

        @* ── Invoice Details Card (Compact Summary) ── *@
        <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl p-4 my-6 space-y-2.5 text-start">
            <div class="flex items-center justify-between py-1 border-b border-slate-200/60 dark:border-slate-700/60">
                <span class="text-xs text-slate-500 dark:text-slate-400">@T("رقم الفاتورة", "Invoice Number")</span>
                <span class="text-sm font-bold text-slate-900 dark:text-white font-mono">#@Model.InvoiceNumber</span>
            </div>

            <div class="flex items-center justify-between py-1 border-b border-slate-200/60 dark:border-slate-700/60">
                <span class="text-xs text-slate-500 dark:text-slate-400">@T("تاريخ الفاتورة", "Invoice Date")</span>
                <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">@Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</span>
            </div>

            <div class="flex items-center justify-between py-1 border-b border-slate-200/60 dark:border-slate-700/60">
                <span class="text-xs text-slate-500 dark:text-slate-400">@T("اسم المريض", "Patient Name")</span>
                <span class="text-xs font-semibold text-slate-900 dark:text-white">@(Model.Patient?.PatientName ?? "—")</span>
            </div>

            <div class="flex items-center justify-between py-1 pt-1.5">
                <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">@T("المبلغ الصافي", "Net Amount")</span>
                <span class="text-base font-bold text-rose-600 dark:text-rose-400 font-mono">@Model.NetAmount.ToString("N2") @currency</span>
            </div>
        </div>

        @* ── Delete Confirmation Form ── *@
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InvoiceId" />

            <div class="flex items-center justify-end gap-3 pt-2">
                <a asp-action="Index"
                   class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-5 py-2.5 rounded-lg text-sm font-medium transition cursor-pointer inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء، الإبقاء عليها", "Cancel, Keep It")</span>
                </a>
                <button type="submit"
                        class="bg-rose-600 hover:bg-rose-500 text-white font-semibold px-5 py-2.5 rounded-lg text-sm shadow-md inline-flex items-center gap-2 transition active:scale-95 cursor-pointer border-0">
                    <i class="fa-solid fa-trash-can text-xs"></i>
                    <span>@T("نعم، حذف نهائي", "Yes, Delete Permanently")</span>
                </button>
            </div>
        </form>
    </div>
</div>