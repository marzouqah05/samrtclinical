@model WebApplication1.Models.Invoice
@inject WebApplication1.Services.ISettingsService SettingsService

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إنشاء فاتورة جديدة", "Create New Invoice");

    var clinic = await SettingsService.GetSettingsAsync();
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
}

<div class="max-w-3xl mx-auto px-4 py-8" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back Navigation Link ── *@
    <div class="mb-5">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى قائمة الفواتير", "Back to Invoices List")</span>
        </a>
    </div>

    @* ── Outer Card Wrapper ── *@
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl overflow-hidden text-start">

        @* ── Form Card Header ── *@
        <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-800/50 flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-file-invoice-dollar text-lg"></i>
            </div>
            <div>
                <h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 m-0">
                    @T("إنشاء فاتورة جديدة", "Create New Invoice")
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 m-0 mt-0.5">
                    @T("اختر الزيارة الطبية وحدّد الخصومات أو الضرائب. سيحسب النظام المبلغ الصافي تلقائياً.", "Select the medical visit and specify discounts or taxes. The system will calculate the net amount automatically.")
                </p>
            </div>
        </div>

        @* ── Form Inner Body ── *@
        <form asp-action="Create" method="post" class="p-6 sm:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 text-xs"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Full width: Medical Visit / Patient Selector -->
                <div class="md:col-span-2">
                    <label asp-for="TreatmentId" class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5 block">
                        @T("الزيارة الطبية / المريض", "Medical Visit / Patient") <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-hospital-user text-sm"></i>
                        </span>
                        <select asp-for="TreatmentId" asp-items="ViewBag.TreatmentId" required
                                class="w-full ps-10 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
                            <option value="" disabled selected>@T("اختر زيارة علاج المريض...", "Select patient treatment visit...")</option>
                        </select>
                    </div>
                    <span asp-validation-for="TreatmentId" class="text-rose-500 text-xs mt-1 block"></span>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1.5 m-0">
                        @T("سيقوم النظام تلقائياً بجلب رسوم الاستشارة وتكاليف العلاج لهذه الزيارة.", "The system will automatically fetch the consultation fees and treatment costs for this visit.")
                    </p>
                </div>

                <!-- Column 1: Discount Amount -->
                <div>
                    <label asp-for="Discount" class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5 block">
                        @T($"مبلغ الخصم ({currency})", $"Discount Amount ({currency})")
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-tag text-xs"></i>
                        </span>
                        <input asp-for="Discount" type="number" step="0.01" value="0.00" min="0" required
                               class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition" />
                    </div>
                    <span asp-validation-for="Discount" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <!-- Column 2: Tax Amount -->
                <div>
                    <label asp-for="Tax" class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5 block">
                        @T($"مبلغ الضريبة ({currency})", $"Tax Amount ({currency})")
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-percent text-xs"></i>
                        </span>
                        <input asp-for="Tax" type="number" step="0.01" value="0.00" min="0" required
                               class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition" />
                    </div>
                    <span asp-validation-for="Tax" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <!-- Column 1: Payment Status -->
                <div>
                    <label asp-for="Status" class="text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5 block">
                        @T("حالة الدفع", "Payment Status") <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-wallet text-xs"></i>
                        </span>
                        <select asp-for="Status" required
                                class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
                            <option value="Unpaid" selected>@T("غير مدفوع (معلّق)", "Unpaid (Pending)")</option>
                            <option value="Paid">@T("مدفوع (مُسدّد)", "Paid (Settled)")</option>
                        </select>
                    </div>
                    <span asp-validation-for="Status" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <!-- Column 2: Financial Calculation Note -->
                <div class="flex flex-col justify-end">
                    <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 bg-slate-50/60 dark:bg-slate-800/30 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-calculator text-xs"></i>
                        </div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                            <span class="font-semibold text-slate-700 dark:text-slate-200">@T("الحساب التلقائي:", "Automatic Calculation:")</span>
                            @T("الصافي = تكلفة العلاج - الخصم + الضريبة", "Net = Treatment Fees - Discount + Tax")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions Footer -->
            <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-200 dark:border-slate-800 mt-6">
                <a asp-action="Index" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-5 py-2.5 rounded-lg text-sm font-medium transition inline-flex items-center gap-1.5 text-decoration-none">
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow-md shadow-emerald-950/30 inline-flex items-center gap-2 transition active:scale-95 border-0 cursor-pointer">
                    <i class="fa-solid fa-receipt text-xs"></i>
                    <span>@T("إصدار الفاتورة", "Issue Invoice")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}