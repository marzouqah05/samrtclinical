@model IEnumerable<WebApplication1.Models.Invoice>
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Text.Json

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إدارة الفواتير", "Invoices Management");

    var clinicSettings = await SettingsService.GetSettingsAsync();
    var currency = !string.IsNullOrWhiteSpace(clinicSettings.CurrencySymbol) ? clinicSettings.CurrencySymbol : "JOD";

    List<string>? importErrors = null;
    if (TempData["ImportErrors"] != null)
    {
        try
        {
            importErrors = JsonSerializer.Deserialize<List<string>>(TempData["ImportErrors"]!.ToString()!);
        }
        catch { }
    }
}

<div class="max-w-7xl mx-auto px-4 py-8 space-y-6" dir="@(_isAr ? "rtl" : "ltr")">

    @* ─── Page Header & Action Buttons ─── *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-lg sm:text-xl font-bold text-[#202725] dark:text-[#EAEFEA] m-0 flex items-center gap-2.5">
                <i class="fa-solid fa-file-invoice-dollar text-[#49665A]"></i>
                <span>@T("إدارة الفواتير والمحاسبة", "Invoices & Billing Management")</span>
            </h1>
            <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0 mt-1">
                @T("عرض وطباعة وتحديث فواتير المرضى وحالات السداد واستيراد وتصدير البيانات", "View, print, and update patient invoices, billing status, and bulk data files")
            </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <!-- 📥 Import Invoices Button -->
            <button type="button" class="inline-flex items-center gap-2 px-3.5 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700 transition shadow-sm cursor-pointer"
                    onclick="openImportInvoicesModal()"
                    title="@T("استيراد فواتير من CSV", "Bulk import invoices from CSV")">
                <i class="fa-solid fa-file-import text-emerald-600 dark:text-emerald-400 text-xs"></i>
                <span>@T("استيراد فواتير", "Import Invoices")</span>
            </button>

            <!-- 📤 Export to CSV Button -->
            <a asp-action="Export"
               class="inline-flex items-center gap-2 px-3.5 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700 transition shadow-sm"
               title="@T("تصدير جميع الفواتير إلى CSV", "Export all invoices to CSV")">
                <i class="fa-solid fa-file-excel text-emerald-500 text-xs"></i>
                <span>@T("تصدير CSV", "Export to CSV")</span>
            </a>

            <!-- ➕ Create New Invoice Button (Modal Trigger) -->
            <button type="button"
                    onclick="openCreateInvoiceModal()"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-xl transition shadow-sm cursor-pointer border-0">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>@T("إنشاء فاتورة جديدة", "Create New Invoice")</span>
            </button>
        </div>
    </div>

    @* ─── Notification Alerts ─── *@
    @if (TempData["Success"] != null)
    {
        <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-sm shrink-0"></i>
                <div><strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]</div>
            </div>
            <button type="button" class="text-emerald-600 dark:text-emerald-400 hover:opacity-75 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-triangle-exclamation text-sm shrink-0"></i>
                <div><strong>@T("تنبيه:", "Notice:")</strong> @TempData["Warning"]</div>
            </div>
            <button type="button" class="text-amber-600 dark:text-amber-400 hover:opacity-75 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-exclamation text-sm shrink-0"></i>
                <div><strong>@T("خطأ:", "Error:")</strong> @TempData["Error"]</div>
            </div>
            <button type="button" class="text-rose-600 dark:text-rose-400 hover:opacity-75 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @* ─── Detailed Import Error Log (if any rows were skipped) ─── *@
    @if (importErrors != null && importErrors.Any())
    {
        <div class="bg-white dark:bg-[#1B2421] border border-amber-500/30 rounded-2xl p-4 shadow-sm">
            <div class="flex justify-between items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#invoiceImportErrorsCollapse">
                <div class="font-bold text-xs text-[#1A2621] dark:text-[#EAEFEA] flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-amber-500"></i>
                    <span>@T("تفاصيل الصفوف المستبعدة أثناء استيراد الفواتير", "Details of Skipped Rows During Import") (@importErrors.Count)</span>
                </div>
                <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] flex items-center gap-1">
                    @T("اضغط للتفاصيل", "Click to view") <i class="fa-solid fa-chevron-down text-[10px]"></i>
                </span>
            </div>
            <div class="collapse mt-3" id="invoiceImportErrorsCollapse">
                <ul class="space-y-1.5 text-xs text-rose-500 dark:text-rose-400 max-h-56 overflow-y-auto pt-2 border-t border-[#E5E9E7] dark:border-[#2B3833]">
                    @foreach (var err in importErrors)
                    {
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-circle-xmark text-xs mt-0.5 shrink-0"></i>
                            <span>@err</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @* ─── Invoices Table Card ─── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs">
                <thead class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[11px] uppercase tracking-wider text-[#5C6E66] dark:text-[#9CA8A3] font-semibold">
                    <tr>
                        <th class="py-3 px-4 text-start">@T("رقم الفاتورة", "Invoice No.")</th>
                        <th class="py-3 px-4 text-start">@T("التاريخ", "Date")</th>
                        <th class="py-3 px-4 text-start">@T("المريض", "Patient")</th>
                        <th class="py-3 px-4 text-start">@T("الطبيب", "Doctor")</th>
                        <th class="py-3 px-4 text-start">@T("المبلغ الإجمالي", "Gross Amount")</th>
                        <th class="py-3 px-4 text-start">@T("الصافي", "Net Amount")</th>
                        <th class="py-3 px-4 text-center">@T("الحالة", "Status")</th>
                        <th class="py-3 px-4 text-end">@T("الإجراءات", "Actions")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E5E9E7] dark:divide-[#2B3833]">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-[#6B7D75] dark:text-[#9CA8A3]">
                                <i class="fa-solid fa-receipt text-3xl d-block mb-3 opacity-40"></i>
                                <span>@T("لا توجد فواتير مُصدَرة حتى الآن.", "No invoices have been issued yet.")</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                @* Invoice Number *@
                                <td class="py-3.5 px-4 font-bold text-[#1A2621] dark:text-[#EAEFEA]">
                                    <span class="text-[#6B7D75] dark:text-[#9CA8A3] me-0.5">#</span>@item.InvoiceNumber
                                </td>

                                @* Date *@
                                <td class="py-3.5 px-4 text-[#6B7D75] dark:text-[#9CA8A3] whitespace-nowrap">
                                    @item.InvoiceDate.ToString("yyyy-MM-dd")
                                </td>

                                @* Patient Name *@
                                <td class="py-3.5 px-4 font-semibold text-[#1A2621] dark:text-[#EAEFEA]">
                                    @item.Patient?.PatientName
                                </td>

                                @* Doctor Name *@
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
                                        <i class="fa-solid fa-user-doctor text-[#49665A] text-[11px]"></i>
                                        <span class="text-[#1A2621] dark:text-[#EAEFEA]">Dr. @(item.Treatment?.Appointment?.Doctor?.DoctorName ?? "—")</span>
                                    </span>
                                </td>

                                @* Gross Amount *@
                                <td class="py-3.5 px-4 text-[#6B7D75] dark:text-[#9CA8A3] whitespace-nowrap">
                                    @item.Amount.ToString("N2") @currency
                                </td>

                                @* Net Amount *@
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="font-bold text-emerald-600 dark:text-emerald-400">@item.NetAmount.ToString("N2") @currency</span>
                                </td>

                                @* Status Badge *@
                                <td class="py-3.5 px-4 text-center whitespace-nowrap">
                                    @if (item.Status == "Paid")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[11px] font-semibold">
                                            <i class="fa-solid fa-circle-check text-[10px]"></i>
                                            <span>@T("مدفوع", "Paid")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-[11px] font-semibold">
                                            <i class="fa-solid fa-circle-xmark text-[10px]"></i>
                                            <span>@T("غير مدفوع", "Unpaid")</span>
                                        </span>
                                    }
                                </td>

                                @* Action Buttons *@
                                <td class="py-3.5 px-4 text-end whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a asp-action="Print" asp-route-id="@item.InvoiceId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-white"
                                           title="@T("طباعة", "Print")">
                                            <i class="fa-solid fa-print text-[10px]"></i>
                                            <span>@T("طباعة", "Print")</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.InvoiceId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm bg-white border border-slate-200 text-emerald-600 hover:bg-emerald-50 hover:text-emerald-700 dark:bg-slate-800 dark:border-slate-700 dark:text-emerald-400 dark:hover:bg-slate-700"
                                           title="@T("تحصيل", "Collect")">
                                            <i class="fa-solid fa-pen-to-square text-[10px]"></i>
                                            <span>@T("تحصيل", "Collect")</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.InvoiceId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 hover:text-rose-700 dark:bg-rose-950/40 dark:border-rose-900/50 dark:text-rose-400 dark:hover:bg-rose-900/60 dark:hover:text-rose-200"
                                           title="@T("حذف", "Delete")">
                                            <i class="fa-solid fa-trash-can text-[10px]"></i>
                                            <span>@T("حذف", "Delete")</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── 🧾 Create New Invoice Modal (Matching Add New Expense Pattern - Standalone Popup Modal) ─── *@
<div id="createInvoiceModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto hidden" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="max-w-xl sm:max-w-2xl w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100 shadow-2xl rounded-2xl p-6 overflow-hidden text-start my-auto relative" onclick="event.stopPropagation()">
        
        <!-- Modal Header -->
        <div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800 mb-5">
            <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-file-invoice-dollar text-lg"></i>
                </div>
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 m-0" id="createInvoiceModalLabel">
                        @T("إنشاء فاتورة جديدة", "Create New Invoice")
                    </h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 m-0 mt-0.5">
                        @T("اختر الزيارة الطبية وحدّد الخصومات أو الضرائب لإصدار الفاتورة", "Select medical visit and set billing parameters to issue invoice")
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeCreateInvoiceModal()" class="w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center text-sm transition-colors border-0 bg-transparent cursor-pointer" aria-label="Close">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Modal Form -->
        <form asp-action="Create" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <!-- Full Width: Medical Visit / Patient Selector dropdown -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                    @T("الزيارة الطبية / المريض", "Medical Visit / Patient") <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                        <i class="fa-solid fa-hospital-user text-sm"></i>
                    </span>
                    <select name="TreatmentId" asp-items="ViewBag.TreatmentId" required
                            class="w-full ps-10 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
                        <option value="" disabled selected>@T("اختر زيارة علاج المريض...", "Select patient treatment visit...")</option>
                    </select>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 m-0">
                    @T("يتم جلب رسوم الطبيب وتكاليف العلاج وحساب الصافي تلقائياً.", "Consultation fees and treatment costs are calculated automatically.")
                </p>
            </div>

            <!-- Row 1 (2-Column Grid): Discount Amount | Tax Amount -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                        @T($"مبلغ الخصم ({currency})", $"Discount Amount ({currency})")
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-tag text-xs"></i>
                        </span>
                        <input type="number" name="Discount" step="0.01" value="0.00" min="0" required
                               class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                        @T($"مبلغ الضريبة ({currency})", $"Tax Amount ({currency})")
                    </label>
                    <div class="relative">
                        <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                            <i class="fa-solid fa-percent text-xs"></i>
                        </span>
                        <input type="number" name="Tax" step="0.01" value="0.00" min="0" required
                               class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition" />
                    </div>
                </div>
            </div>

            <!-- Row 2: Payment Status dropdown (Paid, Unpaid / Pending) -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-200 mb-1.5">
                    @T("حالة الدفع", "Payment Status") <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                        <i class="fa-solid fa-wallet text-xs"></i>
                    </span>
                    <select name="Status" required
                            class="w-full ps-9 pe-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition">
                        <option value="Unpaid" selected>@T("غير مدفوع (معلّق)", "Unpaid / Pending")</option>
                        <option value="Paid">@T("مدفوع", "Paid")</option>
                    </select>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800 mt-5">
                <button type="button" onclick="closeCreateInvoiceModal()" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-4 py-2.5 rounded-lg text-sm font-medium transition cursor-pointer">
                    @T("إلغاء", "Cancel")
                </button>
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-5 py-2.5 rounded-lg text-sm shadow-sm inline-flex items-center gap-2 transition active:scale-95 cursor-pointer border-0">
                    <i class="fa-solid fa-receipt text-xs"></i>
                    <span>@T("إصدار الفاتورة", "Issue Invoice")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@* ─── 📥 Import Invoices Modal (Pure English Modern SaaS - Standalone Popup Modal) ─── *@
<div id="importInvoicesModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto hidden" dir="ltr">
    <div class="max-w-2xl sm:max-w-3xl w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl rounded-2xl p-6 sm:p-7 text-slate-900 dark:text-slate-100 overflow-hidden text-start my-auto relative" onclick="event.stopPropagation()">
        
        <!-- Header -->
        <div class="flex items-start justify-between gap-4 mb-6">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                </div>
                <div>
                    <h5 class="text-slate-900 dark:text-white font-bold text-lg m-0" id="importInvoicesModalLabel">
                        Bulk Import Invoices
                    </h5>
                    <p class="text-slate-500 dark:text-slate-400 font-normal text-xs sm:text-sm m-0 mt-0.5">
                        Upload CSV or Excel file to record multiple billing entries at once
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeImportInvoicesModal()" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border-0 bg-transparent cursor-pointer" aria-label="Close">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form method="post" enctype="multipart/form-data" asp-controller="Invoices" asp-action="Import">
            @Html.AntiForgeryToken()

            <!-- Template Card -->
            <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 rounded-xl p-3.5 flex items-center justify-between gap-3 mb-5">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold font-mono text-xs">
                        CSV
                    </div>
                    <div class="min-w-0">
                        <div class="text-slate-900 dark:text-slate-100 font-semibold text-xs sm:text-sm truncate">
                            Invoices Ready Template
                        </div>
                        <div class="text-slate-500 dark:text-slate-400 font-normal text-xs mt-0.5 truncate">
                            Download blank template with formatted columns
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("DownloadTemplate", "Invoices")" class="bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-50 dark:hover:bg-slate-700 text-xs font-semibold px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 transition shrink-0">
                    <i class="fa-solid fa-download text-xs"></i>
                    <span>Download Template</span>
                </a>
            </div>

            <!-- Modern Dropzone Component -->
            <div class="mb-5">
                <div id="invoiceDropzone"
                     class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-500 rounded-xl p-7 text-center cursor-pointer transition bg-slate-50/60 dark:bg-slate-800/30 group">
                    
                    <input type="file" id="invoiceFileInput" name="file" class="hidden" accept=".csv, .xlsx, .xls" required onchange="handleInvoiceFileSelected(this)" />
                    
                    <!-- Empty / Prompt State -->
                    <div id="invoiceDropzonePrompt" class="py-2">
                        <div class="w-10 h-10 mx-auto mb-2.5 rounded-full bg-slate-100 dark:bg-slate-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/50 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 flex items-center justify-center transition">
                            <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                        </div>
                        <p class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                            <span class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">Click to browse</span>
                            or drag and drop your file here
                        </p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 m-0">
                            Supported formats: .csv, .xlsx
                        </p>
                    </div>

                    <!-- Selected File State -->
                    <div id="invoiceDropzoneFileSelected" class="hidden flex items-center justify-between p-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-start shadow-sm">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-9 h-9 rounded-lg bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-file-csv text-base"></i>
                            </div>
                            <div class="min-w-0">
                                <p id="invoiceSelectedFileName" class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 truncate m-0"></p>
                                <p id="invoiceSelectedFileSize" class="text-[11px] text-slate-500 dark:text-slate-400 m-0 mt-0.5"></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button" onclick="event.stopPropagation(); document.getElementById('invoiceFileInput').click();" class="px-2.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors border-0 bg-transparent cursor-pointer">
                                Change
                            </button>
                            <button type="button" onclick="event.stopPropagation(); removeInvoiceSelectedFile();" class="p-1.5 text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors border-0 bg-transparent cursor-pointer" title="Remove file">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Required Specifications as Modern Badges -->
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/50 p-4 mb-6">
                <div class="flex items-center gap-2 mb-2.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">
                        Required Columns Specifications:
                    </span>
                </div>
                <div class="flex flex-wrap gap-2">
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">InvoiceNumber:</span>
                        <span class="text-[11px] opacity-75">(Optional/Auto-generated)</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">PatientNationalID:</span>
                        <span class="text-[11px] opacity-75">Required (10 digits)</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">InvoiceDate:</span>
                        <span class="text-[11px] opacity-75">YYYY-MM-DD</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">Amount / NetAmount:</span>
                        <span class="text-[11px] opacity-75">Numeric (JD)</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-slate-600 dark:text-slate-400">Status:</span>
                        <span class="text-[11px] opacity-75">Paid or Unpaid</span>
                    </div>
                </div>
            </div>

            <!-- Modal Actions Footer -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                <button type="button" onclick="closeImportInvoicesModal()" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-4 py-2.5 rounded-lg text-sm transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-5 py-2.5 rounded-lg text-sm shadow-sm inline-flex items-center gap-2 transition active:scale-95 border-0 cursor-pointer">
                    <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                    <span>Start Import</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateInvoiceModal() {
            const modal = document.getElementById('createInvoiceModal');
            if (modal) {
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeCreateInvoiceModal() {
            const modal = document.getElementById('createInvoiceModal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        function openImportInvoicesModal() {
            const modal = document.getElementById('importInvoicesModal');
            if (modal) {
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeImportInvoicesModal() {
            const modal = document.getElementById('importInvoicesModal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const invoiceModal = document.getElementById('createInvoiceModal');
            if (invoiceModal) {
                invoiceModal.addEventListener('click', function (e) {
                    if (e.target === this) {
                        closeCreateInvoiceModal();
                    }
                });
            }

            const importModal = document.getElementById('importInvoicesModal');
            if (importModal) {
                importModal.addEventListener('click', function (e) {
                    if (e.target === this) {
                        closeImportInvoicesModal();
                    }
                });
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeCreateInvoiceModal();
                    closeImportInvoicesModal();
                }
            });

            const dropzone = document.getElementById('invoiceDropzone');
            const fileInput = document.getElementById('invoiceFileInput');

            if (dropzone && fileInput) {
                dropzone.addEventListener('click', function (e) {
                    if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                        fileInput.click();
                    }
                });

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                dropzone.addEventListener('drop', function (e) {
                    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        handleInvoiceFileSelected(fileInput);
                    }
                });
            }
        });

        function handleInvoiceFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const nameEl = document.getElementById('invoiceSelectedFileName');
                const sizeEl = document.getElementById('invoiceSelectedFileSize');
                const promptEl = document.getElementById('invoiceDropzonePrompt');
                const selectedEl = document.getElementById('invoiceDropzoneFileSelected');

                if (nameEl) nameEl.textContent = file.name;
                if (sizeEl) {
                    const sizeKb = (file.size / 1024).toFixed(1);
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                    sizeEl.textContent = file.size > 1024 * 1024 ? `${sizeMb} MB` : `${sizeKb} KB`;
                }

                if (promptEl) promptEl.classList.add('hidden');
                if (selectedEl) {
                    selectedEl.classList.remove('hidden');
                    selectedEl.classList.add('flex');
                }
            }
        }

        function removeInvoiceSelectedFile() {
            const fileInput = document.getElementById('invoiceFileInput');
            const promptEl = document.getElementById('invoiceDropzonePrompt');
            const selectedEl = document.getElementById('invoiceDropzoneFileSelected');

            if (fileInput) fileInput.value = '';
            if (promptEl) promptEl.classList.remove('hidden');
            if (selectedEl) {
                selectedEl.classList.add('hidden');
                selectedEl.classList.remove('flex');
            }
        }
    </script>
}