@model IEnumerable<WebApplication1.Models.Invoice>
@using System.Text.Json

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إدارة الفواتير", "Invoices Management");

    List<string>? importErrors = null;
    if (TempData["ImportErrors"] != null)
    {
        try
        {
            importErrors = JsonSerializer.Deserialize<List<string>>(TempData["ImportErrors"]!.ToString()!);
        }
        catch { }
    }
}

<div class="max-w-7xl mx-auto px-4 py-8 space-y-6" dir="@(_isAr ? "rtl" : "ltr")">

    @* ─── Page Header & Action Buttons ─── *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-lg sm:text-xl font-bold text-[#202725] dark:text-[#EAEFEA] m-0 flex items-center gap-2.5">
                <i class="fa-solid fa-file-invoice-dollar text-[#49665A]"></i>
                <span>@T("إدارة الفواتير والمحاسبة", "Invoices & Billing Management")</span>
            </h1>
            <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0 mt-1">
                @T("عرض وطباعة وتحديث فواتير المرضى وحالات السداد واستيراد وتصدير البيانات", "View, print, and update patient invoices, billing status, and bulk data files")
            </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <!-- 📥 Import Invoices Button -->
            <button type="button" class="bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-sm"
                    data-bs-toggle="modal" data-bs-target="#importInvoicesModal"
                    title="@T("استيراد فواتير من CSV", "Bulk import invoices from CSV")">
                <i class="fa-solid fa-file-import text-[#49665A]"></i>
                <span>@T("استيراد فواتير", "Import Invoices")</span>
            </button>

            <!-- 📤 Export to CSV Button -->
            <a asp-action="Export"
               class="bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-sm"
               title="@T("تصدير جميع الفواتير إلى CSV", "Export all invoices to CSV")">
                <i class="fa-solid fa-file-excel text-emerald-500"></i>
                <span>@T("تصدير CSV", "Export to CSV")</span>
            </a>

            <!-- ➕ Create New Invoice Button -->
            <a asp-action="Create"
               class="px-4 py-2 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl transition flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>@T("إنشاء فاتورة جديدة", "Create New Invoice")</span>
            </a>
        </div>
    </div>

    @* ─── Notification Alerts ─── *@
    @if (TempData["Success"] != null)
    {
        <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-sm shrink-0"></i>
                <div><strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]</div>
            </div>
            <button type="button" class="text-emerald-600 dark:text-emerald-400 hover:opacity-75 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-triangle-exclamation text-sm shrink-0"></i>
                <div><strong>@T("تنبيه:", "Notice:")</strong> @TempData["Warning"]</div>
            </div>
            <button type="button" class="text-amber-600 dark:text-amber-400 hover:opacity-75 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-exclamation text-sm shrink-0"></i>
                <div><strong>@T("خطأ:", "Error:")</strong> @TempData["Error"]</div>
            </div>
            <button type="button" class="text-rose-600 dark:text-rose-400 hover:opacity-75 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @* ─── Detailed Import Error Log (if any rows were skipped) ─── *@
    @if (importErrors != null && importErrors.Any())
    {
        <div class="bg-white dark:bg-[#1B2421] border border-amber-500/30 rounded-2xl p-4 shadow-sm">
            <div class="flex justify-between items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#invoiceImportErrorsCollapse">
                <div class="font-bold text-xs text-[#1A2621] dark:text-[#EAEFEA] flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-amber-500"></i>
                    <span>@T("تفاصيل الصفوف المستبعدة أثناء استيراد الفواتير", "Details of Skipped Rows During Import") (@importErrors.Count)</span>
                </div>
                <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] flex items-center gap-1">
                    @T("اضغط للتفاصيل", "Click to view") <i class="fa-solid fa-chevron-down text-[10px]"></i>
                </span>
            </div>
            <div class="collapse mt-3" id="invoiceImportErrorsCollapse">
                <ul class="space-y-1.5 text-xs text-rose-500 dark:text-rose-400 max-h-56 overflow-y-auto pt-2 border-t border-[#E5E9E7] dark:border-[#2B3833]">
                    @foreach (var err in importErrors)
                    {
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-circle-xmark text-xs mt-0.5 shrink-0"></i>
                            <span>@err</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @* ─── Invoices Table Card ─── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs">
                <thead class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[11px] uppercase tracking-wider text-[#5C6E66] dark:text-[#9CA8A3] font-semibold">
                    <tr>
                        <th class="py-3 px-4 text-start">@T("رقم الفاتورة", "Invoice No.")</th>
                        <th class="py-3 px-4 text-start">@T("التاريخ", "Date")</th>
                        <th class="py-3 px-4 text-start">@T("المريض", "Patient")</th>
                        <th class="py-3 px-4 text-start">@T("الطبيب", "Doctor")</th>
                        <th class="py-3 px-4 text-start">@T("المبلغ الإجمالي", "Gross Amount")</th>
                        <th class="py-3 px-4 text-start">@T("الصافي", "Net Amount")</th>
                        <th class="py-3 px-4 text-center">@T("الحالة", "Status")</th>
                        <th class="py-3 px-4 text-end">@T("الإجراءات", "Actions")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E5E9E7] dark:divide-[#2B3833]">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-[#6B7D75] dark:text-[#9CA8A3]">
                                <i class="fa-solid fa-receipt text-3xl d-block mb-3 opacity-40"></i>
                                <span>@T("لا توجد فواتير مُصدَرة حتى الآن.", "No invoices have been issued yet.")</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                @* Invoice Number *@
                                <td class="py-3.5 px-4 font-bold text-[#1A2621] dark:text-[#EAEFEA]">
                                    <span class="text-[#6B7D75] dark:text-[#9CA8A3] me-0.5">#</span>@item.InvoiceNumber
                                </td>

                                @* Date *@
                                <td class="py-3.5 px-4 text-[#6B7D75] dark:text-[#9CA8A3] whitespace-nowrap">
                                    @item.InvoiceDate.ToString("yyyy-MM-dd")
                                </td>

                                @* Patient Name *@
                                <td class="py-3.5 px-4 font-semibold text-[#1A2621] dark:text-[#EAEFEA]">
                                    @item.Patient?.PatientName
                                </td>

                                @* Doctor Name *@
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
                                        <i class="fa-solid fa-user-doctor text-[#49665A] text-[11px]"></i>
                                        <span class="text-[#1A2621] dark:text-[#EAEFEA]">Dr. @(item.Treatment?.Appointment?.Doctor?.DoctorName ?? "—")</span>
                                    </span>
                                </td>

                                @* Gross Amount *@
                                <td class="py-3.5 px-4 text-[#6B7D75] dark:text-[#9CA8A3] whitespace-nowrap">
                                    @item.Amount.ToString("N2") JOD
                                </td>

                                @* Net Amount *@
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="font-bold text-emerald-600 dark:text-emerald-400">@item.NetAmount.ToString("N2") JOD</span>
                                </td>

                                @* Status Badge *@
                                <td class="py-3.5 px-4 text-center whitespace-nowrap">
                                    @if (item.Status == "Paid")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[11px] font-semibold">
                                            <i class="fa-solid fa-circle-check text-[10px]"></i>
                                            <span>@T("مدفوع", "Paid")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-[11px] font-semibold">
                                            <i class="fa-solid fa-circle-xmark text-[10px]"></i>
                                            <span>@T("غير مدفوع", "Unpaid")</span>
                                        </span>
                                    }
                                </td>

                                @* Action Buttons *@
                                <td class="py-3.5 px-4 text-end whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Print" asp-route-id="@item.InvoiceId"
                                           class="px-2.5 py-1 rounded-lg text-xs bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] transition flex items-center gap-1"
                                           title="@T("طباعة", "Print")">
                                            <i class="fa-solid fa-print text-[10px] text-[#6B7D75] dark:text-[#9CA8A3]"></i>
                                            <span>@T("طباعة", "Print")</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.InvoiceId"
                                           class="px-2.5 py-1 rounded-lg text-xs bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] transition flex items-center gap-1"
                                           title="@T("تحصيل", "Collect")">
                                            <i class="fa-solid fa-pen-to-square text-[10px] text-[#49665A]"></i>
                                            <span>@T("تحصيل", "Collect")</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.InvoiceId"
                                           class="w-7 h-7 flex items-center justify-center rounded-lg border border-rose-300 dark:border-rose-500/30 text-rose-500 hover:bg-rose-500/10 text-xs transition"
                                           title="@T("حذف", "Delete")">
                                            <i class="fa-solid fa-trash-can text-[10px]"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── 📥 Import Invoices Modal ─── *@
<div class="modal fade" id="importInvoicesModal" tabindex="-1" aria-labelledby="importInvoicesModalLabel" aria-hidden="true" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 p-3 bg-body">
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-start w-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px;">
                        <i class="bi bi-cloud-arrow-up-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="text-body fw-bold mb-0" id="importInvoicesModalLabel">
                            @T("استيراد الفواتير (Bulk Import)", "Bulk Import Invoices")
                        </h5>
                        <span class="text-body-secondary small">
                            @T("رفع ملف CSV أو Excel لتسجيل البيانات دفعة واحدة", "Upload CSV or Excel file to record multiple records at once")
                        </span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Import" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3">
                    <!-- Section 1: Template Download Card -->
                    <div class="card border border-secondary-subtle rounded-3 p-3 bg-body-tertiary mb-3 shadow-none">
                        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                            <!-- Right Side (Text & Icon) -->
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-success bg-opacity-10 text-success rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                    <i class="bi bi-file-earmark-excel-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-body fw-bold small">@T("قالب الفواتير الجاهز", "Invoices Ready Template")</div>
                                    <div class="text-body-secondary" style="font-size: 0.8rem;">@T("تحميل ملف CSV بالأعمدة المطلوبة", "Download CSV template with required columns")</div>
                                </div>
                            </div>
                            <!-- Left Side (Download Button) -->
                            <div class="flex-shrink-0">
                                <a href="@Url.Action("DownloadTemplate")" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill fw-medium d-inline-flex align-items-center gap-1 shadow-sm">
                                    <i class="bi bi-download text-success"></i>
                                    <span>@T("تحميل القالب", "Download Template")</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: File Input Field -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-body mb-1">
                            * @T("اختر ملف CSV أو Excel", "Select CSV or Excel file")
                        </label>
                        <input type="file" name="file" class="form-control form-control-lg fs-6 rounded-3 bg-body text-body border-secondary-subtle py-2 px-3" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" required />
                    </div>

                    <!-- Section 3: Required Columns Guide Box -->
                    <div class="rounded-3 p-3 mb-4 border border-secondary-subtle bg-body-tertiary">
                        <div class="d-flex align-items-center gap-2 mb-2 text-body fw-bold small">
                            <i class="bi bi-info-circle-fill text-secondary"></i>
                            <span>@T("الأعمدة المطلوبة في الملف:", "Required Columns in File:")</span>
                        </div>
                        <div class="row g-2 text-body-secondary small">
                            <div class="col-md-6">
                                <span class="text-body fw-semibold">InvoiceNumber:</span> @T("رقم الفاتورة (تلقائي إن تُرِك فارغاً)", "Invoice # (auto-generated if blank)")
                            </div>
                            <div class="col-md-6">
                                <span class="text-body fw-semibold">PatientNationalID:</span> @T("الرقم الوطني للمريض", "Patient National ID")
                            </div>
                            <div class="col-md-6">
                                <span class="text-body fw-semibold">InvoiceDate:</span> @T("تاريخ الفاتورة (YYYY-MM-DD)", "Date (YYYY-MM-DD)")
                            </div>
                            <div class="col-md-6">
                                <span class="text-body fw-semibold">Amount / NetAmount:</span> @T("المبالغ المالية", "Billing monetary values")
                            </div>
                            <div class="col-md-12">
                                <span class="text-body fw-semibold">Status:</span> @T("حالة الفاتورة (Paid أو Unpaid)", "Invoice Status (Paid or Unpaid)")
                            </div>
                        </div>
                    </div>

                    <!-- Section 4: Modal Footer Actions -->
                    <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top border-secondary-subtle mt-3">
                        <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill" data-bs-dismiss="modal">
                            @T("إلغاء", "Cancel")
                        </button>
                        <button type="submit" class="btn btn-success px-4 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span>@T("بدء الاستيراد", "Start Import")</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>