@using System.Globalization
@{
    Layout = null;
    var _culture = CultureInfo.CurrentCulture;
    var _isRtl   = _culture.TextInfo.IsRightToLeft;
    var _lang    = _culture.TwoLetterISOLanguageName;
    var _isAr    = _lang == "ar";
    Func<string, string, string> T = (ar, en) => _isAr ? ar : en;

    var email = ViewBag.Email as string ?? "";
}
<!DOCTYPE html>
<html lang="@_lang" dir="@(_isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T("تفعيل الحساب برمز التحقق (OTP) | ClinicFlow SaaS", "Verify Email OTP - ClinicFlow Medical OS")</title>
    
    <!-- Google Fonts: IBM Plex Sans Arabic & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --font-family: 'IBM Plex Sans Arabic', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            --emerald-900: #064e3b;
            --emerald-800: #065f46;
            --emerald-700: #047857;
            --emerald-600: #059669;
            --emerald-500: #10b981;
            --emerald-100: #d1fae5;
            --emerald-50:  #ecfdf5;
            --whatsapp-green: #25D366;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --bg-body: #f8fafc;
        }

        body {
            font-family: var(--font-family) !important;
            background-color: var(--bg-body);
            color: var(--text-dark);
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            -webkit-font-smoothing: antialiased;
            background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
            background-size: 24px 24px;
        }

        .otp-container {
            width: 100%;
            max-width: 520px;
        }

        .otp-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08), 0 0 1px 1px rgba(0, 0, 0, 0.04);
            border: 1px solid var(--border-color);
            padding: 40px 36px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .otp-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, #059669, #10b981, #34d399);
        }

        .otp-icon-badge {
            width: 76px;
            height: 76px;
            border-radius: 20px;
            background-color: var(--emerald-50);
            color: var(--emerald-600);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin-bottom: 24px;
            border: 1px solid rgba(16, 185, 129, 0.25);
            box-shadow: 0 8px 16px -4px rgba(16, 185, 129, 0.15);
        }

        .otp-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .otp-subtitle {
            color: var(--text-muted);
            font-size: 14.5px;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .email-highlight {
            color: var(--emerald-700);
            font-weight: 700;
            background-color: var(--emerald-50);
            padding: 3px 10px;
            border-radius: 8px;
            display: inline-block;
            direction: ltr;
        }

        /* 6 Digits Code Input Box */
        .otp-input-field {
            font-family: 'Inter', monospace;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: 12px;
            text-align: center;
            height: 64px;
            border-radius: 16px;
            border: 2px solid var(--border-color);
            background: #f8fafc;
            color: var(--emerald-900);
            transition: all 0.2s ease;
            width: 100%;
            outline: none;
            padding-left: 20px;
            padding-right: 20px;
        }

        .otp-input-field:focus {
            border-color: var(--emerald-600);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
        }

        .btn-verify {
            width: 100%;
            height: 52px;
            border-radius: 50px;
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 16px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 10px 20px -5px rgba(5, 150, 105, 0.35);
            transition: all 0.2s ease;
            margin-top: 24px;
            cursor: pointer;
        }

        .btn-verify:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 24px -5px rgba(5, 150, 105, 0.45);
            color: #ffffff;
        }

        .resend-box {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13.5px;
            color: var(--text-muted);
        }

        .btn-resend {
            background: none;
            border: none;
            color: var(--emerald-600);
            font-weight: 700;
            cursor: pointer;
            padding: 0;
            text-decoration: underline;
            font-size: 13.5px;
        }

        .btn-resend:hover {
            color: var(--emerald-800);
        }

        .floating-wa-btn {
            position: fixed;
            bottom: 24px;
            inset-inline-end: 24px;
            background-color: var(--whatsapp-green);
            color: #ffffff !important;
            padding: 12px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
            transition: all 0.25s ease;
            z-index: 1000;
        }

        .floating-wa-btn:hover {
            background-color: #1da851;
            transform: translateY(-3px) scale(1.03);
            color: #ffffff !important;
        }
    </style>
</head>
<body>

    <div class="otp-container">
        <div class="otp-card">
            
            <!-- Icon Badge -->
            <div class="otp-icon-badge">
                <i class="bi bi-shield-check"></i>
            </div>

            <!-- Title & Subtitle -->
            <h1 class="otp-title">@T("تأكيد البريد الإلكتروني", "Verify Your Email")</h1>
            <p class="otp-subtitle">
                @T("أدخل رمز التحقق (OTP) المكون من 6 أرقام المرسل إلى:", "Enter the 6-digit verification code (OTP) sent to:")<br />
                <span class="email-highlight mt-1">@email</span>
            </p>

            <!-- Alerts -->
            @if (TempData["DevOtp"] != null)
            {
                <div class="alert alert-warning rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-3 text-start" role="alert" style="background-color: #fffbeb; border: 1px dashed #f59e0b !important;">
                    <i class="bi bi-code-slash fs-5 text-warning flex-shrink-0"></i>
                    <div class="small text-dark">
                        <strong>@T("وضع التطوير (Dev Mode):", "Development Mode:")</strong>
                        <span>@T("كود التفعيل التجريبي:", "Demo Activation Code:")</span>
                        <code class="fw-bold fs-6 text-dark px-2 py-0.5 rounded bg-white border border-warning">@TempData["DevOtp"]</code>
                    </div>
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-3 text-start" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                    <div class="small">@ViewBag.Error</div>
                </div>
            }
            @if (TempData["OtpSent"] != null)
            {
                <div class="alert alert-success rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-3 text-start" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success flex-shrink-0"></i>
                    <div class="small">@TempData["OtpSent"]</div>
                </div>
            }

            <!-- Verification Form -->
            <form asp-controller="Account" asp-action="VerifyOtp" method="post" id="otpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@email" />

                <div class="mb-2">
                    <input type="text" 
                           id="otpCodeInput"
                           name="otpCode" 
                           class="otp-input-field" 
                           maxlength="6" 
                           pattern="[0-9]{6}" 
                           inputmode="numeric" 
                           autocomplete="one-time-code"
                           placeholder="000000" 
                           required 
                           autofocus />
                </div>

                <div class="text-muted small mt-2 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clock-history me-1"></i> @T("صلاحية الرمز: 10 دقائق", "Code valid for: 10 minutes")</span>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">@T("تفعيل حساب المدير", "Admin Role")</span>
                </div>

                <button type="submit" class="btn-verify">
                    <i class="bi bi-check2-circle fs-5"></i>
                    <span>@T("تأكيد وتفعيل الحساب", "Verify & Activate Account")</span>
                </button>
            </form>

            <!-- Resend Form & Return to Login -->
            <div class="resend-box">
                <form asp-controller="Account" asp-action="ResendOtp" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    <span>@T("لم يصلك الرمز؟", "Didn't receive code?")</span>
                    <button type="submit" class="btn-resend ms-1">@T("إعادة الإرسال", "Resend OTP")</button>
                </form>

                <a asp-action="Login" class="text-decoration-none text-muted fw-semibold">
                    <i class="bi bi-arrow-return-right me-1"></i> @T("العودة لتسجيل الدخول", "Back to Login")
                </a>
            </div>

        </div>

        <div class="text-center mt-3 text-muted small">
            &copy; @DateTime.Now.Year ClinicFlow Health Systems · @T("جميع الحقوق محفوظة", "All rights reserved")
        </div>
    </div>

    <script>
        const otpInput = document.getElementById('otpCodeInput');
        if (otpInput) {
            // Auto submit when 6 digits are typed
            otpInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value.length === 6) {
                    document.getElementById('otpForm').submit();
                }
            });
        }
    </script>
</body>
</html>
