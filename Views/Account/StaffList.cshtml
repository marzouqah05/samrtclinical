@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using WebApplication1.Models

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إدارة الموظفين والصلاحيات", "Staff & Access Management");

    var staffList = ViewBag.StaffList as IEnumerable<StaffUserViewModel> ?? Enumerable.Empty<StaffUserViewModel>();
    var staffArr = staffList.ToList();
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isCurrentOwner = ViewBag.IsOwner as bool? ?? false;
}

@* ── Toast Notifications ──────────────────────────────────────────────── *@
@if (TempData["Success"] != null)
{
    <div class="mb-4 p-3 rounded-xl border flex items-center gap-3 text-xs font-semibold" 
         style="background:var(--clinic-emerald-bg);border-color:rgba(46,125,91,0.25);color:var(--clinic-emerald-text);">
        <i class="fa-solid fa-circle-check text-base"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 p-3 rounded-xl border flex items-center gap-3 text-xs font-semibold" 
         style="background:var(--clinic-rose-bg);border-color:rgba(184,58,56,0.25);color:var(--clinic-rose-text);">
        <i class="fa-solid fa-circle-exclamation text-base"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="container-fluid py-2 max-w-5xl mx-auto" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Header Bar ──────────────────────────────────────────────────── *@
    <div class="clinic-page-header">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a asp-controller="Settings" asp-action="Index" class="text-xs font-semibold hover:underline" style="color:var(--clinic-muted)">
                    <i class="fa-solid fa-arrow-right-long me-1"></i>
                    @T("مركز الإعدادات", "Settings Hub")
                </a>
                <span style="color:var(--clinic-border)">/</span>
                <span class="text-xs font-semibold" style="color:var(--clinic-primary)">@T("الموظفين", "Staff Management")</span>
            </div>
            <h1 class="clinic-page-title">
                @T("إدارة الموظفين والمستخدمين والصلاحيات", "Staff & Access Management")
            </h1>
            <p class="clinic-page-subtitle">
                @T("نظام صلاحيات هرمي محمي (Owner/SuperAdmin vs Admin/Doctor/Receptionist) لإدارة حسابات الطاقم الطبي والإداري",
                   "Protected hierarchy RBAC (Owner/SuperAdmin vs Admin/Doctor/Receptionist) for staff and access control")
            </p>
        </div>

        @* Action Buttons *@
        <div class="flex items-center gap-2">
            <a asp-controller="Account" asp-action="Register" class="btn-clinic-primary">
                <i class="fa-solid fa-user-plus text-xs"></i>
                @T("إضافة موظف جديد", "Add New Staff")
            </a>
            <a asp-controller="Settings" asp-action="Index" class="btn-clinic-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                @T("العودة للإعدادات", "Back to Hub")
            </a>
        </div>
    </div>

    @* ── Staff Table Card ─────────────────────────────────────────────── *@
    <div class="clinic-card overflow-hidden">
        @if (!staffArr.Any())
        {
            <div class="p-12 text-center">
                <i class="fa-solid fa-users-slash text-4xl mb-3 block" style="color:var(--clinic-border)"></i>
                <p class="text-sm m-0" style="color:var(--clinic-muted)">
                    @T("لا يوجد موظفون مسجلون في النظام حالياً.", "No staff accounts found in the system.")
                </p>
                <div class="mt-4">
                    <a asp-controller="Account" asp-action="Register" class="btn-clinic-primary">
                        <i class="fa-solid fa-user-plus"></i>
                        @T("إضافة أول موظف", "Add First Staff Member")
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="clinic-table-wrap border-0 rounded-none overflow-x-auto">
                <table class="clinic-table w-full">
                    <thead>
                        <tr>
                            <th class="py-3 px-4 text-start">@T("الموظف / اسم المستخدم", "STAFF MEMBER / USERNAME")</th>
                            <th class="py-3 px-4 text-start">@T("البريد الإلكتروني", "EMAIL ADDRESS")</th>
                            <th class="py-3 px-4 text-start">@T("الدور والصلاحية", "ROLE & ACCESS")</th>
                            <th class="py-3 px-4 text-center" style="width:160px">@T("الإجراءات", "ACTIONS")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in staffArr)
                        {
                            var roleBadgeClass = item.Role switch {
                                "Owner"        => "bg-amber-500/10 text-amber-600 border border-amber-500/20 font-bold",
                                "SuperAdmin"   => "bg-amber-500/10 text-amber-600 border border-amber-500/20 font-bold",
                                "Admin"        => "bg-rose-500/10 text-rose-600 border border-rose-500/20 font-medium",
                                "Doctor"       => "bg-blue-500/10 text-blue-600 border border-blue-500/20 font-medium",
                                "Receptionist" => "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 font-medium",
                                _              => "bg-slate-500/10 text-slate-600 border border-slate-500/20 font-medium"
                            };

                            var roleLabel = item.Role switch {
                                "Owner"        => "Owner / SuperAdmin",
                                "SuperAdmin"   => "Owner / SuperAdmin",
                                "Admin"        => "Admin",
                                "Doctor"       => "Doctor",
                                "Receptionist" => "Receptionist",
                                _              => item.Role
                            };

                            var avatarLetter = (item.User.UserName ?? "?")[0].ToString().ToUpper();
                            var isCurrent = item.User.Id == currentUserId;

                            <tr class="@(isCurrent ? "bg-[#49665A]/5" : "")">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 @(item.IsOwner ? "bg-amber-500/15 text-amber-600 border border-amber-500/25" : "bg-[#49665A]/10 text-[#49665A] border border-[#49665A]/20")">
                                            @if (item.IsOwner)
                                            {
                                                <i class="fa-solid fa-crown text-xs"></i>
                                            }
                                            else
                                            {
                                                @avatarLetter
                                            }
                                        </div>
                                        <div>
                                            <div class="font-bold text-xs flex items-center gap-1.5" style="color:var(--clinic-text)">
                                                <span>@item.User.UserName</span>
                                                @if (isCurrent)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#49665A]/15 text-[#49665A]">
                                                        @T("حسابك", "You")
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-[11px] font-medium" style="color:var(--clinic-muted)">
                                                @(string.IsNullOrWhiteSpace(item.FullName) ? item.User.UserName : item.FullName)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="text-xs font-mono" style="color:var(--clinic-text)">
                                        @(string.IsNullOrEmpty(item.User.Email) ? "—" : item.User.Email)
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs @roleBadgeClass">
                                        @if (item.IsOwner)
                                        {
                                            <i class="fa-solid fa-shield-halved text-[10px]"></i>
                                        }
                                        <span>@roleLabel</span>
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @if (item.IsOwner)
                                    {
                                        @if (isCurrentOwner)
                                        {
                                            @* Owner can edit their own profile/credentials *@
                                            <div class="flex items-center justify-center gap-2">
                                                <a asp-controller="Staff" asp-action="Edit" asp-route-id="@item.User.Id"
                                                   class="p-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center gap-1"
                                                   title="@T("تعديل ملفك وبياناتك", "Edit Profile & Password")">
                                                    <i class="fa-solid fa-user-pen text-[11px]"></i>
                                                    <span class="text-[11px]">@T("تعديل", "Edit")</span>
                                                </a>
                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-[10px] font-bold bg-amber-500/10 text-amber-600 border border-amber-500/20"
                                                      title="@T("حساب المالك محصن من الحذف بشكل دائم", "Owner account is protected from deletion")">
                                                    <i class="fa-solid fa-shield-halved text-[9px]"></i>
                                                    <span>@T("محمي", "Protected")</span>
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            @* Secondary Admin cannot edit or delete Owner *@
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500/10 text-amber-600 border border-amber-500/20"
                                                  title="@T("حساب المالك محمي من التعديل أو الحذف من قبل المديرين", "Owner account is protected from Admins")">
                                                <i class="fa-solid fa-lock text-[10px]"></i>
                                                <span>@T("محمي", "Protected")</span>
                                            </span>
                                        }
                                    }
                                    else if (item.CanDelete || item.CanEdit)
                                    {
                                        <div class="flex items-center justify-center gap-2">
                                            @if (item.CanEdit)
                                            {
                                                <a asp-controller="Staff" asp-action="Edit" asp-route-id="@item.User.Id"
                                                   class="p-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center gap-1"
                                                   title="@T("تعديل بيانات وحساب الموظف", "Edit Account & Password")">
                                                    <i class="fa-solid fa-user-pen text-[11px]"></i>
                                                    <span class="text-[11px]">@T("تعديل", "Edit")</span>
                                                </a>
                                            }

                                            @if (item.CanDelete)
                                            {
                                                <form asp-controller="Account" asp-action="DeleteUser" asp-route-id="@item.User.Id" method="post"
                                                      onsubmit="return confirm('@T($"هل أنت متأكد من رغبتك في حذف حساب '{item.User.UserName}' نهائياً؟", $"Are you sure you want to permanently delete account '{item.User.UserName}'?")')"
                                                      class="inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-clinic-danger p-1.5 text-xs rounded-lg flex items-center gap-1"
                                                            title="@T("حذف الحساب", "Delete Account")">
                                                        <i class="fa-solid fa-trash-can text-[11px]"></i>
                                                        <span class="text-[11px]">@T("حذف", "Delete")</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 text-[11px] text-slate-400 dark:text-slate-500" title="@T("خارج نطاق صلاحيات حسابك", "Outside your permission level")">
                                            <i class="fa-solid fa-ban text-[10px]"></i>
                                            <span>@T("غير مصرح", "Restricted")</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-4 border-t flex items-center justify-between text-xs" style="border-color:var(--clinic-border);color:var(--clinic-muted)">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-shield-check text-sm text-[#49665A]"></i>
                    <span>@staffArr.Count @T("حسابات موظفين نشطة", "active staff accounts")</span>
                </div>
                <div class="flex items-center gap-3 text-[11px]">
                    <span class="inline-flex items-center gap-1 text-amber-600 font-medium">
                        <i class="fa-solid fa-crown text-[10px]"></i> @T("المالك محصن من الحذف", "Owner is immutable")
                    </span>
                    <span>•</span>
                    <span>@T("حماية تسلسل الصلاحيات مفعلة", "RBAC Hierarchy Protection Active")</span>
                </div>
            </div>
        }
    </div>

</div>

@* ── Edit Staff Modal ──────────────────────────────────────────────────── *@
<div id="editStaffModal" class="cf-modal-overlay" style="display:none;">
    <div class="cf-modal max-w-md w-full">
        <div class="cf-modal-header">
            <div class="flex items-center gap-2">
                <div class="cf-modal-icon bg-[#49665A]/10 text-[#49665A]">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
                <div>
                    <h3 class="cf-modal-title">@T("تعديل بيانات وصلاحية الموظف", "Edit Staff Access & Profile")</h3>
                    <p class="cf-modal-subtitle m-0" id="editModalSubtitle"></p>
                </div>
            </div>
            <button type="button" class="cf-modal-close" onclick="closeEditStaffModal()">&times;</button>
        </div>

        <form asp-controller="Account" asp-action="UpdateStaff" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editUserId" name="id" />

            <div class="mb-4">
                <label class="clinic-label">@T("الاسم الكامل للموظف", "Staff Full Name")</label>
                <input type="text" id="editFullName" name="fullName" class="clinic-input" placeholder="@T("د. أحمد الشريف", "Dr. Ahmad")" />
            </div>

            <div class="mb-4">
                <label class="clinic-label">@T("الدور والصلاحية", "Role & Access Level")</label>
                <select id="editRole" name="role" class="clinic-input" required>
                    @if (isCurrentOwner)
                    {
                        <option value="Admin">@T("مدير النظام (Admin)", "Administrator (Admin)")</option>
                    }
                    <option value="Doctor">@T("طبيب ممارس (Doctor)", "Doctor (Doctor)")</option>
                    <option value="Receptionist">@T("موظف استقبال (Receptionist)", "Receptionist (Receptionist)")</option>
                </select>
                <p class="text-[11px] mt-1 mb-0" style="color:var(--clinic-muted)">
                    @T("سيتم تحديث صلاحيات الوصول للوحة التحكم فوراً.", "Dashboard access permissions will update immediately.")
                </p>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-200 dark:border-slate-800 mt-6">
                <button type="button" class="btn-clinic-secondary" onclick="closeEditStaffModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </button>
                <button type="submit" class="btn-clinic-primary">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>@T("حفظ التغييرات", "Save Changes")</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditStaffModal(id, username, fullName, role) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editFullName').value = fullName || username;
        document.getElementById('editModalSubtitle').innerText = '@T("اسم الحساب:", "Account:") ' + username;
        const roleSelect = document.getElementById('editRole');
        if (roleSelect) {
            roleSelect.value = role;
        }
        const modal = document.getElementById('editStaffModal');
        if (modal) modal.style.display = 'flex';
    }

    function closeEditStaffModal() {
        const modal = document.getElementById('editStaffModal');
        if (modal) modal.style.display = 'none';
    }
</script>
