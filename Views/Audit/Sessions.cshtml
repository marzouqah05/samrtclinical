@model WebApplication1.Models.SessionsViewModel
@using System.Globalization
@using WebApplication1.Services
@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("سجل نشاط المستخدمين والجلسات", "User Activity & Sessions");

    var fiveMinutesAgo = DateTime.UtcNow.AddMinutes(-5);
}

<div class="space-y-6" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── 1. Page Header Bar & Navigation Segment ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-6 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#49665A]/15 border border-[#49665A]/30 text-[#49665A] flex items-center justify-center text-xl shrink-0">
                <i class="fa-solid fa-users-viewfinder"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#49665A]">Multi-Device Session Security</span>
                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3]">Realtime Tracking</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0 mt-0.5">
                    @T("سجل الجلسات ونشاط المستخدمين", "User Activity & Active Sessions")
                </h1>
                <p class="text-xs text-[#6B7D75] dark:text-[#9CA8A3] m-0 mt-1">
                    @T("مراقبة الجلسات المفتوحة لكل جهاز ومتصفح وتتبع تسجيلات الدخول والأنشطة في الوقت الفعلي",
                       "Monitor concurrent multi-device sessions, parse connection fingerprints, and trace real-time active users")
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            @* Segmented View Switcher *@
            <div class="inline-flex items-center p-1 bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl gap-1">
                <a asp-controller="AuditTrail" asp-action="Index"
                   class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] hover:bg-[#EAEFEA] dark:hover:bg-[#1B2421] flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-list-check text-[11px]"></i>
                    <span>@T("سجل العمليات", "Audit Trail")</span>
                </a>
                <a asp-controller="Audit" asp-action="Sessions"
                   class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#49665A] text-white shadow-sm flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-users-viewfinder text-[11px]"></i>
                    <span>@T("جلسات المستخدمين", "Active Sessions")</span>
                </a>
            </div>

            <a href="@Url.Action("Sessions")"
               class="bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-sm"
               title="@T("تحديث الجلسات", "Refresh Sessions")">
                <i class="fa-solid fa-rotate text-[#6B7D75] dark:text-[#9CA8A3]"></i>
                <span>@T("تحديث", "Refresh")</span>
            </a>
        </div>
    </div>

    @* ── 2. Top Statistical KPI Metric Grid ── *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        @* Card 1: Logins Today *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("تسجيلات الدخول اليوم", "Logins Today")</span>
                <div class="w-8 h-8 rounded-xl bg-[#49665A]/10 text-[#49665A] border border-[#49665A]/20 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                </div>
            </div>
            <div>
                <div class="text-2xl font-bold text-[#1A2621] dark:text-[#EAEFEA]">@(Model?.TotalLoginsToday ?? 0)</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#49665A]/10 text-[#49665A] dark:text-emerald-400 border border-[#49665A]/20">
                        <i class="fa-solid fa-calendar-day text-[8px]"></i>
                        <span>@T("اليوم الحقيقي", "Today")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("منذ منتصف الليل UTC", "since midnight UTC")</span>
                </div>
            </div>
        </div>

        @* Card 2: Active Online Users *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("المستخدمين النشطين حالياً", "Active Online Users")</span>
                <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-circle-dot"></i>
                </div>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">@(Model?.ActiveOnlineUsers ?? 0)</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>@T("نشط الآن", "Online Now")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("آخر 5 دقائق", "within last 5 mins")</span>
                </div>
            </div>
        </div>

        @* Card 3: Average Session Duration *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("متوسط مدة الجلسة", "Average Session Duration")</span>
                <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
            </div>
            <div>
                @{
                    var avgMinsTotal = (int)(Model?.AverageSessionMinutes ?? 0);
                    var avgH = avgMinsTotal / 60;
                    var avgM = avgMinsTotal % 60;
                    var formattedAvg = avgH > 0 ? $"{avgH}h {avgM}m" : $"{avgM}m";
                }
                <div class="text-2xl font-bold text-[#1A2621] dark:text-[#EAEFEA]">@formattedAvg</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                        <i class="fa-solid fa-hourglass-half text-[8px]"></i>
                        <span>@T("معدل الجلسات", "Avg Duration")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("للجلسات المكتملة", "for completed sessions")</span>
                </div>
            </div>
        </div>

    </div>

    @* ── 3. Search & Filter Bar ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-4 shadow-sm">
        <form method="get" class="flex flex-wrap items-center gap-3 m-0">
            @* Search Text *@
            <div class="relative flex-1 min-w-[220px]">
                <i class="fa-solid fa-magnifying-glass absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#8A9992] dark:text-[#9CA8A3]"></i>
                <input type="text" name="search" value="@Model?.SearchTerm"
                       placeholder="@T("البحث باسم المستخدم، الدور، عنوان IP، أو الجهاز...", "Search username, role, IP address, device...")"
                       class="w-full ps-9 pe-4 py-2 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] focus:ring-1 focus:ring-[#49665A] outline-none" />
            </div>

            @* Role Filter *@
            <div class="w-36">
                <select name="role" class="w-full py-2 px-3 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] focus:ring-1 focus:ring-[#49665A] outline-none">
                    <option value="">@T("جميع الأدوار", "All Roles")</option>
                    <option value="Admin" selected="@(Model?.RoleFilter == "Admin")">Admin</option>
                    <option value="Doctor" selected="@(Model?.RoleFilter == "Doctor")">Doctor</option>
                    <option value="Receptionist" selected="@(Model?.RoleFilter == "Receptionist")">Receptionist</option>
                </select>
            </div>

            @* Status Filter *@
            <div class="w-36">
                <select name="status" class="w-full py-2 px-3 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] focus:ring-1 focus:ring-[#49665A] outline-none">
                    <option value="">@T("جميع الحالات", "All Statuses")</option>
                    <option value="active" selected="@(Model?.StatusFilter == "active")">@T("نشط الآن", "Online / Active")</option>
                    <option value="ended" selected="@(Model?.StatusFilter == "ended")">@T("منتهي", "Ended / Offline")</option>
                </select>
            </div>

            @* Submit & Reset Buttons *@
            <div class="flex items-center gap-2">
                <button type="submit" class="px-4 py-2 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-filter text-[10px]"></i>
                    <span>@T("تصفية", "Filter")</span>
                </button>
                <a href="@Url.Action("Sessions")" class="p-2 text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl transition" title="@T("إعادة تعيين", "Reset Filters")">
                    <i class="fa-solid fa-rotate-right text-xs"></i>
                </a>
            </div>
        </form>
    </div>

    @* ── 4. Sessions Table Container ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-list-ul text-[#49665A] text-xs"></i>
                <h3 class="text-xs font-bold text-[#1A2621] dark:text-[#EAEFEA] uppercase tracking-wider m-0">
                    @T("سجلات جلسات النظام والأجهزة المتصلة", "System Sessions & Connected Devices")
                </h3>
            </div>
            <span class="px-2.5 py-0.5 rounded-md bg-[#F4F7F5] dark:bg-[#1B2421] border border-[#D5DDD8] dark:border-[#2B3833] text-[11px] font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">
                @(Model?.Sessions?.Count ?? 0) @T("سجل معروض", "records displayed")
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs">
                <thead>
                    <tr class="bg-[#F4F7F5] dark:bg-[#151E1B]/50 border-b border-[#E5E9E7] dark:border-[#2B3833] text-[#5C6E66] dark:text-[#9CA8A3] uppercase tracking-wider text-[10px]">
                        <th class="py-3 px-4 text-start font-semibold">@T("المستخدم", "User")</th>
                        <th class="py-3 px-4 text-start font-semibold">@T("الدور", "Role")</th>
                        <th class="py-3 px-4 text-start font-semibold">@T("وقت الدخول", "Login Time")</th>
                        <th class="py-3 px-4 text-start font-semibold">@T("آخر نشاط", "Last Active")</th>
                        <th class="py-3 px-4 text-center font-semibold">@T("المدة", "Duration")</th>
                        <th class="py-3 px-4 text-start font-semibold">@T("الجهاز والمتصفح", "Device / Browser")</th>
                        <th class="py-3 px-4 text-start font-semibold">@T("عنوان IP", "IP Address")</th>
                        <th class="py-3 px-4 text-center font-semibold">@T("الحالة", "Status")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E5E9E7] dark:divide-[#2B3833]">
                    @if (Model?.Sessions == null || !Model.Sessions.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-[#6B7D75] dark:text-[#9CA8A3]">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <i class="fa-solid fa-users-slash text-2xl text-[#49665A]/40"></i>
                                    <span class="font-medium">@T("لا توجد جلسات مطابقة لمعايير البحث الحالية.", "No session records match the current criteria.")</span>
                                    <span class="text-[11px] text-[#6B7D75] dark:text-[#727A76]">@T("يتم توثيق وتتبع الجلسات المتعددة تلقائياً بمجرد تسجيل الدخول.", "All multi-device sessions are recorded automatically on login.")</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model.Sessions)
                        {
                            var (deviceType, deviceDisplay, deviceIcon) = UserAgentHelper.Parse(s.UserAgent);
                            var isActuallyOnline = s.IsActive && s.LastActivityTime >= fiveMinutesAgo;

                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                @* User Name *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-[#49665A]/20 border border-[#49665A]/30 text-[#49665A] font-bold text-xs flex items-center justify-center shrink-0">
                                            @((s.UserName?.Length > 0 ? s.UserName.Substring(0, 1).ToUpper() : "U"))
                                        </div>
                                        <div>
                                            <span class="font-semibold text-[#1A2621] dark:text-[#EAEFEA] block">@(s.UserName ?? "System")</span>
                                            @if (!string.IsNullOrEmpty(s.SessionId))
                                            {
                                                <span class="text-[10px] text-[#6B7D75] dark:text-[#727A76] block font-mono" title="@s.SessionId">
                                                    @(s.SessionId.Length > 12 ? s.SessionId.Substring(0, 12) + "..." : s.SessionId)
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                @* User Role *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    @{
                                        var role = s.UserRole ?? "User";
                                        var roleClass = role switch
                                        {
                                            "Admin" => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
                                            "Doctor" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20",
                                            "Receptionist" => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
                                            _ => "bg-gray-500/10 text-gray-600 dark:text-gray-400 border-gray-500/20"
                                        };
                                    }
                                    <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-semibold @roleClass">
                                        @role
                                    </span>
                                </td>

                                @* Login Time *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <div class="text-[#1A2621] dark:text-[#EAEFEA] font-medium text-xs">
                                        @s.LoginTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </div>
                                    <div class="text-[10px] text-[#6B7D75] dark:text-[#727A76] font-mono">
                                        UTC: @s.LoginTime.ToString("HH:mm")
                                    </div>
                                </td>

                                @* Last Active *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <div class="text-[#1A2621] dark:text-[#EAEFEA] font-medium text-xs">
                                        @s.LastActivityTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </div>
                                    <div class="text-[10px] text-[#6B7D75] dark:text-[#727A76] font-mono">
                                        UTC: @s.LastActivityTime.ToString("HH:mm")
                                    </div>
                                </td>

                                @* Duration *@
                                <td class="py-3 px-4 whitespace-nowrap text-center">
                                    <span class="px-2 py-0.5 rounded-md bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] font-medium text-[11px]">
                                        @((int)s.DurationMinutes)m
                                    </span>
                                </td>

                                @* Device / Browser (Parsed) *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-[11px]" title="@s.UserAgent">
                                        <i class="@deviceIcon text-[#49665A] dark:text-emerald-400 text-[11px]"></i>
                                        <span class="font-medium">@deviceDisplay</span>
                                    </span>
                                </td>

                                @* IP Address *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <span class="font-mono text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">
                                        @(s.IpAddress ?? "—")
                                    </span>
                                </td>

                                @* Status Badge *@
                                <td class="py-3 px-4 whitespace-nowrap text-center">
                                    @if (isActuallyOnline)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[10px] font-bold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                            <span>@T("متصل", "Online")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-gray-500/10 text-[#6B7D75] dark:text-[#9CA8A3] border border-gray-500/20 text-[10px] font-semibold">
                                            <i class="fa-solid fa-circle text-[6px] text-gray-400"></i>
                                            <span>@T("منتهي", "Offline")</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
