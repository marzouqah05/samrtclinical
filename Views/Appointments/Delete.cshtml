@model WebApplication1.Models.Appointment

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("حذف الموعد", "Delete Appointment");

    var status = "";
    var badgeClass = "";

    if (Model.AppointmentDate.Date == DateTime.Today)
    {
        status = T("اليوم", "Today");
        badgeClass = "bg-success";
    }
    else if (Model.AppointmentDate.Date > DateTime.Today)
    {
        status = T("قادم", "Upcoming");
        badgeClass = "bg-primary";
    }
    else
    {
        status = T("مكتمل", "Completed");
        badgeClass = "bg-secondary";
    }
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    body { background: #f5f7fb; }
    .delete-container { max-width: 950px; margin: auto; }
    .delete-card { background: white; border-radius: 30px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
    .delete-header { background: linear-gradient(135deg, #ef4444, #dc2626); padding: 45px; color: white; text-align: center; }
    .delete-icon { width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; justify-content: center; align-items: center; margin: auto; font-size: 40px; margin-bottom: 20px; }
    .delete-header h2 { margin: 0; font-weight: bold; }
    .delete-header p { margin-top: 10px; opacity: 0.9; }
    .delete-body { padding: 35px; }
    .appointment-card { background: #f8fafc; border-radius: 24px; padding: 30px; }
    .status-badge { padding: 8px 16px; border-radius: 30px; font-size: 13px; font-weight: 600; }
    .profile-box { display: flex; align-items: center; gap: 18px; margin-bottom: 25px; }
    .profile-avatar { width: 70px; height: 70px; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: white; font-size: 26px; font-weight: bold; }
    .doctor-avatar { background: #10b981; }
    .patient-avatar { background: #3b82f6; }
    .profile-info h5 { margin: 0; font-weight: bold; }
    .profile-info p { margin-top: 5px; color: #64748b; font-size: 14px; }
    .info-item { margin-top: 25px; }
    .info-label { color: #64748b; font-size: 14px; margin-bottom: 6px; }
    .info-value { font-size: 17px; font-weight: 600; color: #0f172a; }
    .warning-box { background: #fee2e2; color: #b91c1c; padding: 18px; border-radius: 18px; margin-top: 30px; }
    .delete-btn { background: #ef4444; border: none; border-radius: 16px; padding: 14px 28px; font-weight: 600; transition: 0.3s; }
    .delete-btn:hover { background: #dc2626; transform: translateY(-2px); }
    .back-btn { border-radius: 16px; padding: 14px 24px; }
</style>

<div class="delete-container" dir="@(_isAr ? "rtl" : "ltr")">

    <div class="delete-card">

        <!-- Header -->
        <div class="delete-header">
            <div class="delete-icon">
                <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <h2>@T("حذف الموعد", "Delete Appointment")</h2>
            <p>@T("هل أنت متأكد من حذف هذا الموعد نهائياً؟", "Are you sure you want to permanently delete this appointment?")</p>
        </div>

        <!-- Body -->
        <div class="delete-body">

            <div class="appointment-card">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">@T("معلومات الموعد", "Appointment Information")</h4>
                    <span class="badge @badgeClass status-badge">@status</span>
                </div>

                <!-- Doctor -->
                <div class="profile-box">
                    <div class="profile-avatar doctor-avatar">
                        @Model.Doctor?.DoctorName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="profile-info">
                        <h5>@(_isAr ? "د." : "Dr.") @Model.Doctor?.DoctorName</h5>
                        <p>@T("الطبيب المعيّن", "Assigned Doctor")</p>
                    </div>
                </div>

                <!-- Patient -->
                <div class="profile-box">
                    <div class="profile-avatar patient-avatar">
                        @Model.Patient?.PatientName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="profile-info">
                        <h5>@Model.Patient?.PatientName</h5>
                        <p>@T("مريض مسجّل", "Registered Patient")</p>
                    </div>
                </div>

                <!-- Date -->
                <div class="info-item">
                    <div class="info-label">@T("تاريخ الموعد", "Appointment Date")</div>
                    <div class="info-value">@Model.AppointmentDate.ToString("dd MMMM yyyy")</div>
                </div>

            </div>

            <!-- Warning -->
            <div class="warning-box">
                <i class="fa-solid fa-triangle-exclamation"></i>
                @T("لا يمكن التراجع عن هذا الإجراء. حذف هذا الموعد قد يؤثر على جدولة المرضى وسجلات العيادة.", "This action cannot be undone. Deleting this appointment may affect patient scheduling and clinic records.")
            </div>

            <!-- Buttons -->
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="AppointmentId" />
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-danger delete-btn">
                        <i class="fa-solid fa-trash"></i>
                        @T("حذف الموعد", "Delete Appointment")
                    </button>
                    <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-xmark text-xs"></i>
                        <span>@T("إلغاء", "Cancel")</span>
                    </a>
                </div>
            </form>

        </div>

    </div>

</div>