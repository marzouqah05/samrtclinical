@model WebApplication1.Models.Appointment

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إنشاء موعد جديد", "Create Appointment");
}

<div dir="@(_isAr ? "rtl" : "ltr")" class="py-4">
    <!-- Main Card Container -->
    <div class="bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-2xl p-6 sm:p-8 shadow-sm max-w-4xl mx-auto">
        
        <!-- Header -->
        <div class="flex items-center gap-3 pb-6 border-b border-[#DDE3DF] dark:border-[#2B3833] mb-6">
            <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-calendar-plus"></i>
            </div>
            <div>
                <h2 class="text-base sm:text-lg font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                    @T("إنشاء موعد جديد", "Create Appointment")
                </h2>
                <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0 mt-0.5">
                    @T("جدولة موعد طبي جديد بين الطبيب والمريض وتحديد الوقت والملاحظات السريرية.", "Schedule a new appointment between doctor and patient with clinical intake details.")
                </p>
            </div>
        </div>

        <form asp-action="Create" method="post" id="createAppointmentForm" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="isException" id="isExceptionInput" value="false" />
            <input type="hidden" asp-for="IsOutsideHoursException" id="IsOutsideHoursException" value="false" />

            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs"></div>

            <!-- Date & Time Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="AppointmentDate" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-calendar-days text-[#49665A] me-1.5"></i>@T("تاريخ الموعد", "Appointment Date")
                    </label>
                    <input asp-for="AppointmentDate" type="date"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" />
                    <span asp-validation-for="AppointmentDate" class="text-rose-500 text-[11px] mt-1 block"></span>

                    <!-- Weekend / Holiday Dynamic Warning Banner & Override Checkbox -->
                    <div id="weekendWarningContainer" class="hidden mt-2.5 space-y-2">
                        <div id="weekendWarningBanner" class="relative p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs">
                            <button type="button" id="btnDismissWeekend" class="absolute top-2.5 end-2.5 text-amber-600 hover:text-amber-800 dark:text-amber-400 p-1 text-xs leading-none" aria-label="Dismiss">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                            <div class="pe-6">
                                <p class="font-medium m-0 leading-relaxed">
                                    @T("⚠️ تنبيه عطلة نهاية الأسبوع: يوما الجمعة والسبت عطلة رسمية للعيادة. هل أنت متأكد من تسجيل موعد استثنائي/طارئ؟", "⚠️ Weekend Notice: Friday and Saturday are official clinic off-days. Are you sure you want to book an emergency/exception slot?")
                                </p>
                            </div>
                        </div>
                        <div id="weekendOverrideWrapper" class="flex items-center gap-2 px-1">
                            <input type="checkbox" asp-for="IsWeekendOverride" id="IsWeekendOverride"
                                   class="w-4 h-4 rounded text-amber-600 border-amber-300 focus:ring-amber-500 cursor-pointer" />
                            <label for="IsWeekendOverride" class="font-semibold text-xs text-[#202725] dark:text-[#EAEFEA] cursor-pointer select-none m-0">
                                @T("تأكيد حجز استثنائي في يوم العطلة", "Confirm Weekend / Holiday Booking Exception")
                            </label>
                        </div>
                    </div>
                </div>

                <div>
                    <label asp-for="AppointmentTime" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-clock text-[#49665A] me-1.5"></i>@T("وقت الموعد", "Appointment Time")
                    </label>
                    <input asp-for="AppointmentTime" type="time" id="AppointmentTime"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" />
                    <span asp-validation-for="AppointmentTime" class="text-rose-500 text-[11px] mt-1 block"></span>
                    <div id="pastTimeErrorMsg" class="hidden text-rose-500 text-[11px] mt-1 font-medium flex items-center gap-1">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@T("لا يمكن حجز موعد في تاريخ أو وقت سابق عن الوقت الحالي.", "Cannot schedule an appointment in the past.")</span>
                    </div>
                </div>
            </div>

            <!-- Department & Doctor Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="DepartmentId" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-hospital text-[#49665A] me-1.5"></i>@T("القسم / التخصص الطبي", "Department / Specialty")
                    </label>
                    @if (User.IsInRole("Doctor") || User.IsDoctor())
                    {
                        var deptName = ViewBag.CurrentDoctorDepartmentName as string ?? "General Practice";
                        <input type="hidden" asp-for="DepartmentId" value="@ViewBag.CurrentDoctorDepartmentId" />
                        <div class="w-full px-3.5 py-2.5 rounded-xl border border-blue-200 dark:border-blue-900/60 bg-blue-50/50 dark:bg-blue-950/20 text-blue-900 dark:text-blue-300 text-xs font-semibold flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-blue-200 dark:bg-blue-800 text-blue-800 dark:text-blue-100 text-[10px]">
                                    <i class="fa-solid fa-hospital"></i>
                                </span>
                                <span>@deptName</span>
                            </div>
                            <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-md bg-blue-200/70 dark:bg-blue-800/60 text-blue-900 dark:text-blue-200 font-medium">
                                <i class="fa-solid fa-lock text-[9px] me-1"></i>@T("قسمك الحالي", "Locked")
                            </span>
                        </div>
                    }
                    else
                    {
                        <select asp-for="DepartmentId" id="createDepartmentSelect" onchange="filterCreateDoctorsByDepartment(this.value)"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition">
                            <option value="">@T("-- جميع الأقسام / عام --", "-- All Departments / General --")</option>
                            @if (ViewBag.AllDepartments != null)
                            {
                                foreach (var dept in (IEnumerable<WebApplication1.Models.Department>)ViewBag.AllDepartments)
                                {
                                    <option value="@dept.DepartmentId" selected="@(Model?.DepartmentId == dept.DepartmentId)">@dept.DepartmentName</option>
                                }
                            }
                        </select>
                    }
                    <span asp-validation-for="DepartmentId" class="text-rose-500 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="DoctorId" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        <i class="fa-solid fa-user-doctor text-[#49665A] me-1.5"></i>@T("الطبيب المعيّن", "Assigned Doctor")
                    </label>
                    @if (User.IsInRole("Doctor") || User.IsDoctor())
                    {
                        var docName = ViewBag.CurrentDoctorName as string ?? User.Identity?.Name ?? "Doctor";
                        if (!string.IsNullOrEmpty(docName) && !docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) && !docName.StartsWith("د.", StringComparison.OrdinalIgnoreCase))
                        {
                            docName = $"Dr. {docName}";
                        }
                        <input type="hidden" asp-for="DoctorId" value="@ViewBag.CurrentDoctorId" />
                        <div class="w-full px-3.5 py-2.5 rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/60 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 text-xs font-semibold flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-200 dark:bg-emerald-800 text-emerald-800 dark:text-emerald-100 text-[10px]">
                                    <i class="fa-solid fa-user-doctor"></i>
                                </span>
                                <span>Doctor: @docName</span>
                            </div>
                            <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-200/70 dark:bg-emerald-800/60 text-emerald-900 dark:text-emerald-200 font-medium">
                                <i class="fa-solid fa-lock text-[9px] me-1"></i>@T("طبيبك الحالي", "Locked")
                            </span>
                        </div>
                    }
                    else
                    {
                        <select asp-for="DoctorId" id="createDoctorSelect"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" required>
                            <option value="">@T("-- اختر الطبيب --", "-- Select Doctor --")</option>
                            @if (ViewBag.AllDoctors != null)
                            {
                                foreach (var doc in (IEnumerable<WebApplication1.Models.Doctor>)ViewBag.AllDoctors)
                                {
                                    <option value="@doc.DoctorId" data-department-id="@doc.DepartmentId" selected="@(Model?.DoctorId == doc.DoctorId)">@(doc.DoctorName?.StartsWith("Dr.") == true || doc.DoctorName?.StartsWith("د.") == true ? doc.DoctorName : "Dr. " + doc.DoctorName)</option>
                                }
                            }
                        </select>
                    }
                    <span asp-validation-for="DoctorId" class="text-rose-500 text-[11px] mt-1 block"></span>
                </div>
            </div>

            <!-- Patient Row -->
            <div>
                <label asp-for="PatientId" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                    <i class="fa-solid fa-user text-[#49665A] me-1.5"></i>@T("المريض", "Patient")
                </label>
                <select asp-for="PatientId" asp-items="ViewBag.PatientId"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" required>
                    <option value="">@T("-- اختر المريض --", "-- Select Patient --")</option>
                </select>
                <span asp-validation-for="PatientId" class="text-rose-500 text-[11px] mt-1 block"></span>
            </div>

            <!-- Notes Field -->
            <div>
                <label asp-for="Notes" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                    <i class="fa-solid fa-notes-medical text-[#49665A] me-1.5"></i>@T("ملاحظات / شكاوى طبية (اختياري)", "Notes / Medical Complaints (Optional)")
                </label>
                <textarea asp-for="Notes" rows="3"
                          placeholder="@T("اكتب أي أعراض أو تفضيلات أو مبررات الاستثناء الطبي...", "Write any specific symptoms, preferences, or exception justification...")"
                          class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition resize-none"></textarea>
                <span asp-validation-for="Notes" class="text-rose-500 text-[11px] mt-1 block"></span>
            </div>

            <!-- Schedule Exception (Outside Hours / Follow-up Exception) -->
            <div class="p-4 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/20">
                <div class="flex items-start gap-3">
                    <input asp-for="IsOutsideHoursException" type="checkbox" id="IsOutsideHoursException"
                           class="mt-0.5 w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-[#DDE3DF] dark:border-[#2B3833] dark:bg-[#151E1B] cursor-pointer" />
                    <div>
                        <label asp-for="IsOutsideHoursException" class="text-xs font-bold text-amber-900 dark:text-amber-200 cursor-pointer block">
                            @T("طلب استثناء خارج أوقات الدوام / استثناء عاجل", "Request Outside-Hours / Urgent Follow-up Exception")
                        </label>
                        <p class="text-[11px] text-amber-700 dark:text-amber-300 mt-0.5 m-0 leading-relaxed">
                            @T("يتيح هذا الخيار حجز موعد خارج أوقات العمل الرسمية أو في فترات الحماية، وتظهر الملاحظات لموظف الاستقبال عند مراجعة وتأكيد الموعد.",
                               "Checking this allows scheduling outside standard clinic hours or in buffer slots. Your notes will be visible to reception when reviewing and confirming.")
                        </p>
                    </div>
                </div>
            </div>

            <!-- Operational Notes Box -->
            <div class="bg-[#F6F7F5] dark:bg-[#151E1B] border border-[#DDE3DF] dark:border-[#2B3833] rounded-xl p-4 text-xs text-[#727A76] dark:text-[#9CA8A3]">
                <div class="font-semibold text-[#202725] dark:text-[#EAEFEA] flex items-center gap-1.5 mb-2">
                    <i class="fa-solid fa-circle-info text-[#49665A]"></i>
                    <span>@T("ملاحظات النظام", "System Notice")</span>
                </div>
                <ul class="space-y-1.5 list-none p-0 m-0">
                    <li class="flex items-center gap-2">
                        <i class="fa-solid fa-check text-emerald-500 text-[10px]"></i>
                        <span>@T("يتم ضبط حالة الموعد تلقائياً إلى معلّق (Pending).", "Appointment status is set to Pending by default.")</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <i class="fa-solid fa-check text-emerald-500 text-[10px]"></i>
                        <span>@T("يتم إرسال تذكير تلقائي عبر واتسآب فور تسجيل الموعد في حال تفعيل الخدمة.", "Automated WhatsApp confirmation is triggered upon successful booking.")</span>
                    </li>
                </ul>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800/80 mt-6">
                <a asp-action="Index"
                   class="bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 hover:border-slate-600 font-medium px-5 py-2.5 rounded-lg text-sm transition cursor-pointer inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow-md shadow-emerald-950/40 inline-flex items-center gap-2 transition active:scale-95 cursor-pointer border-0">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>@T("حفظ الموعد", "Save Appointment")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_ScheduleExceptionModal")

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.querySelector('input[name="AppointmentDate"]');
            const timeInput = document.querySelector('input[name="AppointmentTime"]');
            const warningContainer = document.getElementById('weekendWarningContainer');
            const warningBanner = document.getElementById('weekendWarningBanner');
            const overrideCheckbox = document.getElementById('IsWeekendOverride');
            const btnDismiss = document.getElementById('btnDismissWeekend');

            function evaluateWeekend() {
                if (!dateInput || !warningContainer) return;
                const val = dateInput.value;
                if (!val) {
                    warningContainer.classList.add('hidden');
                    if (overrideCheckbox) overrideCheckbox.checked = false;
                    return;
                }

                const parts = val.split('-');
                if (parts.length === 3) {
                    const year = parseInt(parts[0], 10);
                    const month = parseInt(parts[1], 10) - 1;
                    const day = parseInt(parts[2], 10);
                    const d = new Date(year, month, day);
                    const dayOfWeek = d.getDay(); // 0: Sun, 1: Mon, ..., 5: Fri, 6: Sat

                    if (dayOfWeek === 5 || dayOfWeek === 6) {
                        warningContainer.classList.remove('hidden');
                        if (warningBanner) {
                            warningBanner.classList.remove('hidden');
                        }
                    } else {
                        warningContainer.classList.add('hidden');
                        if (overrideCheckbox) {
                            overrideCheckbox.checked = false;
                        }
                    }
                }
            }

            function updateMinTime() {
                if (!dateInput || !timeInput) return;
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const todayStr = `${year}-${month}-${day}`;

                if (dateInput.value === todayStr) {
                    const hours = String(now.getHours()).padStart(2, '0');
                    const minutes = String(now.getMinutes()).padStart(2, '0');
                    const currentTimeStr = `${hours}:${minutes}`;
                    timeInput.setAttribute('min', currentTimeStr);
                    if (timeInput.value && timeInput.value < currentTimeStr) {
                        timeInput.value = currentTimeStr;
                    }
                } else {
                    timeInput.removeAttribute('min');
                }
            }

            if (dateInput) {
                dateInput.addEventListener('change', function () {
                    evaluateWeekend();
                    updateMinTime();
                });
                dateInput.addEventListener('input', function () {
                    evaluateWeekend();
                    updateMinTime();
                });
                evaluateWeekend();
                updateMinTime();
            }

            const form = document.querySelector('form');
            const pastTimeError = document.getElementById('pastTimeErrorMsg');

            function isPastTimeSelected() {
                if (!dateInput || !timeInput || !dateInput.value || !timeInput.value) return false;
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const todayStr = `${year}-${month}-${day}`;

                if (dateInput.value === todayStr) {
                    const hours = String(now.getHours()).padStart(2, '0');
                    const minutes = String(now.getMinutes()).padStart(2, '0');
                    const currentTimeStr = `${hours}:${minutes}`;
                    return timeInput.value < currentTimeStr;
                }
                return false;
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (isPastTimeSelected()) {
                        e.preventDefault();
                        if (pastTimeError) {
                            pastTimeError.classList.remove('hidden');
                        }
                        if (timeInput) {
                            timeInput.classList.add('border-rose-500');
                            timeInput.focus();
                        }
                        return false;
                    }
                });
            }

            if (timeInput) {
                timeInput.addEventListener('input', function () {
                    if (!isPastTimeSelected()) {
                        if (pastTimeError) pastTimeError.classList.add('hidden');
                        timeInput.classList.remove('border-rose-500');
                    }
                });
                timeInput.addEventListener('change', function () {
                    if (!isPastTimeSelected()) {
                        if (pastTimeError) pastTimeError.classList.add('hidden');
                        timeInput.classList.remove('border-rose-500');
                    }
                });
            }

            if (dateInput) {
                dateInput.addEventListener('change', function () {
                    if (!isPastTimeSelected()) {
                        if (pastTimeError) pastTimeError.classList.add('hidden');
                        if (timeInput) timeInput.classList.remove('border-rose-500');
                    }
                });
            }

            if (btnDismiss && warningBanner) {
                btnDismiss.addEventListener('click', function () {
                    warningBanner.classList.add('hidden');
                });
            }

            initScheduleExceptionGuard({
                formSelector: '#createAppointmentForm',
                timeInputSelector: '#AppointmentTime',
                exceptionInputSelector: '#isExceptionInput',
                dateInputSelector: 'input[name="AppointmentDate"]',
                doctorSelectSelector: 'select[name="DoctorId"]',
                shiftStart: '@(ViewBag.WorkingHoursStart ?? "08:00")',
                shiftEnd: '@(ViewBag.WorkingHoursEnd ?? "20:00")',
                slotDurationMinutes: @(ViewBag.SlotDurationMinutes ?? 15)
            });

            const docSelect = document.getElementById('createDoctorSelect');
            const deptSelect = document.getElementById('createDepartmentSelect');
            if (docSelect && deptSelect) {
                docSelect.addEventListener('change', function() {
                    const opt = docSelect.options[docSelect.selectedIndex];
                    const docDept = opt ? opt.getAttribute('data-department-id') : null;
                    if (docDept && !deptSelect.value) {
                        deptSelect.value = docDept;
                    }
                });
            }
        });

        function filterCreateDoctorsByDepartment(deptId) {
            const docSelect = document.getElementById('createDoctorSelect');
            if (!docSelect || docSelect.tagName !== 'SELECT') return;

            const currentVal = docSelect.value;
            const options = docSelect.querySelectorAll('option');
            let matchFound = false;

            options.forEach(opt => {
                if (!opt.value) return;
                const docDept = opt.getAttribute('data-department-id');
                if (!deptId || docDept === deptId || !docDept) {
                    opt.style.display = '';
                    opt.disabled = false;
                    if (opt.value === currentVal) matchFound = true;
                } else {
                    opt.style.display = 'none';
                    opt.disabled = true;
                }
            });

            if (!matchFound && deptId) {
                docSelect.value = '';
            }
        }
    </script>
    <script src="~/js/schedule-exception.js"></script>
}