@using System.Globalization
@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
}

<!-- Schedule Exception Warning Modal -->
<div class="modal fade" id="scheduleExceptionModal" tabindex="-1" aria-labelledby="scheduleExceptionModalLabel" aria-hidden="true" dir="@(_isAr ? "rtl" : "ltr")" style="z-index: 1070;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content rounded-2xl border border-amber-300 dark:border-amber-700/80 shadow-2xl p-6 bg-white dark:bg-[#1B2421] text-slate-900 dark:text-slate-100 overflow-hidden text-start">
            
            <!-- Header -->
            <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-amber-500/10 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg shrink-0">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h5 class="text-slate-900 dark:text-white font-bold text-base m-0" id="scheduleExceptionModalLabel">
                            @T("خارج ساعات العمل المعتمدة", "Schedule Exception")
                        </h5>
                        <p class="text-[11px] text-amber-700 dark:text-amber-400 font-medium m-0 mt-0.5">
                            @T("Schedule Exception / خارج ساعات العمل المعتمدة", "Schedule Exception / خارج ساعات العمل المعتمدة")
                        </p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" data-bs-dismiss="modal" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Warning Notice Card -->
            <div class="bg-amber-50/90 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 rounded-xl p-4 mb-4">
                <div class="flex items-start gap-2.5">
                    <i class="fa-solid fa-clock-rotate-left text-amber-600 dark:text-amber-400 text-sm mt-0.5 shrink-0"></i>
                    <div class="min-w-0 flex-1">
                        <!-- Dynamic Message injected here -->
                        <div id="exceptionWarningMessage" class="font-semibold text-xs sm:text-sm text-amber-900 dark:text-amber-200 leading-relaxed">
                            @T("الوقت المحدد يقع خارج ساعات العمل المعتمدة أو ضمن فترات التحضير والإغلاق.", "Selected time is outside official working hours or within preparation/wrap-up slots.")
                        </div>
                    </div>
                </div>
                <div class="mt-3 pt-2.5 border-t border-amber-200/80 dark:border-amber-800/40 text-xs font-semibold text-amber-800 dark:text-amber-300 flex items-center gap-1.5">
                    <i class="fa-solid fa-shield-halved text-amber-600 dark:text-amber-400"></i>
                    <span>@T("هل أنت متأكد من رغبتك في حجز هذا الموعد كاستثناء معتمد ومصرح به؟", "Are you sure you want to book this appointment as an authorized exception?")</span>
                </div>
            </div>

            <!-- Actions Footer -->
            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-200 dark:border-[#2B3833]">
                <button type="button" id="btnExceptionChangeTime" class="bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 font-medium px-4 py-2 rounded-xl text-xs transition cursor-pointer" data-bs-dismiss="modal">
                    <i class="fa-solid fa-arrow-rotate-left me-1"></i>
                    <span>@T("تغيير الوقت", "Change Time")</span>
                </button>
                <button type="button" id="btnExceptionConfirm" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-4 py-2 rounded-xl text-xs shadow-md shadow-amber-950/30 inline-flex items-center gap-1.5 transition active:scale-95 cursor-pointer border-0">
                    <i class="fa-solid fa-check"></i>
                    <span>@T("تأكيد الاستثناء وحجز الموعد", "Confirm Exception & Book")</span>
                </button>
            </div>
        </div>
    </div>
</div>
