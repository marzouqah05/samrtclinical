    /* ─── Bootstrap 5 Modal Centering & Sizing Fixes ─── */
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1055;
        display: none;
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        outline: 0;
    }
    .modal-dialog {
        position: relative;
        width: auto;
        margin: 1.75rem auto;
        pointer-events: none;
    }
    .modal.fade .modal-dialog {
        transition: transform .3s ease-out;
        transform: translate(0, -50px);
    }
    .modal.show .modal-dialog {
        transform: none;
    }
    .modal-dialog-centered {
        display: flex;
        align-items: center;
        min-height: calc(100% - 3.5rem);
    }
    .modal-dialog.modal-lg,
    #quickBookModal .modal-dialog {
        max-width: 800px !important;
        width: 95% !important;
        margin: 1.75rem auto !important;
    }
    .modal-content {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        pointer-events: auto;
        background-color: #fff;
        background-clip: padding-box;
        border: 0;
        border-radius: 1rem;
        outline: 0;
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }
    [data-bs-theme="dark"] .modal-content,
    html.dark .modal-content {
        background-color: #1B2421 !important;
        border: 1px solid #2B3833 !important;
        color: #EAEFEA !important;
    }
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1050;
        width: 100vw;
        height: 100vh;
        background-color: #000;
    }
    .modal-backdrop.fade { opacity: 0; }
    .modal-backdrop.show { opacity: .5; }

    #panelOverlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,.3); z-index: 1400;
        backdrop-filter: blur(2px);
    }
    #panelOverlay.show { display: block; }
</style>

<div class="page-container">

    @* ─── Flash Messages ─── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* ─── Page Header ─── *@
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h2 class="text-[#1A2621] dark:text-[#EAEFEA] font-bold text-xl m-0 flex items-center gap-2">
                <i class="fa-regular fa-calendar-check text-[#49665A]"></i>
                <span>@T("المواعيد", "Appointments")</span>
            </h2>
            <p class="text-[#6B7D75] dark:text-[#9CA8A3] text-xs m-0 mt-1">@T("إدارة زيارات المرضى ومتابعة الجدولة وتحديث حالة الحجز فورياً.", "Manage patient visits, monitor scheduling, and update reservation status live.")</p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <div class="view-toggle-group bg-light p-1 rounded-pill border d-inline-flex align-items-center gap-1" id="viewToggle">
                <button type="button" id="btnCalView"
                        class="btn btn-sm border-0 rounded-pill px-3 text-secondary view-toggle-btn active"
                        onclick="switchView('calendar')">
                    <i class="fa-regular fa-calendar"></i>
                    <span>@T("تقويم", "Calendar")</span>
                </button>
                <button type="button" id="btnListView"
                        class="btn btn-sm border-0 rounded-pill px-3 text-secondary view-toggle-btn"
                        onclick="switchView('list')">
                    <i class="fa-solid fa-list"></i>
                    <span>@T("قائمة", "List")</span>
                </button>
            </div>
            <button type="button"
                    class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] inline-flex items-center gap-1.5 transition shadow-sm"
                    data-bs-toggle="modal" data-bs-target="#importAppointmentsModal">
                <i class="fa-solid fa-file-import text-[#49665A]"></i>
                <span>@T("استيراد", "Import")</span>
            </button>
            <a asp-action="Export"
               class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] inline-flex items-center gap-1.5 transition shadow-sm">
                <i class="fa-solid fa-file-excel text-[#49665A]"></i>
                <span>@T("تصدير", "Export")</span>
            </a>
            <button type="button"
                    class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#49665A] hover:bg-[#3D574D] text-white inline-flex items-center gap-1.5 transition shadow-sm"
                    data-bs-toggle="modal" data-bs-target="#quickBookModal">
                <i class="fa-solid fa-plus"></i>
                <span>@T("حجز سريع", "Quick Book")</span>
            </button>
            <a asp-action="Create"
               class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#49665A] hover:bg-[#3D574D] text-white inline-flex items-center gap-1.5 transition shadow-sm">
                <i class="fa-solid fa-calendar-plus"></i>
                <span>@T("نموذج كامل", "Full Form")</span>
            </a>
        </div>
    </div>

    @* ─── Stats Chips (click-to-filter) ─── *@
    @{
        int totalCount     = (int)(ViewBag.TotalAll ?? Model.Count());
        int pendingCount   = (int)(ViewBag.TotalPending ?? Model.Count(a => a.Status == "Pending"));
        int confirmedCount = (int)(ViewBag.TotalConfirmed ?? Model.Count(a => a.Status == "Confirmed"));
        int completedCount = (int)(ViewBag.TotalCompleted ?? Model.Count(a => a.Status == "Completed"));
        int cancelledCount = (int)(ViewBag.TotalCancelled ?? Model.Count(a => a.Status == "Cancelled"));

        string curStatus = ViewBag.CurrentStatus ?? "";
        string curSearch = ViewBag.CurrentSearch ?? "";
        int curDoctor    = ViewBag.CurrentDoctor ?? 0;
    }
    <div class="stats-row">
        <a class="stat-chip chip-all @(curStatus == "" ? "active-chip" : "")"
           asp-action="Index" asp-route-statusFilter="" asp-route-searchPatient="@curSearch" asp-route-doctorFilter="@(curDoctor > 0 ? curDoctor : "")">
            <div class="chip-icon"><i class="fa-solid fa-calendar-days"></i></div>
            <div><div class="chip-label">@T("الكل", "All")</div><div class="chip-count">@totalCount</div></div>
        </a>
        <a class="stat-chip chip-pending @(curStatus == "Pending" ? "active-chip" : "")"
           asp-action="Index" asp-route-statusFilter="Pending" asp-route-searchPatient="@curSearch" asp-route-doctorFilter="@(curDoctor > 0 ? curDoctor : "")">
            <div class="chip-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div><div class="chip-label">@T("قيد الانتظار", "Pending")</div><div class="chip-count">@pendingCount</div></div>
        </a>
        <a class="stat-chip chip-confirmed @(curStatus == "Confirmed" ? "active-chip" : "")"
           asp-action="Index" asp-route-statusFilter="Confirmed" asp-route-searchPatient="@curSearch" asp-route-doctorFilter="@(curDoctor > 0 ? curDoctor : "")">
            <div class="chip-icon"><i class="fa-solid fa-check-circle"></i></div>
            <div><div class="chip-label">@T("مؤكد", "Confirmed")</div><div class="chip-count">@confirmedCount</div></div>
        </a>
        <a class="stat-chip chip-completed @(curStatus == "Completed" ? "active-chip" : "")"
           asp-action="Index" asp-route-statusFilter="Completed" asp-route-searchPatient="@curSearch" asp-route-doctorFilter="@(curDoctor > 0 ? curDoctor : "")">
            <div class="chip-icon"><i class="fa-solid fa-flag-checkered"></i></div>
            <div><div class="chip-label">@T("مكتمل", "Completed")</div><div class="chip-count">@completedCount</div></div>
        </a>
        <a class="stat-chip chip-cancelled @(curStatus == "Cancelled" ? "active-chip" : "")"
           asp-action="Index" asp-route-statusFilter="Cancelled" asp-route-searchPatient="@curSearch" asp-route-doctorFilter="@(curDoctor > 0 ? curDoctor : "")">
            <div class="chip-icon"><i class="fa-solid fa-ban"></i></div>
            <div><div class="chip-label">@T("ملغى", "Cancelled")</div><div class="chip-count">@cancelledCount</div></div>
        </a>
    </div>

    @* ─── Filter Bar ─── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] rounded-2xl p-4 shadow-sm mb-6">
        <form method="get" asp-action="Index" class="flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-[220px]">
                <i class="fa-solid fa-magnifying-glass absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#8A9992] dark:text-[#727A76]"></i>
                <input type="text" name="searchPatient" value="@ViewBag.CurrentSearch"
                       placeholder="@T("ابحث باسم المريض أو الهاتف...", "Search by patient name or phone...")"
                       class="w-full ps-9 pe-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" />
            </div>
            <div class="w-full sm:w-auto min-w-[170px]">
                <select name="doctorFilter"
                        class="w-full px-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition">
                    <option value="">@T("جميع الأطباء", "All Doctors")</option>
                    @if (ViewBag.AllDoctors != null)
                    {
                        foreach (var doc in ViewBag.AllDoctors)
                        {
                            <option value="@doc.DoctorId" selected="@(ViewBag.CurrentDoctor == doc.DoctorId)">
                                @FormatDoctorName(doc.DoctorName)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="w-full sm:w-auto min-w-[150px]">
                <select name="statusFilter"
                        class="w-full px-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition">
                    <option value="">@T("جميع الحالات", "All Statuses")</option>
                    <option value="Pending"   selected="@(ViewBag.CurrentStatus == "Pending")">⏳ @T("قيد الانتظار", "Pending")</option>
                    <option value="Confirmed" selected="@(ViewBag.CurrentStatus == "Confirmed")">🔹 @T("مؤكد", "Confirmed")</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">✅ @T("مكتمل", "Completed")</option>
                    <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">❌ @T("ملغى", "Cancelled")</option>
                </select>
            </div>
            <div class="flex items-center gap-2 shrink-0 ms-auto">
                <button type="submit"
                        class="px-4 py-2 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-filter"></i>
                    <span>@T("تصفية", "Filter")</span>
                </button>
                <a asp-action="Index"
                   class="px-3.5 py-2 bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-medium rounded-xl transition flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>@T("إعادة تعيين", "Reset")</span>
                </a>
            </div>
        </form>
    </div>

    @* ─── Calendar View ─── *@
    <div id="calendarSection">
        <div class="calendar-card">
            <div id="appointmentCalendar"></div>
            <div class="cal-legend">
                <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div> @T("قيد الانتظار", "Pending")</div>
                <div class="legend-item"><div class="legend-dot" style="background:#3b82f6"></div> @T("مؤكد", "Confirmed")</div>
                <div class="legend-item"><div class="legend-dot" style="background:#10b981"></div> @T("مكتمل", "Completed")</div>
                <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div> @T("ملغى", "Cancelled")</div>
            </div>
        </div>
    </div>

    @* ─── List / Table View ─── *@
    <div id="listSection" style="display:none;">
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-start align-middle border-collapse">
                    <thead>
                        <tr class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[10px] uppercase tracking-wider text-[#5C6E66] dark:text-[#9CA8A3] font-semibold">
                            <th class="py-3 px-4 text-start font-semibold">@T("بيانات المريض", "Patient Details")</th>
                            <th class="py-3 px-4 text-start font-semibold">@T("الطبيب المسند", "Assigned Doctor")</th>
                            <th class="py-3 px-4 text-start font-semibold">@T("التاريخ والوقت", "Date & Time")</th>
                            <th class="py-3 px-4 text-start font-semibold">@T("الحالة", "Status")</th>
                            <th class="py-3 px-4 text-end font-semibold">@T("الإجراءات", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-12 text-[#6B7D75] dark:text-[#9CA8A3]">
                                    <i class="fa-regular fa-calendar-times text-3xl d-block mb-3 opacity-40"></i>
                                    <span class="text-xs">@T("لا توجد مواعيد مطابقة للمعايير الحالية.", "No appointments found matching the current criteria.")</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                string badgeClass = item.Status.ToLower() switch
                                {
                                    "confirmed" => "badge-confirmed",
                                    "completed" => "badge-completed",
                                    "cancelled" => "badge-cancelled",
                                    _ => "badge-pending"
                                };

                                <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                    <td class="py-3.5 px-4">
                                        <div class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold text-xs">@(item.Patient?.PatientName ?? "N/A")</div>
                                        <div class="text-[#6B7D75] dark:text-[#9CA8A3] text-[11px] mt-0.5"><i class="fa-solid fa-phone me-1"></i>@(item.Patient?.PhoneNumber ?? "N/A")</div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="text-[#1A2621] dark:text-[#EAEFEA] text-xs font-medium flex items-center gap-1.5">
                                            <i class="fa-solid fa-user-doctor text-[#49665A]"></i>
                                            <span>@FormatDoctorName(item.Doctor?.DoctorName)</span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="text-[#6B7D75] dark:text-[#9CA8A3] text-xs flex items-center gap-1">
                                            <i class="fa-regular fa-calendar me-1"></i>@item.AppointmentDate.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="text-[#6B7D75] dark:text-[#9CA8A3] text-xs mt-0.5 flex items-center gap-1">
                                            <i class="fa-regular fa-clock me-1"></i>@DateTime.Today.Add(item.AppointmentTime).ToString("hh:mm tt")
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        @if (item.Status == "Cancelled")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-[11px] font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> @T("ملغى", "Cancelled")
                                            </span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[11px] font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> @T("مكتمل", "Completed")
                                            </span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 text-[11px] font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> @T("مؤكد", "Confirmed")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-[11px] font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> @T("قيد الانتظار", "Pending")
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-1.5 justify-end flex-nowrap">

                                            @* ── Details link ─────────────────────────────── *@
                                            <a asp-action="Details" asp-route-id="@item.AppointmentId"
                                               class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] transition flex items-center gap-1.5"
                                               title="@T("تفاصيل", "Details")">
                                                <i class="fa-solid fa-eye text-[#49665A]"></i>
                                                @T("تفاصيل", "Details")
                                            </a>

                                            @* ── Edit / Reschedule link (Only for Pending or Confirmed) ───── *@
                                            @if (item.Status == "Pending" || item.Status == "Confirmed")
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.AppointmentId"
                                                   class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] transition flex items-center gap-1.5"
                                                   title="@T("تعديل / إعادة جدولة", "Edit / Reschedule")">
                                                    <i class="bi bi-pencil text-[#49665A] dark:text-emerald-400"></i>
                                                    @T("تعديل", "Edit")
                                                </a>
                                            }

                                            @* ── Complete & Bill (non-terminal statuses) ────── *@
                                            @if (item.Status != "Completed" && item.Status != "Cancelled")
                                            {
                                                <a asp-action="Complete" asp-route-id="@item.AppointmentId"
                                                   class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] inline-flex items-center gap-1.5 transition"
                                                   title="Complete &amp; Bill">
                                                    <i class="fa-solid fa-file-invoice-dollar text-[#49665A]"></i>Complete &amp; Bill
                                                </a>
                                            }

                                            @* ── Confirm button ─────────────────────────────── *@
                                            @if (item.Status != "Confirmed" && item.Status != "Completed" && item.Status != "Cancelled")
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.AppointmentId" />
                                                    <input type="hidden" name="newStatus" value="Confirmed" />
                                                    <button type="submit"
                                                            class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-emerald-600 dark:text-emerald-400 text-xs transition"
                                                            title="Confirm">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                </form>
                                            }

                                            @* ── Cancel button ─────────────────────────────── *@
                                            @if (item.Status != "Cancelled" && item.Status != "Completed")
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.AppointmentId" />
                                                    <input type="hidden" name="newStatus" value="Cancelled" />
                                                    <button type="submit"
                                                            class="w-7 h-7 flex items-center justify-center rounded-lg border border-rose-300 dark:border-rose-500/30 text-rose-500 hover:bg-rose-500/10 text-xs transition"
                                                            title="Cancel Appointment">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </form>
                                            }

                                            @* ── WhatsApp: Reminder (Pending / Confirmed) ────── *@
                                            @if (item.Status == "Pending" || item.Status == "Confirmed")
                                            {
                                                @if (!item.IsReminderSent)
                                                {
                                                    <form asp-action="SendQuickWhatsApp" method="post" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id"   value="@item.AppointmentId" />
                                                        <input type="hidden" name="type" value="reminder" />
                                                        <button type="submit"
                                                                class="bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs px-2.5 py-1 rounded-lg transition inline-flex items-center gap-1.5"
                                                                title="@T("إرسال تذكير واتسآب", "Send WhatsApp Reminder")">
                                                            <i class="fa-brands fa-whatsapp text-emerald-500 dark:text-emerald-400"></i>
                                                            @T("تذكير", "Reminder")
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3] text-xs px-2.5 py-1 rounded-lg inline-flex items-center gap-1.5 opacity-80"
                                                          title="@T("تم إرسال التذكير", "Reminder already sent")">
                                                        <i class="fa-brands fa-whatsapp text-emerald-500 dark:text-emerald-400"></i>
                                                        @T("تم التذكير", "Reminder Sent")
                                                    </span>
                                                }
                                            }

                                            @* ── WhatsApp: Follow-up (Completed) ───────────── *@
                                            @if (item.Status == "Completed")
                                            {
                                                @if (!item.IsFollowUpSent)
                                                {
                                                    <form asp-action="SendQuickWhatsApp" method="post" class="d-inline m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id"   value="@item.AppointmentId" />
                                                        <input type="hidden" name="type" value="followup" />
                                                        <button type="submit"
                                                                class="bg-[#202B27] border border-[#2B3833] text-[#EAEFEA] text-xs px-2.5 py-1 rounded-lg hover:bg-[#2B3833] transition inline-flex items-center gap-1.5"
                                                                title="@T("إرسال متابعة واتسآب", "Send WhatsApp Follow-up")">
                                                            <i class="fa-solid fa-link text-[#49665A]"></i>
                                                            @T("متابعة", "Follow-up")
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="bg-[#202B27] border border-[#2B3833] text-[#EAEFEA] text-xs px-2.5 py-1 rounded-lg inline-flex items-center gap-1.5"
                                                          title="@T("تمت المتابعة", "Follow-up already sent")">
                                                        <i class="fa-solid fa-check text-[#49665A]"></i>
                                                        @T("تمت المتابعة", "Follow-up Sent")
                                                    </span>
                                                }
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div><!-- end .page-container -->

