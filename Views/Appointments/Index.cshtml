@* ══════════════════════════════════════════════════════
   APPOINTMENT DETAILS DRAWER / OFFCANVAS (slide-over panel)
══════════════════════════════════════════════════════ *@
<partial name="_AppointmentDetailsPartial" />

@* ─── Tooltip element ─── *@
<div class="fc-event-tooltip" id="eventTooltip">
    <div class="tooltip-title" id="tt-title"></div>
    <div class="tooltip-row"><i class="fa-solid fa-user" style="width:14px;"></i><span id="tt-patient"></span></div>
    <div class="tooltip-row"><i class="fa-solid fa-user-doctor" style="width:14px;"></i><span id="tt-doctor"></span></div>
    <div class="tooltip-row"><i class="fa-regular fa-clock" style="width:14px;"></i><span id="tt-time"></span></div>
</div>

@section Scripts {
    <!-- FullCalendar -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/ar.global.min.js"></script>

    <script>
        /* ──────────────────────────────────
           Helpers: serialise current filters
           ────────────────────────────────── */
        const currentStatus = '@(ViewBag.CurrentStatus ?? "")';
        const currentDoctor = '@(ViewBag.CurrentDoctor ?? 0)';

        function calEventsUrl() {
            let url = '/Appointments/GetCalendarEvents?';
            if (currentStatus) url += `statusFilter=${encodeURIComponent(currentStatus)}&`;
            if (currentDoctor && currentDoctor !== '0') url += `doctorFilter=${currentDoctor}&`;
            return url;
        }

        /* ──────────────────────────────────
           FullCalendar init
           ────────────────────────────────── */
        let calendar;
        document.addEventListener('DOMContentLoaded', function () {
            const calEl = document.getElementById('appointmentCalendar');
            calendar = new FullCalendar.Calendar(calEl, {
                locale: 'ar',
                direction: 'rtl',
                initialView: 'dayGridMonth',
                height: 680,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                buttonText: {
                    today: 'اليوم',
                    month: 'شهر',
                    week: 'أسبوع',
                    day: 'يوم',
                    list: 'أجندة'
                },
                nowIndicator: true,
                navLinks: true,
                dayMaxEvents: 3,
                events: calEventsUrl(),
                eventClick: function (info) {
                    openEventPanel(info.event);
                },
                eventMouseEnter: function (info) {
                    showTooltip(info.event, info.jsEvent);
                },
                eventMouseLeave: function () {
                    hideTooltip();
                },
                eventClassNames: function (arg) {
                    if (arg.event.extendedProps && arg.event.extendedProps.status === 'Cancelled') {
                        return ['event-cancelled'];
                    }
                    return [];
                },
                eventDidMount: function (info) {
                    if (info.event.extendedProps && info.event.extendedProps.status === 'Cancelled') {
                        info.el.classList.add('event-cancelled');
                    }
                    // Add subtle pulse for today's events
                    const today = new Date();
                    const evDate = info.event.start;
                    if (evDate && evDate.toDateString() === today.toDateString()) {
                        info.el.style.boxShadow = '0 0 0 2px white, 0 0 0 4px ' + info.event.backgroundColor;
                    }
                },
                // Clicking on a blank date opens the modal with pre-filled date (blocked for past dates)
                dateClick: function (info) {
                    const selectedDate = new Date(info.dateStr);
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (selectedDate < today) {
                        // Do not open Quick Book Modal for past dates
                        return;
                    }

                    document.getElementById('qbDate').value = info.dateStr;
                    var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('quickBookModal'));
                    modal.show();
                },
                dayCellDidMount: function(arg) {
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (arg.date < today) {
                        arg.el.style.backgroundColor = '#f8f9fa';
                        arg.el.style.cursor = 'not-allowed';
                    }
                }
            });
            calendar.render();
        });

        /* ──────────────────────────────────
           View toggle (Calendar / List)
           ────────────────────────────────── */
        function switchView(view) {
            const calSec  = document.getElementById('calendarSection');
            const listSec = document.getElementById('listSection');
            const btnCal  = document.getElementById('btnCalView');
            const btnList = document.getElementById('btnListView');

            if (view === 'calendar') {
                if (calSec)  calSec.style.display  = 'block';
                if (listSec) listSec.style.display = 'none';
                if (btnCal)  btnCal.classList.add('active');
                if (btnList) btnList.classList.remove('active');
                if (typeof calendar !== 'undefined' && calendar) calendar.updateSize();
                localStorage.setItem('apptView', 'calendar');
            } else {
                if (calSec)  calSec.style.display  = 'none';
                if (listSec) listSec.style.display = 'block';
                if (btnList) btnList.classList.add('active');
                if (btnCal)  btnCal.classList.remove('active');
                localStorage.setItem('apptView', 'list');
            }
        }

        // Restore last chosen view
        window.addEventListener('DOMContentLoaded', function () {
            const saved = localStorage.getItem('apptView') || 'calendar';
            switchView(saved);
        });

        function formatDoctorTitle(name) {
            if (!name) return 'Unassigned';
            const clean = name.replace(/^(Dr\.\s*|د\.\s*)+/i, '').trim();
            return clean ? 'Dr. ' + clean : 'Unassigned';
        }

        /* ──────────────────────────────────
           Tooltip
           ────────────────────────────────── */
        const tooltip = document.getElementById('eventTooltip');

        function showTooltip(event, jsEvent) {
            document.getElementById('tt-title').textContent = event.title;
            document.getElementById('tt-patient').textContent = event.extendedProps.patientName;
            document.getElementById('tt-doctor').textContent = formatDoctorTitle(event.extendedProps.doctorName);
            const st = event.start;
            document.getElementById('tt-time').textContent = st ? st.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
            tooltip.classList.add('visible');
            moveTooltip(jsEvent);
        }

        function hideTooltip() { tooltip.classList.remove('visible'); }

        document.addEventListener('mousemove', function (e) {
            if (tooltip.classList.contains('visible')) moveTooltip(e);
        });

        function moveTooltip(e) {
            let x = e.clientX + 14;
            let y = e.clientY + 14;
            if (x + 240 > window.innerWidth)  x = e.clientX - 250;
            if (y + 120 > window.innerHeight) y = e.clientY - 130;
            tooltip.style.left = x + 'px';
            tooltip.style.top  = y + 'px';
        }

        /* ──────────────────────────────────
           Event Detail Panel
           ────────────────────────────────── */
        const isAr = @(_isAr ? "true" : "false");

        const statusBadgeMap = {
            'Pending':   `<span class="custom-badge badge-pending"><span class="status-dot"></span>${isAr ? 'قيد الانتظار' : 'Pending'}</span>`,
            'Confirmed': `<span class="custom-badge badge-confirmed"><span class="status-dot"></span>${isAr ? 'مؤكد' : 'Confirmed'}</span>`,
            'Completed': `<span class="custom-badge badge-completed"><span class="status-dot"></span>${isAr ? 'مكتمل' : 'Completed'}</span>`,
            'Cancelled': `<span class="custom-badge badge-cancelled"><span class="status-dot"></span>${isAr ? 'ملغي' : 'Cancelled'}</span>`,
        };

        function openEventPanel(event) {
            const p  = event.extendedProps;
            const st = event.start;
            const id = event.id;

            document.getElementById('ep-patient').textContent  = p.patientName;
            document.getElementById('ep-doctor').textContent   = formatDoctorTitle(p.doctorName);
            if (st) {
                const yyyy = st.getFullYear();
                const mm = String(st.getMonth() + 1).padStart(2, '0');
                const dd = String(st.getDate()).padStart(2, '0');
                let hours = st.getHours();
                const minutes = String(st.getMinutes()).padStart(2, '0');
                const ampm = hours >= 12 ? (isAr ? 'م' : 'PM') : (isAr ? 'ص' : 'AM');
                hours = hours % 12;
                hours = hours ? hours : 12;
                const hoursStr = String(hours).padStart(2, '0');

                const formattedDateTime = isAr
                    ? `${yyyy}/${mm}/${dd} · ${hoursStr}:${minutes} ${ampm}`
                    : `${dd} ${st.toLocaleString('en-US', { month: 'short' })} ${yyyy} · ${hoursStr}:${minutes} ${ampm}`;

                document.getElementById('ep-datetime').innerHTML =
                    `<span dir="ltr" class="d-inline-block text-secondary fw-semibold">${formattedDateTime}</span>`;
            } else {
                document.getElementById('ep-datetime').innerHTML =
                    '<span dir="ltr" class="d-inline-block text-secondary fw-semibold">—</span>';
            }
            document.getElementById('ep-status').innerHTML = statusBadgeMap[p.status] || p.status;

            const notesSection = document.getElementById('ep-notes-section');
            if (p.notes) {
                notesSection.style.display = 'block';
                document.getElementById('ep-notes').textContent = p.notes;
            } else {
                notesSection.style.display = 'none';
            }

            // Build action buttons (d-grid gap-2 mt-4 with Bootstrap 5 button classes)
            const actionsDiv = document.getElementById('ep-actions');
            actionsDiv.className = 'd-grid gap-2 mt-4';
            actionsDiv.innerHTML = '';

            const completeText = isAr ? 'إكمال وإصدار الفاتورة' : 'Complete & Bill';
            const confirmText  = isAr ? 'تأكيد الموعد' : 'Confirm Appointment';
            const cancelText   = isAr ? 'إلغاء الموعد' : 'Cancel Appointment';

            if (p.status !== 'Completed' && p.status !== 'Cancelled') {
                actionsDiv.innerHTML += `
                    <a href="/Appointments/Complete/${id}" class="btn btn-success fw-bold py-2 shadow-sm d-inline-flex align-items-center justify-content-center text-decoration-none">
                        <i class="bi bi-receipt me-1"></i> ${completeText}
                    </a>`;
            }
            if (p.status !== 'Confirmed' && p.status !== 'Completed' && p.status !== 'Cancelled') {
                actionsDiv.innerHTML += `
                    <form action="/Appointments/UpdateStatus" method="post" class="w-100 m-0 p-0">
                        <input type="hidden" name="__RequestVerificationToken" value="${getAntiForgeryToken()}" />
                        <input type="hidden" name="id" value="${id}" />
                        <input type="hidden" name="newStatus" value="Confirmed" />
                        <button type="submit" class="btn btn-primary fw-bold py-2 shadow-sm w-100 d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-check-circle me-1"></i> ${confirmText}
                        </button>
                    </form>`;
            }
            if (p.status !== 'Cancelled' && p.status !== 'Completed') {
                actionsDiv.innerHTML += `
                    <form action="/Appointments/UpdateStatus" method="post" class="w-100 m-0 p-0">
                        <input type="hidden" name="__RequestVerificationToken" value="${getAntiForgeryToken()}" />
                        <input type="hidden" name="id" value="${id}" />
                        <input type="hidden" name="newStatus" value="Cancelled" />
                        <button type="submit" class="btn btn-outline-danger fw-bold py-2 w-100 d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-x-circle me-1"></i> ${cancelText}
                        </button>
                    </form>`;
            }


            // Show panel + overlay
            document.getElementById('eventPanel').classList.add('open');
            document.getElementById('panelOverlay').classList.add('show');
        }

        function closeEventPanel() {
            document.getElementById('eventPanel').classList.remove('open');
            document.getElementById('panelOverlay').classList.remove('show');
        }

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        /* Pre-fill date when Quick Book modal opens */
        document.getElementById('quickBookModal').addEventListener('show.bs.modal', function () {
            if (!document.getElementById('qbDate').value) {
                const today = new Date();
                document.getElementById('qbDate').value = today.toISOString().split('T')[0];
            }
        });
    </script>
}