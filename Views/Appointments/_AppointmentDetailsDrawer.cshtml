@using System.Globalization
@using WebApplication1.Services
@{
    var _isAr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    Func<string, string, string> T = (ar, en) => _isAr ? ar : en;
    var isDoctor = User.IsInRole("Doctor") || User.IsDoctor();
    var canConsult = isDoctor || User.IsInRole("Admin") || User.IsOwner();
}

@* ══════════════════════════════════════════════════════
   APPOINTMENT DETAILS DRAWER / OFFCANVAS (slide-over panel)
══════════════════════════════════════════════════════ *@
<div id="panelOverlay" onclick="closeEventPanel()"></div>
<div id="eventPanel" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="ep-header">
        <h5><i class="fa-regular fa-calendar-check me-2 text-primary"></i>@T("تفاصيل الموعد", "Appointment Details")</h5>
        <button onclick="closeEventPanel()" style="background:none;border:none;font-size:20px;color:#94a3b8;cursor:pointer;" aria-label="@T("إغلاق", "Close")">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="ep-body">
        <div class="ep-field">
            <div class="ep-field-label">@T("المريض", "PATIENT")</div>
            <div class="ep-field-value" id="ep-patient">—</div>
        </div>
        <div class="ep-field">
            <div class="ep-field-label">@T("الطبيب", "DOCTOR")</div>
            <div class="ep-field-value" id="ep-doctor">—</div>
        </div>
        <div class="ep-field">
            <div class="ep-field-label">@T("التاريخ والوقت", "DATE & TIME")</div>
            <div class="ep-field-value" id="ep-datetime">
                <span dir="ltr" class="d-inline-block text-secondary fw-semibold">—</span>
            </div>
        </div>
        <div class="ep-field">
            <div class="ep-field-label">@T("الحالة", "STATUS")</div>
            <div id="ep-status">—</div>
        </div>
        <div class="ep-field" id="ep-notes-section" style="display:none;">
            <div class="ep-field-label">@T("الملاحظات", "NOTES")</div>
            <div class="ep-field-value" id="ep-notes" style="font-size:13px;color:#64748b;"></div>
        </div>

        <!-- Transferred / Clinical Referral Box -->
        <div id="ep-referral-box" class="p-3 my-2 rounded-xl border border-teal-200 dark:border-teal-800/70 bg-teal-50/70 dark:bg-teal-950/30 text-start" style="display:none;">
            <div class="mb-2">
                <span class="badge bg-teal-600 text-white px-2.5 py-1 text-xs fw-semibold rounded-pill d-inline-flex align-items-center gap-1">
                    <i class="fa-solid fa-share-from-square"></i>
                    <span id="ep-referral-badge-text">Transferred</span>
                </span>
            </div>
            <div class="text-[11px] fw-bold text-slate-700 dark:text-slate-300 mb-1">
                <i class="fa-solid fa-quote-left text-teal-600 dark:text-teal-400 me-1"></i>
                @T("سبب التحويل الطبي", "Clinical Reason / سبب التحويل الطبي")
            </div>
            <div id="ep-referral-reason" class="p-2 rounded-lg bg-white dark:bg-slate-900 border border-teal-100 dark:border-teal-900 text-xs text-slate-800 dark:text-slate-200 fst-italic">
            </div>
        </div>

        <!-- Doctor Confirmed Consultation Action Box (under STATUS / Referral section) -->
        <div id="ep-confirmed-consultation-box" class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-col gap-3" style="display:none;">
            <a id="ep-consultation-link" href="#"
               class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-sm transition text-decoration-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:20px;height:20px;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>@T("ابدأ المعاينة / Start Consultation", "Start Consultation / ابدأ المعاينة")</span>
            </a>

            <a id="ep-medical-record-link" href="#"
               class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-medium rounded-xl transition text-sm text-decoration-none">
                <span>@T("الملف الطبي / View Medical Record", "View Medical Record / الملف الطبي")</span>
            </a>
        </div>
    </div>
    <div class="px-4 pb-4">
        <div class="d-grid gap-2 mt-4" id="ep-actions">
            @if (canConsult)
            {
                <a id="ep-doctor-consult-btn" href="#" class="btn btn-success fw-bold py-2.5 shadow-sm d-inline-flex align-items-center justify-content-center text-decoration-none">
                    <i class="fa-solid fa-notes-medical me-1.5"></i> @T("ابدأ المعاينة / Start Consultation", "Start Consultation / ابدأ المعاينة")
                </a>
                <a id="ep-doctor-emr" href="#" class="btn btn-outline-secondary fw-bold py-2 shadow-sm d-inline-flex align-items-center justify-content-center text-decoration-none">
                    <i class="fa-solid fa-folder-open me-1.5"></i> @T("الملف الطبي / View Medical Record", "View Medical Record / الملف الطبي")
                </a>
                <button type="button" id="ep-doctor-refer-btn" class="btn btn-outline-success fw-bold py-2 shadow-sm d-inline-flex align-items-center justify-content-center" onclick="triggerDrawerReferral()">
                    <i class="fa-solid fa-share-from-square me-1"></i> @T("إحالة لعيادة أخرى", "Refer to Another Department")
                </button>
                <button type="button" class="btn btn-secondary fw-bold py-2 shadow-sm d-inline-flex align-items-center justify-content-center" onclick="closeEventPanel()">
                    <i class="fa-solid fa-xmark me-1"></i> @T("إغلاق", "Close")
                </button>
            }
            else
            {
                <button type="button" class="btn btn-success fw-bold py-2 shadow-sm">
                    <i class="bi bi-receipt me-1"></i> @T("إكمال وإصدار الفاتورة", "Complete & Bill")
                </button>
                <button type="button" class="btn btn-primary fw-bold py-2 shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> @T("تأكيد الموعد", "Confirm Appointment")
                </button>
                <button type="button" class="btn btn-outline-danger fw-bold py-2">
                    <i class="bi bi-x-circle me-1"></i> @T("إلغاء الموعد", "Cancel Appointment")
                </button>
            }
        </div>
    </div>
</div>

<script>
    function triggerDrawerReferral() {
        const patientName = document.getElementById('ep-patient')?.textContent || '';
        closeEventPanel();
        if (typeof openReferralModal === 'function') {
            openReferralModal(window.currentDrawerPatientId || 0, patientName);
        }
    }
</script>
