@model WebApplication1.Models.Appointment
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("بطاقة موعد - ", "Appointment Slip - ") + Model.AppointmentId;
    Layout = null; // Standalone printable slip

    var clinic = await SettingsService.GetSettingsAsync();
    var clinicName = !string.IsNullOrWhiteSpace(clinic.ClinicName) ? clinic.ClinicName : T("المركز الطبي", "Medical Center");
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
    var hasLogo = !string.IsNullOrWhiteSpace(clinic.LogoPath) && clinic.LogoPath != "/images/logo.png";

    var statusText = Model.Status switch
    {
        "Confirmed" => T("مؤكد", "Confirmed"),
        "Completed" => T("مكتمل", "Completed"),
        "Cancelled" => T("ملغى", "Cancelled"),
        _ => T("قيد الانتظار", "Pending")
    };
}

<!DOCTYPE html>
<html lang="@(_isAr ? "ar" : "en")" dir="@(_isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1a202c;
        }
        .slip-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
            padding: 36px 40px;
            margin-top: 30px;
            margin-bottom: 30px;
            border: 1px solid #e2e8f0;
            max-width: 720px;
            margin-left: auto;
            margin-right: auto;
        }
        .info-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 2px;
        }
        .info-value {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
        }
        .ticket-cutout {
            border-top: 2px dashed #cbd5e1;
            position: relative;
            margin: 28px 0;
        }
        @@media print {
            body {
                background-color: #fff !important;
                color: #0f172a !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .slip-card {
                box-shadow: none !important;
                border: 1px solid #94a3b8 !important;
                padding: 24px !important;
                margin: 0 auto !important;
                max-width: 100% !important;
            }
            img.clinic-logo-print {
                max-height: 64px !important;
                max-width: 180px !important;
                object-fit: contain !important;
                image-rendering: -webkit-optimize-contrast;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Screen-only top action bar -->
    <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-white rounded-3 shadow-sm border no-print max-w-xl mx-auto" style="max-width: 720px;">
        <a href="@Url.Action("Details", new { id = Model.AppointmentId })" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left @(_isAr ? "ms-1" : "me-1")"></i> @T("العودة للتفاصيل", "Back to Details")
        </a>
        <button onclick="window.print();" class="btn btn-primary px-4">
            <i class="fa-solid fa-print @(_isAr ? "ms-1" : "me-1")"></i> @T("طباعة البطاقة", "Print Slip")
        </button>
    </div>

    <!-- Official Appointment Slip Card -->
    <div class="slip-card">
        <!-- Clinic Branding Header -->
        <div class="row align-items-center mb-4 pb-3" style="border-bottom: 2px solid #0f172a;">
            <div class="col-sm-8">
                <div class="d-flex align-items-center gap-3">
                    @if (hasLogo)
                    {
                        <img src="@clinic.LogoPath" class="clinic-logo-print shrink-0" style="max-height: 64px; max-width: 180px; object-fit: contain;" alt="@clinicName" onerror="this.parentElement.innerHTML='<div style=\'width:48px;height:48px;border-radius:12px;background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.25);color:#059669;display:flex;align-items:center;justify-content:center;\' class=\'shrink-0\'><svg style=\'width:26px;height:26px;\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\' /></svg></div>'" />
                    }
                    else
                    {
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.25);color:#059669;display:flex;align-items:center;justify-content:center;" class="shrink-0">
                            <svg style="width:26px;height:26px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                    }
                    <div>
                        <h2 class="fw-bold mb-0 text-dark" style="font-size: 20px;">@clinicName</h2>
                        <p class="text-muted small mb-1">@T("بطاقة موعد ومراجعة طبية معتمدة", "Official Patient Appointment Pass")</p>
                        <!-- Contact info -->
                        <div class="small text-muted d-flex flex-wrap gap-3">
                            @if (!string.IsNullOrWhiteSpace(clinic.ClinicPhone))
                            {
                                <span><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1") text-success"></i><strong>@clinic.ClinicPhone</strong></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(clinic.ClinicAddress))
                            {
                                <span><i class="fa-solid fa-location-dot @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicAddress</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(clinic.ClinicEmail))
                            {
                                <span><i class="fa-solid fa-envelope @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicEmail</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4 @(_isAr ? "text-sm-start" : "text-sm-end") mt-3 mt-sm-0">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-bold text-uppercase">
                    @statusText
                </span>
                <div class="mt-2">
                    <span class="text-muted small">@T("رقم الموعد:", "Ticket #:")</span>
                    <span class="fw-bold fs-5 text-dark font-monospace">#@Model.AppointmentId</span>
                </div>
            </div>
        </div>

        <!-- Appointment Time Banner -->
        <div class="p-3 mb-4 rounded-3 text-center" style="background:#f1f5f9;border:1px solid #e2e8f0;">
            <div class="row g-2 align-items-center">
                <div class="col-sm-6 border-end-sm">
                    <div class="info-label"><i class="fa-regular fa-calendar @(_isAr ? "ms-1" : "me-1") text-primary"></i>@T("تاريخ الموعد", "Appointment Date")</div>
                    <div class="info-value text-primary fs-5">@Model.AppointmentDate.ToString("dddd, dd MMMM yyyy")</div>
                </div>
                <div class="col-sm-6">
                    <div class="info-label"><i class="fa-regular fa-clock @(_isAr ? "ms-1" : "me-1") text-primary"></i>@T("وقت الحضور المجدول", "Scheduled Time")</div>
                    <div class="info-value text-primary fs-5 font-monospace">@DateTime.Today.Add(Model.AppointmentTime).ToString("hh:mm tt")</div>
                </div>
            </div>
        </div>

        <!-- Patient & Doctor Info Grid -->
        <div class="row g-4 mb-3">
            <div class="col-sm-6">
                <div class="p-3 rounded-3 h-100" style="background:#fafafa;border:1px solid #f1f5f9;">
                    <div class="info-label mb-2"><i class="fa-solid fa-user-injured @(_isAr ? "ms-1" : "me-1") text-muted"></i>@T("بيانات المريض", "Patient Information")</div>
                    <div class="info-value mb-1">@Model.Patient?.PatientName</div>
                    <div class="small text-muted mb-1"><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1")"></i>@Model.Patient?.PhoneNumber</div>
                    <div class="small text-muted"><i class="fa-solid fa-id-card @(_isAr ? "ms-1" : "me-1")"></i>@T("الملف الطبي:", "Patient ID:") #@(Model.Patient?.PatientNumber ?? Model.PatientId.ToString())</div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="p-3 rounded-3 h-100" style="background:#fafafa;border:1px solid #f1f5f9;">
                    <div class="info-label mb-2"><i class="fa-solid fa-user-doctor @(_isAr ? "ms-1" : "me-1") text-muted"></i>@T("الطبيب والعيادة", "Doctor & Clinic")</div>
                    <div class="info-value mb-1">@(_isAr ? "د." : "Dr.") @Model.Doctor?.DoctorName</div>
                    <div class="small text-muted mb-1"><i class="fa-solid fa-stethoscope @(_isAr ? "ms-1" : "me-1")"></i>@Model.Doctor?.Specialization</div>
                    <div class="small text-muted">
                        <i class="fa-solid fa-receipt @(_isAr ? "ms-1" : "me-1")"></i>@T("رسوم الكشفية:", "Consultation Fee:") 
                        <strong class="text-dark">@((Model.Doctor?.ConsultationFee ?? 0).ToString("N2")) @currency</strong>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mb-3 p-3 rounded-3" style="background:#fffbeb;border:1px solid #fef3c7;">
                <div class="info-label text-amber-800 mb-1"><i class="fa-solid fa-note-sticky @(_isAr ? "ms-1" : "me-1")"></i>@T("ملاحظات الموعد", "Appointment Notes")</div>
                <div class="small text-dark">@Model.Notes</div>
            </div>
        }

        <!-- Dashed Divider -->
        <div class="ticket-cutout"></div>

        <!-- Instructions & Guidelines -->
        <div class="mb-4">
            <h6 class="fw-bold text-dark mb-2 small"><i class="fa-solid fa-circle-info @(_isAr ? "ms-1" : "me-1") text-primary"></i>@T("تعليمات الحضور للمركز الطبي", "Patient Instructions")</h6>
            <ul class="text-muted small ps-3 pe-3 mb-0 space-y-1">
                <li>@T("يرجى التواجد في العيادة قبل الموعد بـ 15 دقيقة لتأكيد الوصول.", "Please arrive 15 minutes before your scheduled appointment time.")</li>
                <li>@T("في حال الرغبة بإلغاء أو تأجيل الموعد، يرجى الاتصال بمركز الاستقبال مسبقاً.", "To reschedule or cancel, please contact our reception desk in advance.")</li>
                <li>@T("يرجى إبراز هذه البطاقة أو رقم الموعد عند مكتب الاستقبال.", "Please present this slip or mention your ticket ID at the reception.")</li>
            </ul>
        </div>

        <!-- Official Footer -->
        <div class="pt-3 border-top text-center text-muted small">
            <p class="mb-1">
                @T($"نتمنى لكم دوام الصحة والعافية — {clinicName}", $"Wishing you good health — {clinicName}")
            </p>
            <p class="mb-0 text-muted" style="font-size: 11px;">
                @T("تاريخ الطباعة:", "Printed on:") @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
            </p>
        </div>
    </div>
</div>

<script>
    // Auto-open print dialog when the page loads
    window.addEventListener('load', function () {
        setTimeout(function () { window.print(); }, 400);
    });
</script>
</body>
</html>
