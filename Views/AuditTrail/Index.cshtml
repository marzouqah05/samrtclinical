@model IEnumerable<WebApplication1.Models.AuditLog>
@using System.Globalization
@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("سجل تدقيق العمليات والأمان", "Audit Trail & Security Logs");

    int totalEvents = ViewBag.TotalEvents ?? 0;
    int todayEvents = ViewBag.TodayEvents ?? 0;
    int distinctUsers = ViewBag.DistinctUsers ?? 0;
    int criticalActions = ViewBag.CriticalActions ?? 0;

    var availableActions = ViewBag.AvailableActions as IEnumerable<string> ?? Enumerable.Empty<string>();
    var availableEntities = ViewBag.AvailableEntities as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="space-y-6" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── 1. Page Header Bar & Navigation Segment ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-6 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-[#49665A]/15 border border-[#49665A]/30 text-[#49665A] flex items-center justify-center text-xl shrink-0">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#49665A]">HIPAA & GDPR Compliance Log</span>
                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3]">Immutable Log</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0 mt-0.5">
                    @T("سجل تدقيق العمليات والنشاط الأمني", "Audit Trail & Security Event Logs")
                </h1>
                <p class="text-xs text-[#6B7D75] dark:text-[#9CA8A3] m-0 mt-1">
                    @T("تتبع شامل وتدقيق تاريخي لكافة العمليات الإدارية والسريرية مع توثيق هوية المستخدم والطوابع الزمنية",
                       "Comprehensive tracking of all administrative, clinical and financial modifications with timestamps and user identities")
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            @* Segmented View Switcher *@
            <div class="inline-flex items-center p-1 bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl gap-1">
                <a asp-controller="AuditTrail" asp-action="Index"
                   class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#49665A] text-white shadow-sm flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-list-check text-[11px]"></i>
                    <span>@T("سجل العمليات", "Audit Trail")</span>
                </a>
                <a asp-controller="Audit" asp-action="Sessions"
                   class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] hover:bg-[#EAEFEA] dark:hover:bg-[#1B2421] flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-users-viewfinder text-[11px]"></i>
                    <span>@T("جلسات المستخدمين", "Active Sessions")</span>
                </a>
            </div>

            <button type="button" onclick="window.print()"
                    class="bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-sm"
                    title="@T("طباعة سجل التدقيق", "Print Audit Log")">
                <i class="fa-solid fa-print text-[#6B7D75] dark:text-[#9CA8A3]"></i>
                <span>@T("طباعة", "Print")</span>
            </button>
        </div>
    </div>

    @* ── 2. Top Statistical KPI Metric Grid ── *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        @* Card 1: Total Audit Records *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("إجمالي العمليات الموثقة", "Total Audit Events")</span>
                <div class="w-8 h-8 rounded-xl bg-[#49665A]/10 text-[#49665A] border border-[#49665A]/20 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-database"></i>
                </div>
            </div>
            <div>
                <div class="text-2xl font-bold text-[#1A2621] dark:text-[#EAEFEA]">@totalEvents</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        <i class="fa-solid fa-shield-check text-[8px]"></i>
                        <span>@T("موثق بالكامل", "Verified")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("سجلات تاريخية", "historical records")</span>
                </div>
            </div>
        </div>

        @* Card 2: Today's Events *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("أحداث اليوم", "Today's Events")</span>
                <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">@todayEvents</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        <i class="fa-solid fa-circle-dot text-[8px]"></i>
                        <span>@T("اليوم الحقيقي", "Realtime")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("منذ منتصف الليل", "since midnight UTC")</span>
                </div>
            </div>
        </div>

        @* Card 3: Active Auditors & Staff *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("المستخدمين النشطين", "Distinct Operators")</span>
                <div class="w-8 h-8 rounded-xl bg-[#49665A]/10 text-[#49665A] border border-[#49665A]/20 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
            </div>
            <div>
                <div class="text-2xl font-bold text-[#1A2621] dark:text-[#EAEFEA]">@distinctUsers</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                        <i class="fa-solid fa-users text-[8px]"></i>
                        <span>@T("حسابات مصرحة", "Authorized")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("كادر العيادة", "clinic staff")</span>
                </div>
            </div>
        </div>

        @* Card 4: Critical Ops *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("العمليات الحساسة", "Critical Operations")</span>
                <div class="w-8 h-8 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>
            <div>
                <div class="text-2xl font-bold text-rose-600 dark:text-rose-400">@criticalActions</div>
                <div class="flex items-center gap-2 mt-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                        <i class="fa-solid fa-lock text-[8px]"></i>
                        <span>@T("تعديل / حذف", "Delete / Purge")</span>
                    </span>
                    <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("تتطلب تدقيقاً", "Requires review")</span>
                </div>
            </div>
        </div>

    </div>

    @* ── 3. Search & Filter Bar ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-4 shadow-sm">
        <form method="get" class="flex flex-wrap items-center gap-3 m-0">
            @* Search Text *@
            <div class="relative flex-1 min-w-[220px]">
                <i class="fa-solid fa-magnifying-glass absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#8A9992] dark:text-[#9CA8A3]"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="@T("البحث بالموظف، الإجراء، الكيان، أو التفاصيل...", "Search by user, action, entity, details...")"
                       class="w-full ps-9 pe-4 py-2 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] focus:ring-1 focus:ring-[#49665A] outline-none" />
            </div>

            @* Action Type Filter *@
            <div class="w-36">
                <select name="actionType" class="w-full py-2 px-3 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] focus:ring-1 focus:ring-[#49665A] outline-none">
                    <option value="">@T("جميع العمليات", "All Actions")</option>
                    @foreach (var act in availableActions)
                    {
                        <option value="@act" selected="@(ViewBag.ActionType == act)">@act</option>
                    }
                </select>
            </div>

            @* Entity Name Filter *@
            <div class="w-36">
                <select name="entityName" class="w-full py-2 px-3 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] focus:ring-1 focus:ring-[#49665A] outline-none">
                    <option value="">@T("جميع الكيانات", "All Entities")</option>
                    @foreach (var ent in availableEntities)
                    {
                        <option value="@ent" selected="@(ViewBag.EntityName == ent)">@ent</option>
                    }
                </select>
            </div>

            @* Date Range: From *@
            <div class="flex items-center gap-1.5 text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
                <span>@T("من:", "From:")</span>
                <input type="date" name="fromDate" value="@ViewBag.FromDate"
                       class="py-1.5 px-2.5 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] focus:ring-1 focus:ring-[#49665A] outline-none" />
            </div>

            @* Date Range: To *@
            <div class="flex items-center gap-1.5 text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
                <span>@T("إلى:", "To:")</span>
                <input type="date" name="toDate" value="@ViewBag.ToDate"
                       class="py-1.5 px-2.5 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] focus:ring-1 focus:ring-[#49665A] outline-none" />
            </div>

            @* Submit & Reset Buttons *@
            <div class="flex items-center gap-2">
                <button type="submit" class="px-4 py-2 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-filter text-[10px]"></i>
                    <span>@T("تصفية", "Filter")</span>
                </button>
                <a asp-action="Index" class="p-2 text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl transition" title="@T("إعادة تعيين", "Reset Filters")">
                    <i class="fa-solid fa-rotate-right text-xs"></i>
                </a>
            </div>
        </form>
    </div>

    @* ── 4. Audit Trail Table Container ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-list text-[#49665A] text-xs"></i>
                <h3 class="text-xs font-bold text-[#1A2621] dark:text-[#EAEFEA] uppercase tracking-wider m-0">
                    @T("سجل العمليات الإدارية والسريرية", "Clinical & System Audit Log")
                </h3>
            </div>
            <span class="px-2.5 py-0.5 rounded-md bg-[#F4F7F5] dark:bg-[#1B2421] border border-[#D5DDD8] dark:border-[#2B3833] text-[11px] font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">
                @(Model?.Count() ?? 0) @T("سجل معروض", "records displayed")
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs">
                <thead>
                    <tr class="bg-[#F4F7F5] dark:bg-[#151E1B]/50 border-b border-[#E5E9E7] dark:border-[#2B3833] text-[#5C6E66] dark:text-[#9CA8A3] uppercase tracking-wider text-[10px]">
                        <th class="py-3 px-4 text-start">@T("المستخدم / المنفذ", "Operator")</th>
                        <th class="py-3 px-3 text-start">@T("نوع الإجراء", "Action")</th>
                        <th class="py-3 px-3 text-start">@T("الكيان المستهدف", "Target Entity")</th>
                        <th class="py-3 px-3 text-center">@T("معرّف الكيان", "Entity ID")</th>
                        <th class="py-3 px-4 text-start">@T("تفاصيل العملية", "Event Details")</th>
                        <th class="py-3 px-4 text-end">@T("الطابع الزمني (UTC / المحلي)", "Timestamp")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E5E9E7] dark:divide-[#2B3833]">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-12 text-[#6B7D75] dark:text-[#9CA8A3]">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <i class="fa-solid fa-shield-halved text-2xl text-[#49665A]/40"></i>
                                    <span class="font-medium">@T("لا توجد سجلات تدقيق مطابقة لمعايير البحث الحالية.", "No audit log records match the current criteria.")</span>
                                    <span class="text-[11px] text-[#6B7D75] dark:text-[#727A76]">@T("يتم توثيق كافة العمليات في قاعدة البيانات تلقائياً.", "All actions and operations will automatically be tracked here.")</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var action = item.Action ?? "ACTION";
                            var actionUpper = action.ToUpperInvariant();

                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                @* User *@
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg bg-[#49665A]/20 border border-[#49665A]/30 text-[#49665A] font-bold text-xs flex items-center justify-center shrink-0">
                                            @((item.UserName?.Length > 0 ? item.UserName.Substring(0, 1).ToUpper() : "S"))
                                        </div>
                                        <div>
                                            <span class="font-semibold text-[#1A2621] dark:text-[#EAEFEA] block">@(item.UserName ?? "System")</span>
                                            @if (!string.IsNullOrEmpty(item.UserId))
                                            {
                                                <span class="text-[10px] text-[#6B7D75] dark:text-[#727A76] block font-mono">@item.UserId.Substring(0, Math.Min(8, item.UserId.Length))...</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                @* Action Badge *@
                                <td class="py-3 px-3 whitespace-nowrap">
                                    @if (actionUpper.Contains("CREATE") || actionUpper.Contains("INSERT") || actionUpper.Contains("ADD"))
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[10px] font-bold">
                                            <i class="fa-solid fa-plus text-[8px]"></i>
                                            <span>@action</span>
                                        </span>
                                    }
                                    else if (actionUpper.Contains("DELETE") || actionUpper.Contains("REMOVE") || actionUpper.Contains("PURGE"))
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-[10px] font-bold">
                                            <i class="fa-solid fa-trash-can text-[8px]"></i>
                                            <span>@action</span>
                                        </span>
                                    }
                                    else if (actionUpper.Contains("UPDATE") || actionUpper.Contains("EDIT") || actionUpper.Contains("MODIFY"))
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 text-[10px] font-bold">
                                            <i class="fa-solid fa-pen-to-square text-[8px]"></i>
                                            <span>@action</span>
                                        </span>
                                    }
                                    else if (actionUpper.Contains("SECURITY") || actionUpper.Contains("AUTH") || actionUpper.Contains("LOGIN"))
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 text-[10px] font-bold">
                                            <i class="fa-solid fa-key text-[8px]"></i>
                                            <span>@action</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#F4F7F5] dark:bg-[#151E1B] text-[#6B7D75] dark:text-[#9CA8A3] border border-[#D5DDD8] dark:border-[#2B3833] text-[10px] font-semibold">
                                            <i class="fa-solid fa-circle-info text-[8px]"></i>
                                            <span>@action</span>
                                        </span>
                                    }
                                </td>

                                @* Entity Name *@
                                <td class="py-3 px-3 whitespace-nowrap">
                                    <span class="px-2 py-0.5 rounded-md bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] font-semibold text-[11px]">
                                        @(item.EntityName ?? "General")
                                    </span>
                                </td>

                                @* Entity ID *@
                                <td class="py-3 px-3 whitespace-nowrap text-center">
                                    <span class="font-mono text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">
                                        @(item.EntityId ?? "—")
                                    </span>
                                </td>

                                @* Details *@
                                <td class="py-3 px-4">
                                    <span class="text-[#6B7D75] dark:text-[#9CA8A3] text-xs line-clamp-1" title="@item.Details">
                                        @(item.Details ?? "—")
                                    </span>
                                </td>

                                @* Timestamp *@
                                <td class="py-3 px-4 whitespace-nowrap text-end">
                                    <div class="text-[#1A2621] dark:text-[#EAEFEA] font-medium text-xs">
                                        @item.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm:ss")
                                    </div>
                                    <div class="text-[10px] text-[#6B7D75] dark:text-[#727A76] font-mono">
                                        UTC: @item.Timestamp.ToString("yyyy-MM-dd HH:mm")
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
