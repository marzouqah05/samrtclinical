@model IEnumerable<WebApplication1.Models.Expense>
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization
@using WebApplication1.Models
@using WebApplication1.Services

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("تقرير ملخص المصروفات", "Expenses Summary Report");
    Layout = null;

    var clinic = await SettingsService.GetSettingsAsync();
    var clinicName = !string.IsNullOrWhiteSpace(clinic.ClinicName) ? clinic.ClinicName : T("المركز الطبي", "Medical Center");
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
    var hasLogo = !string.IsNullOrWhiteSpace(clinic.LogoPath) && clinic.LogoPath != "/images/logo.png";

    decimal totalAmount = ViewBag.TotalAmount ?? Model.Sum(e => e.Amount);
    int totalCount = ViewBag.TotalCount ?? Model.Count();
    string periodTitle = _isAr ? (ViewBag.PeriodTitleAr ?? "جميع المصروفات") : (ViewBag.PeriodTitleEn ?? "All Expenses");

    string CategoryLabel(ExpenseCategory cat) => cat switch
    {
        ExpenseCategory.MedicalSupplies      => T("مستلزمات طبية", "Medical Supplies"),
        ExpenseCategory.EquipmentMaintenance => T("معدات وصيانة", "Equipment & Maintenance"),
        ExpenseCategory.RentUtilities        => T("إيجار وخدمات", "Rent & Utilities"),
        ExpenseCategory.Salaries             => T("رواتب وأجور", "Salaries & Wages"),
        ExpenseCategory.LabFees              => T("رسوم مختبر", "Lab Fees"),
        _                                   => T("أخرى", "Other")
    };

    string grandTotalWords = _isAr
        ? CurrencyWordConverter.ToArabicWords(totalAmount, currency == "JOD" ? "دينار أردني" : currency)
        : CurrencyWordConverter.ToEnglishWords(totalAmount, currency == "JOD" ? "Jordanian Dinars" : currency);
}

<!DOCTYPE html>
<html lang="@(_isAr ? "ar" : "en")" dir="@(_isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm;
        }

        body {
            background-color: #f8fafc;
            font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Tahoma, Geneva, Verdana, sans-serif;
            color: #0f172a;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .report-sheet {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            max-width: 980px;
            margin: 24px auto;
            padding: 36px 42px;
        }

        .report-header-bar {
            border-bottom: 2px solid #0f172a;
            padding-bottom: 16px;
            margin-bottom: 20px;
        }

        .meta-pill {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .report-table th {
            background-color: #f1f5f9 !important;
            color: #1e293b !important;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid #cbd5e1 !important;
            padding: 8px 10px;
        }

        .report-table td {
            font-size: 12px;
            color: #1e293b;
            border: 1px solid #e2e8f0 !important;
            padding: 8px 10px;
            vertical-align: middle;
        }

        .report-table tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }

        .summary-card {
            background: #f8fafc;
            border: 2px solid #059669;
            border-radius: 12px;
            padding: 16px 20px;
        }

        .signature-line {
            border-top: 1px solid #94a3b8;
            margin-top: 45px;
            padding-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #475569;
            text-align: center;
        }

        @@media print {
            body {
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .report-sheet {
                box-shadow: none !important;
                border: none !important;
                border-radius: 0 !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 10px 0 !important;
            }

            .no-print {
                display: none !important;
            }

            .report-table tr {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .summary-card,
            .signatures-section {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }
        }
    </style>
</head>
<body>

<div class="container py-3">
    <!-- Screen-only toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-white rounded-3 shadow-sm border no-print max-w-4xl mx-auto" style="max-width: 980px;">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm px-3">
            <i class="fa-solid fa-arrow-left @(_isAr ? "ms-1" : "me-1")"></i> @T("العودة للمصروفات", "Back to Expenses")
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print();" class="btn btn-primary btn-sm px-4 fw-semibold shadow-sm">
                <i class="fa-solid fa-print @(_isAr ? "ms-1" : "me-1")"></i> @T("طباعة التقرير", "Print Report")
            </button>
        </div>
    </div>

    <!-- Official Report Sheet -->
    <div class="report-sheet">
        <!-- Official Clinic Header -->
        <div class="report-header-bar">
            <div class="row align-items-center">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-3">
                        @if (hasLogo)
                        {
                            <img src="@clinic.LogoPath" style="height: 56px; width: auto; max-width: 160px; object-fit: contain;" alt="@clinicName" onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <div style="width:50px;height:50px;border-radius:12px;background:#059669;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;">
                                <i class="fa-solid fa-hospital"></i>
                            </div>
                        }
                        <div>
                            <h3 class="fw-bold mb-0 text-dark">@clinicName</h3>
                            <div class="text-muted small">@T("نظام التقارير المالية والإدارية المعتمد", "Official Financial & Management Reporting System")</div>
                            <div class="text-muted small mt-1 d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(clinic.ClinicPhone))
                                {
                                    <span><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1") text-success"></i>@clinic.ClinicPhone</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(clinic.ClinicAddress))
                                {
                                    <span><i class="fa-solid fa-location-dot @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicAddress</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-5 @(_isAr ? "text-start" : "text-end")">
                    <h4 class="fw-bold text-dark text-uppercase mb-1">
                        <i class="fa-solid fa-file-invoice-dollar @(_isAr ? "ms-1" : "me-1") text-success"></i>
                        @T("تقرير ملخص المصروفات", "Expenses Summary Report")
                    </h4>
                    <div class="text-success fw-bold font-monospace fs-6">
                        @periodTitle
                    </div>
                    <div class="text-muted small mt-1">
                        @T("تاريخ الطباعة:", "Print Date:") <strong class="text-dark">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Context Meta Tags -->
        <div class="d-flex flex-wrap items-center gap-2 mb-3">
            <span class="meta-pill">
                <i class="fa-solid fa-calendar-days text-success"></i>
                <strong>@T("الفترة:", "Period:")</strong> @periodTitle
            </span>
            @if (!string.IsNullOrWhiteSpace(ViewBag.FilterCategory as string))
            {
                <span class="meta-pill">
                    <i class="fa-solid fa-tag text-primary"></i>
                    <strong>@T("الفئة:", "Category:")</strong> @ViewBag.FilterCategory
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(ViewBag.FilterSearch as string))
            {
                <span class="meta-pill">
                    <i class="fa-solid fa-magnifying-glass text-secondary"></i>
                    <strong>@T("البحث:", "Search:")</strong> "@ViewBag.FilterSearch"
                </span>
            }
            <span class="meta-pill ms-auto">
                <i class="fa-solid fa-list-check text-dark"></i>
                <strong>@T("عدد السجلات:", "Records Count:")</strong> @totalCount
            </span>
        </div>

        <!-- Tabular Records Table -->
        <div class="table-responsive my-3">
            <table class="table table-bordered report-table mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 5%">#</th>
                        <th style="width: 12%">@T("التاريخ", "Date")</th>
                        <th style="width: 16%">@T("الفئة", "Category")</th>
                        <th style="width: 20%">@T("المورد / المستلم", "Vendor / Payee")</th>
                        <th style="width: 25%">@T("البيان / الوصف", "Description")</th>
                        <th style="width: 10%">@T("الدفع", "Payment")</th>
                        <th class="@(_isAr ? "text-start" : "text-end")" style="width: 12%">@T("المبلغ", "Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                @T("لا توجد مصروفات مسجلة مطابقة لمعايير الفلترة المحددة.", "No expenses found matching the selected filter criteria.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var exp in Model)
                        {
                            <tr>
                                <td class="text-center font-monospace text-muted">@(index++)</td>
                                <td class="font-monospace">@exp.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="fw-semibold">@CategoryLabel(exp.Category)</span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(exp.VendorOrPayee) ? "—" : exp.VendorOrPayee)</td>
                                <td>
                                    <div class="fw-semibold">@exp.Title</div>
                                    @if (!string.IsNullOrEmpty(exp.Notes))
                                    {
                                        <small class="text-muted d-block">@exp.Notes</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @exp.PaymentMethod
                                    </span>
                                </td>
                                <td class="@(_isAr ? "text-start" : "text-end") font-monospace fw-bold text-dark">
                                    @exp.Amount.ToString("N2") <small class="text-muted fw-normal">@currency</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary Totals Box -->
        <div class="summary-card my-4">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #d1fae5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="fa-solid fa-coins"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">@T("إجمالي المصروفات للفترة", "Grand Total For Period")</div>
                            <div class="fs-3 fw-bold text-success font-monospace">
                                @totalAmount.ToString("N2") <span class="fs-5 fw-semibold">@currency</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 @(_isAr ? "text-start" : "text-end") mt-2 mt-sm-0">
                    <div class="text-muted small fw-semibold">@T("المبلغ الإجمالي كتابةً:", "Total in Words:")</div>
                    <div class="fw-bold text-dark font-monospace" style="font-size: 13px;">
                        @grandTotalWords
                    </div>
                    <div class="text-muted small mt-1">
                        @T("إجمالي عدد سندات الصرف:", "Total Number of Records:") <strong>@totalCount</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Official Signatures Section -->
        <div class="signatures-section mt-5 pt-3">
            <div class="row g-4">
                <div class="col-4">
                    <div class="signature-line">
                        @T("المراجع المالي / المحاسب المسؤول", "Financial Auditor / Accountant")
                    </div>
                </div>
                <div class="col-4">
                    <div class="signature-line">
                        @T("المدير المالي والإداري", "Finance & Admin Director")
                    </div>
                </div>
                <div class="col-4">
                    <div class="signature-line">
                        @T("اعتماد الإدارة والختم الرسمي", "Management Approval & Official Stamp")
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="mt-5 pt-3 border-top text-center text-muted" style="font-size: 11px;">
            <p class="mb-0">
                @T($"تم استخراج هذا التقرير تلقائياً من المنظومة المحاسبية لـ {clinicName}.",
                   $"This report was generated automatically from the financial accounting system of {clinicName}.")
                <span class="font-monospace text-secondary ms-2">@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </p>
        </div>
    </div>
</div>

<script>
    window.addEventListener('load', function () {
        setTimeout(function () {
            window.print();
        }, 400);
    });
</script>

</body>
</html>
