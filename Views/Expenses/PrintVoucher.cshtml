@model WebApplication1.Models.Expense
@inject WebApplication1.Services.ISettingsService SettingsService
@using System.Globalization
@using WebApplication1.Models
@using WebApplication1.Services

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("سند صرف مالي - ", "Payment Voucher - ") + $"#PV-{Model.ExpenseDate:yyyyMM}-{Model.Id:D4}";
    Layout = null;

    var clinic = await SettingsService.GetSettingsAsync();
    var clinicName = !string.IsNullOrWhiteSpace(clinic.ClinicName) ? clinic.ClinicName : T("المركز الطبي", "Medical Center");
    var currency = !string.IsNullOrWhiteSpace(clinic.CurrencySymbol) ? clinic.CurrencySymbol : "JOD";
    var hasLogo = !string.IsNullOrWhiteSpace(clinic.LogoPath) && clinic.LogoPath != "/images/logo.png";

    string CategoryLabel(ExpenseCategory cat) => cat switch
    {
        ExpenseCategory.MedicalSupplies      => T("مستلزمات طبية", "Medical Supplies"),
        ExpenseCategory.EquipmentMaintenance => T("معدات وصيانة", "Equipment & Maintenance"),
        ExpenseCategory.RentUtilities        => T("إيجار وخدمات", "Rent & Utilities"),
        ExpenseCategory.Salaries             => T("رواتب وأجور", "Salaries & Wages"),
        ExpenseCategory.LabFees              => T("رسوم مختبر", "Lab Fees"),
        _                                   => T("مصروفات أخرى", "Other Expenses")
    };

    string amountWords = _isAr
        ? CurrencyWordConverter.ToArabicWords(Model.Amount, currency == "JOD" ? "دينار أردني" : currency)
        : CurrencyWordConverter.ToEnglishWords(Model.Amount, currency == "JOD" ? "Jordanian Dinars" : currency);
}

<!DOCTYPE html>
<html lang="@(_isAr ? "ar" : "en")" dir="@(_isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <style>
        @@page {
            size: A4 portrait;
            margin: 12mm 15mm;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Tahoma, Geneva, Verdana, sans-serif;
            color: #0f172a;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .voucher-sheet {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            max-width: 820px;
            margin: 24px auto;
            padding: 36px 42px;
            position: relative;
        }

        .voucher-header-bar {
            border-bottom: 2px solid #0f172a;
            padding-bottom: 18px;
            margin-bottom: 24px;
        }

        .voucher-ref-pill {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 16px;
            display: inline-block;
        }

        .amount-highlight-box {
            background: #ecfdf5;
            border: 2px dashed #059669;
            border-radius: 12px;
            padding: 16px 20px;
            margin: 20px 0;
        }

        .data-table-voucher th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            width: 28%;
            border-color: #e2e8f0;
            padding: 10px 14px;
        }

        .data-table-voucher td {
            font-size: 13px;
            color: #0f172a;
            border-color: #e2e8f0;
            padding: 10px 14px;
            vertical-align: middle;
        }

        .signature-box {
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            padding: 14px 16px;
            background: #fafafa;
            min-height: 120px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .stamp-box {
            border: 2px dashed #94a3b8;
            border-radius: 12px;
            padding: 12px;
            background: #ffffff;
            min-height: 120px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        @@media print {
            body {
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .voucher-sheet {
                box-shadow: none !important;
                border: 1px solid #94a3b8 !important;
                border-radius: 8px !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 24px 28px !important;
            }

            img.clinic-logo-print {
                max-height: 64px !important;
                max-width: 180px !important;
                object-fit: contain !important;
                image-rendering: -webkit-optimize-contrast;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

<div class="container py-3">
    <!-- Screen-only toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-white rounded-3 shadow-sm border no-print max-w-2xl mx-auto" style="max-width: 820px;">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm px-3">
            <i class="fa-solid fa-arrow-left @(_isAr ? "ms-1" : "me-1")"></i> @T("العودة للمصروفات", "Back to Expenses")
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print();" class="btn btn-success btn-sm px-4 fw-semibold shadow-sm">
                <i class="fa-solid fa-print @(_isAr ? "ms-1" : "me-1")"></i> @T("طباعة سند الصرف", "Print Payment Voucher")
            </button>
        </div>
    </div>

    <!-- Official Voucher Printable Card -->
    <div class="voucher-sheet">
        <!-- Official Clinic Header -->
        <div class="voucher-header-bar" style="border-bottom: 2px solid #0f172a; padding-bottom: 18px; margin-bottom: 24px;">
            <div class="row align-items-center">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-3">
                        @if (hasLogo)
                        {
                            <img src="@clinic.LogoPath" class="clinic-logo-print shrink-0" style="max-height: 64px; max-width: 180px; object-fit: contain;" alt="@clinicName" onerror="this.parentElement.innerHTML='<div style=\'width:48px;height:48px;border-radius:12px;background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.25);color:#059669;display:flex;align-items:center;justify-content:center;\' class=\'shrink-0\'><svg style=\'width:26px;height:26px;\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4\' /></svg></div>'" />
                        }
                        else
                        {
                            <div style="width:48px;height:48px;border-radius:12px;background:rgba(5,150,105,0.1);border:1px solid rgba(5,150,105,0.25);color:#059669;display:flex;align-items:center;justify-content:center;" class="shrink-0">
                                <svg style="width:26px;height:26px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                            </div>
                        }
                        <div>
                            <h2 class="fw-bold mb-0 text-dark" style="font-size: 20px;">@clinicName</h2>
                            <div class="text-muted small fw-medium">@T("نظام الإدارة المالية والعيادات المعتمد", "Official Financial & Clinical Management")</div>
                            <div class="text-muted small mt-1 d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(clinic.ClinicPhone))
                                {
                                    <span><i class="fa-solid fa-phone @(_isAr ? "ms-1" : "me-1") text-success"></i><strong>@clinic.ClinicPhone</strong></span>
                                }
                                @if (!string.IsNullOrWhiteSpace(clinic.ClinicAddress))
                                {
                                    <span><i class="fa-solid fa-location-dot @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicAddress</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(clinic.ClinicEmail))
                                {
                                    <span><i class="fa-solid fa-envelope @(_isAr ? "ms-1" : "me-1") text-secondary"></i>@clinic.ClinicEmail</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-5 @(_isAr ? "text-start" : "text-end")">
                    <div class="voucher-ref-pill">
                        <div class="text-uppercase fw-bold text-success" style="font-size: 15px; letter-spacing: 0.5px;">
                            <i class="fa-solid fa-file-invoice-dollar @(_isAr ? "ms-1" : "me-1")"></i>
                            @T("سند صرف مالي", "PAYMENT VOUCHER")
                        </div>
                        <div class="small text-muted mt-1">
                            @T("الرقم المرجعي:", "Voucher Ref:") 
                            <strong class="text-dark font-monospace">#PV-@Model.ExpenseDate.ToString("yyyyMM")-@Model.Id.ToString("D4")</strong>
                        </div>
                        <div class="small text-muted">
                            @T("التاريخ:", "Date:") 
                            <strong class="text-dark">@Model.ExpenseDate.ToString("yyyy-MM-dd")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Highlighted Amount Banner -->
        <div class="amount-highlight-box">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <span class="text-uppercase small fw-bold text-success-emphasis">
                        @T("المبلغ المصروف:", "Disbursed Amount:")
                    </span>
                    <div class="fs-3 fw-bold text-success">
                        @Model.Amount.ToString("N2") <span class="fs-5 fw-semibold">@currency</span>
                    </div>
                </div>
                <div class="@(_isAr ? "text-start" : "text-end") flex-grow-1 ps-sm-4 pe-sm-4">
                    <div class="text-muted small fw-semibold">@T("فقط وقدره بالكلمات:", "Amount in Words:")</div>
                    <div class="fw-bold text-dark font-monospace" style="font-size: 14px;">
                        @amountWords
                    </div>
                </div>
            </div>
        </div>

        <!-- Voucher Details Table -->
        <div class="table-responsive my-3">
            <table class="table table-bordered data-table-voucher mb-0">
                <tbody>
                    <tr>
                        <th>@T("يُصرف إلى السيد / الجهة", "Paid To / Vendor Name")</th>
                        <td class="fw-bold text-primary fs-6">
                            @(string.IsNullOrWhiteSpace(Model.VendorOrPayee) ? T("غير محدد", "Unspecified") : Model.VendorOrPayee)
                        </td>
                    </tr>
                    <tr>
                        <th>@T("عنوان / بيان المصروف", "Expense Title / Description")</th>
                        <td class="fw-semibold">
                            @Model.Title
                        </td>
                    </tr>
                    <tr>
                        <th>@T("التصنيف / فئة المصروف", "Category")</th>
                        <td>
                            <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-semibold">
                                @CategoryLabel(Model.Category)
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>@T("طريقة السداد", "Payment Method")</th>
                        <td>
                            @if (Model.PaymentMethod == "Cash")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="fa-solid fa-money-bill-wave @(_isAr ? "ms-1" : "me-1")"></i> @T("نقداً (كاش)", "Cash")
                                </span>
                            }
                            else if (Model.PaymentMethod == "Credit Card")
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                    <i class="fa-solid fa-credit-card @(_isAr ? "ms-1" : "me-1")"></i> @T("بطاقة دفع إلكتروني", "Credit Card")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                    <i class="fa-solid fa-building-columns @(_isAr ? "ms-1" : "me-1")"></i> @T("حوالة / شيك بنكي", "Bank Transfer")
                                </span>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <tr>
                            <th>@T("ملاحظات / الغرض من الصرف", "Notes / Purpose")</th>
                            <td class="text-secondary">
                                @Model.Notes
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Official Signatures & Stamping Section -->
        <div class="mt-4 pt-2">
            <h6 class="fw-bold text-dark mb-3 text-uppercase" style="font-size: 12px; letter-spacing: 0.5px;">
                <i class="fa-solid fa-signature @(_isAr ? "ms-1" : "me-1") text-success"></i>
                @T("التواقيع الرسمية والاعتماد", "Official Signatures & Approval")
            </h6>
            <div class="row g-3">
                <!-- Prepared By -->
                <div class="col-4">
                    <div class="signature-box">
                        <div class="fw-bold small text-secondary">
                            @T("إعداد المحاسب / أمين الصندوق", "Prepared By (Accountant)")
                        </div>
                        <div class="mt-4 pt-3 border-top text-muted small">
                            <div>@T("الاسم:", "Name:") ....................................</div>
                            <div class="mt-1">@T("التوقيع:", "Signature:") ................................</div>
                        </div>
                    </div>
                </div>

                <!-- Received By -->
                <div class="col-4">
                    <div class="signature-box">
                        <div class="fw-bold small text-secondary">
                            @T("توقيع المستلم", "Received By (Payee)")
                        </div>
                        <div class="mt-4 pt-3 border-top text-muted small">
                            <div>@T("المستلم:", "Payee:") @(string.IsNullOrWhiteSpace(Model.VendorOrPayee) ? "..................." : Model.VendorOrPayee)</div>
                            <div class="mt-1">@T("التوقيع:", "Signature:") ................................</div>
                        </div>
                    </div>
                </div>

                <!-- Manager Approval & Stamp -->
                <div class="col-4">
                    <div class="stamp-box">
                        <div class="fw-bold small text-dark mb-1">
                            @T("اعتماد وختم الإدارة", "Manager Approval & Stamp")
                        </div>
                        <div class="text-muted" style="font-size: 11px;">
                            <i class="fa-solid fa-stamp text-secondary fs-4 d-block my-1"></i>
                            <span>@T("مساحة الختم الورقي الرسمي", "Official Clinic Stamp Area")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Notice -->
        <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 11px;">
            <p class="mb-0">
                @T("سند صرف مالي إلكتروني معتمد ومسجل في النظام المحاسبي للعيادة.",
                   "Official electronic payment voucher registered in the clinic financial management system.")
                <span class="font-monospace text-secondary ms-2">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</span>
            </p>
        </div>
    </div>
</div>

<script>
    window.addEventListener('load', function () {
        setTimeout(function () {
            window.print();
        }, 400);
    });
</script>

</body>
</html>
