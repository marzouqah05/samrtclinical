@model IEnumerable<WebApplication1.Models.Expense>
@using System.Globalization
@using WebApplication1.Models

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إدارة المصروفات", "Expense Management");

    decimal totalIncome   = ViewBag.TotalIncome   ?? 0m;
    decimal totalExpenses = ViewBag.TotalExpenses  ?? 0m;
    decimal netProfit     = ViewBag.NetProfit      ?? 0m;
    int     currentPage   = ViewBag.CurrentPage    ?? 1;
    int     totalPages    = ViewBag.TotalPages     ?? 1;
    int     totalCount    = ViewBag.TotalCount     ?? 0;

    string currency = "JOD";
    var categories = Enum.GetValues<ExpenseCategory>();

    string CategoryLabel(ExpenseCategory cat) => cat switch
    {
        ExpenseCategory.MedicalSupplies      => T("مستلزمات طبية", "Medical Supplies"),
        ExpenseCategory.EquipmentMaintenance => T("معدات وصيانة", "Equipment & Maintenance"),
        ExpenseCategory.RentUtilities        => T("إيجار وخدمات", "Rent & Utilities"),
        ExpenseCategory.Salaries             => T("رواتب", "Salaries"),
        ExpenseCategory.LabFees              => T("رسوم مختبر", "Lab Fees"),
        _                                   => T("أخرى", "Other")
    };

    string CategoryIcon(ExpenseCategory cat) => cat switch
    {
        ExpenseCategory.MedicalSupplies      => "fa-kit-medical text-emerald-400",
        ExpenseCategory.EquipmentMaintenance => "fa-screwdriver-wrench text-amber-400",
        ExpenseCategory.RentUtilities        => "fa-building text-sky-400",
        ExpenseCategory.Salaries             => "fa-users text-indigo-400",
        ExpenseCategory.LabFees              => "fa-flask text-violet-400",
        _                                   => "fa-circle-dot text-[#9CA8A3]"
    };
}

<div class="max-w-7xl mx-auto px-4 py-8 space-y-6" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Toast container ── *@
    @if (TempData["Success"] != null)
    {
        <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-sm shrink-0"></i>
                <div><strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]</div>
            </div>
            <button type="button" class="text-emerald-400 hover:text-emerald-300 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-exclamation text-sm shrink-0"></i>
                <div><strong>@T("خطأ:", "Error:")</strong> @TempData["Error"]</div>
            </div>
            <button type="button" class="text-rose-400 hover:text-rose-300 text-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    @* ── Header Card ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-6 shadow-sm flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-[#49665A]/15 border border-[#49665A]/30 text-[#49665A] flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-money-bill-trend-up"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0">@T("إدارة المصروفات والمالية", "Expense & Financial Management")</h1>
                <p class="text-xs text-[#6B7D75] dark:text-[#9CA8A3] m-0 mt-0.5">
                    @T("تتبع جميع مصروفات العيادة، مقارنة الإيرادات، وتصدير التقارير المالية المعتمدة",
                       "Track all clinic expenses, compare with revenue, and export financial reports")
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
            <a href="@Url.Action("ExportExcel", new { search=ViewBag.Search, category=ViewBag.Category, dateRange=ViewBag.DateRange, dateFrom=ViewBag.DateFrom, dateTo=ViewBag.DateTo })"
               class="bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-file-excel text-emerald-500"></i>
                <span>@T("تصدير Excel", "Export Excel")</span>
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
            {
                <button type="button" class="bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold px-4 py-2 rounded-xl transition flex items-center gap-2 shadow-sm"
                        onclick="openCreateModal()">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>@T("إضافة مصروف", "Add Expense")</span>
                </button>
            }
        </div>
    </div>

    @* ── KPI Cards ── *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        @* Revenue *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("إجمالي الإيرادات", "Total Revenue")</span>
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
            </div>
            <div>
                <div class="text-xl sm:text-2xl font-bold text-emerald-600 dark:text-emerald-400">
                    @totalIncome.ToString("N2") <span class="text-xs font-normal text-[#6B7D75] dark:text-[#9CA8A3]">@currency</span>
                </div>
                <div class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] mt-1">@T("من الفواتير المسددة", "From paid invoices")</div>
            </div>
        </div>

        @* Expenses *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("إجمالي المصروفات", "Total Expenses")</span>
                <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-500 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-arrow-trend-down"></i>
                </div>
            </div>
            <div>
                <div class="text-xl sm:text-2xl font-bold text-rose-600 dark:text-rose-400">
                    @totalExpenses.ToString("N2") <span class="text-xs font-normal text-[#6B7D75] dark:text-[#9CA8A3]">@currency</span>
                </div>
                <div class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] mt-1">@T("سجلات الفلتر الحالي", "Records in current filter")</div>
            </div>
        </div>

        @* Net Profit *@
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[#6B7D75] dark:text-[#9CA8A3]">@T("صافي الأرباح", "Net Profit / Loss")</span>
                <div class="w-8 h-8 rounded-lg bg-[#49665A]/20 text-[#49665A] flex items-center justify-center text-xs">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
            </div>
            <div>
                <div class="text-xl sm:text-2xl font-bold @(netProfit >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                    @(netProfit >= 0 ? "+" : "")@netProfit.ToString("N2") <span class="text-xs font-normal text-[#6B7D75] dark:text-[#9CA8A3]">@currency</span>
                </div>
                <div class="text-[11px] mt-1 @(netProfit >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                    @if (netProfit >= 0)
                    {
                        <span><i class="fa-solid fa-circle-check me-1"></i>@T("في المنطقة الربحية", "In profit zone")</span>
                    }
                    else
                    {
                        <span><i class="fa-solid fa-triangle-exclamation me-1"></i>@T("المصروفات تتجاوز الإيرادات", "Expenses exceed revenue")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Filters Card ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl p-4 sm:p-5 shadow-sm">
        <form method="get" asp-action="Index" id="filterForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                @* Search *@
                <div class="sm:col-span-4">
                    <label class="block text-[11px] font-semibold text-[#5C6E66] dark:text-[#9CA8A3] uppercase tracking-wider mb-1.5">
                        @T("بحث", "Search")
                    </label>
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#8A9992] dark:text-[#727A76]"></i>
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="w-full ps-9 pe-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] text-xs focus:ring-1 focus:ring-[#49665A] transition"
                               placeholder="@T("بحث في العنوان أو المورد...","Search title or vendor...")" />
                    </div>
                </div>

                @* Category *@
                <div class="sm:col-span-3">
                    <label class="block text-[11px] font-semibold text-[#5C6E66] dark:text-[#9CA8A3] uppercase tracking-wider mb-1.5">
                        @T("الفئة", "Category")
                    </label>
                    <select name="category"
                            class="w-full px-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] transition">
                        <option value="">@T("جميع الفئات", "All Categories")</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat" selected="@(ViewBag.Category == cat.ToString())">
                                @CategoryLabel(cat)
                            </option>
                        }
                    </select>
                </div>

                @* Date Range Pills *@
                <div class="sm:col-span-5">
                    <label class="block text-[11px] font-semibold text-[#5C6E66] dark:text-[#9CA8A3] uppercase tracking-wider mb-1.5">
                        @T("الفترة الزمنية", "Date Range")
                    </label>
                    @{
                        var dr = ViewBag.DateRange as string ?? "";
                    }
                    <input type="hidden" name="dateRange" id="hidDateRange" value="@dr" />
                    <div class="flex items-center gap-1.5 flex-wrap">
                        @foreach (var (val, ar, en) in new[] {
                            ("today",      "اليوم",      "Today"),
                            ("this_week",  "هذا الأسبوع","This Week"),
                            ("this_month", "هذا الشهر",  "This Month"),
                            ("this_year",  "هذا العام",  "This Year"),
                            ("custom",     "تخصيص",      "Custom")
                        })
                        {
                            <button type="button"
                                    class="date-pill px-2.5 py-1 rounded-lg text-xs font-medium transition @(dr == val ? "bg-[#49665A] text-white shadow-sm" : "bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA]")"
                                    onclick="setDateRange('@val')">
                                @(_isAr ? ar : en)
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* Custom date range (shown only when custom is active) *@
            <div id="customDateRow" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-[#E5E9E7] dark:border-[#2B3833] @(dr == "custom" ? "" : "hidden")">
                <div>
                    <label class="block text-xs font-semibold text-[#5C6E66] dark:text-[#9CA8A3] mb-1">@T("من تاريخ", "From Date")</label>
                    <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                           class="w-full px-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-[#5C6E66] dark:text-[#9CA8A3] mb-1">@T("إلى تاريخ", "To Date")</label>
                    <input type="date" name="dateTo" value="@ViewBag.DateTo"
                           class="w-full px-3.5 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F8FAF9] dark:bg-[#151E1B] text-[#1A2621] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] transition" />
                </div>
            </div>

            @* Action Buttons *@
            <div class="flex items-center justify-end gap-2 pt-2">
                <a href="@Url.Action("Index")"
                   class="px-3.5 py-1.5 border border-[#D5DDD8] dark:border-[#2B3833] bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] text-xs font-semibold rounded-xl transition flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-left text-xs"></i>
                    <span>@T("إعادة ضبط", "Reset")</span>
                </a>
                <button type="submit"
                        class="px-4 py-1.5 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-filter text-xs"></i>
                    <span>@T("تطبيق الفلتر", "Apply Filter")</span>
                </button>
            </div>
        </form>
    </div>

    @* ── Expenses Table Card ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] rounded-2xl shadow-sm overflow-hidden">
        <div class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] p-4 rounded-t-2xl flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-receipt text-[#49665A]"></i>
                <h2 class="text-xs font-bold text-[#1A2621] dark:text-[#EAEFEA] uppercase tracking-wider m-0">@T("قائمة المصروفات", "Expenses List")</h2>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-[#49665A]/10 text-[#49665A] border border-[#49665A]/20">
                    @totalCount
                </span>
            </div>
            <span class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3]">@T("مرتبة من الأحدث للأقدم", "Sorted newest to oldest")</span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12 text-[#6B7D75] dark:text-[#9CA8A3] space-y-2">
                <i class="fa-solid fa-receipt text-3xl opacity-40 block mb-2"></i>
                <h3 class="text-sm font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0">@T("لا توجد مصروفات مسجلة", "No expenses recorded")</h3>
                <p class="text-xs m-0">@T("ابدأ بإضافة أول مصروف للعيادة باستخدام الزر أعلاه", "Start by adding the first expense using the button above")</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-start text-xs">
                    <thead class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[11px] uppercase tracking-wider text-[#5C6E66] dark:text-[#9CA8A3] font-semibold">
                        <tr>
                            <th class="py-3 px-4 text-start">@T("العنوان", "Title")</th>
                            <th class="py-3 px-4 text-start">@T("الفئة", "Category")</th>
                            <th class="py-3 px-4 text-start">@T("المبلغ", "Amount")</th>
                            <th class="py-3 px-4 text-start">@T("التاريخ", "Date")</th>
                            <th class="py-3 px-4 text-start">@T("طريقة الدفع", "Payment")</th>
                            <th class="py-3 px-4 text-start">@T("المورد / الجهة", "Vendor")</th>
                            <th class="py-3 px-4 text-end">@T("الإجراءات", "Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E5E9E7] dark:divide-[#2B3833]">
                        @foreach (var exp in Model)
                        {
                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                @* Title *@
                                <td class="py-3.5 px-4">
                                    <div class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold text-xs">@exp.Title</div>
                                    @if (!string.IsNullOrEmpty(exp.Notes))
                                    {
                                        <div class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] truncate max-w-xs" title="@exp.Notes">@exp.Notes</div>
                                    }
                                </td>

                                @* Category *@
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-xs font-medium text-[#1A2621] dark:text-[#EAEFEA]">
                                        <i class="fa-solid @CategoryIcon(exp.Category) text-[10px]"></i>
                                        <span>@CategoryLabel(exp.Category)</span>
                                    </span>
                                </td>

                                @* Amount *@
                                <td class="py-3.5 px-4 whitespace-nowrap font-bold text-sm text-rose-600 dark:text-rose-400">
                                    @exp.Amount.ToString("N2") <span class="text-[10px] font-normal text-[#6B7D75] dark:text-[#9CA8A3]">@currency</span>
                                </td>

                                @* Date & Time *@
                                <td class="py-3.5 px-4 whitespace-nowrap text-[#6B7D75] dark:text-[#9CA8A3] text-xs">
                                    <div class="text-[#1A2621] dark:text-[#EAEFEA]">@exp.ExpenseDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-[10px] text-[#6B7D75] dark:text-[#9CA8A3]">@exp.ExpenseDate.ToString("dddd")</div>
                                </td>

                                @* Payment method badge *@
                                <td class="py-3.5 px-4 whitespace-nowrap text-[#1A2621] dark:text-[#EAEFEA] text-xs">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833]">
                                        @if (exp.PaymentMethod == "Cash")
                                        { <i class="fa-solid fa-money-bill-wave text-emerald-500 text-[10px]"></i> }
                                        else if (exp.PaymentMethod == "Credit Card")
                                        { <i class="fa-solid fa-credit-card text-sky-500 text-[10px]"></i> }
                                        else
                                        { <i class="fa-solid fa-building-columns text-indigo-500 text-[10px]"></i> }
                                        <span>@exp.PaymentMethod</span>
                                    </span>
                                </td>

                                @* Vendor *@
                                <td class="py-3.5 px-4 text-[#1A2621] dark:text-[#EAEFEA] text-xs whitespace-nowrap">
                                    @(exp.VendorOrPayee ?? "—")
                                </td>

                                @* Actions *@
                                <td class="py-3.5 px-4 text-end whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        @if (!string.IsNullOrEmpty(exp.ReceiptAttachmentPath))
                                        {
                                            <a href="@exp.ReceiptAttachmentPath" target="_blank"
                                               class="w-7 h-7 flex items-center justify-center rounded-lg border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] hover:bg-[#F4F7F5] dark:hover:bg-[#151E1B] text-xs transition"
                                               title="@T("عرض الإيصال", "View Receipt")">
                                                <i class="fa-solid fa-receipt text-[10px]"></i>
                                            </a>
                                        }
                                        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                                        {
                                            <button type="button"
                                                    class="w-7 h-7 flex items-center justify-center rounded-lg border border-[#D5DDD8] dark:border-[#2B3833] text-[#49665A] hover:bg-[#49665A]/10 text-xs transition"
                                                    title="@T("تعديل", "Edit")"
                                                    onclick="openEditModal(@exp.Id)">
                                                <i class="fa-solid fa-pen text-[10px]"></i>
                                            </button>
                                        }
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="Delete" method="post" class="m-0 inline"
                                                  onsubmit="return confirm('@T("هل أنت متأكد من حذف هذا المصروف؟", "Delete this expense record?")')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@exp.Id" />
                                                <button type="submit"
                                                        class="w-7 h-7 flex items-center justify-center rounded-lg border border-rose-300 dark:border-rose-500/30 text-rose-500 hover:bg-rose-500/10 text-xs transition"
                                                        title="@T("حذف", "Delete")">
                                                    <i class="fa-solid fa-trash-can text-[10px]"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            @if (totalPages > 1)
            {
                <div class="flex items-center justify-between px-4 py-3 border-t border-[#E5E9E7] dark:border-[#2B3833] bg-[#F4F7F5] dark:bg-[#151E1B] text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
                    <span>
                        @T("الصفحة", "Page") @currentPage @T("من", "of") @totalPages
                    </span>
                    <div class="flex items-center gap-1">
                        <a class="px-2.5 py-1 rounded-lg border border-[#D5DDD8] dark:border-[#2B3833] @(currentPage <= 1 ? "opacity-30 pointer-events-none" : "hover:text-[#1A2621] dark:hover:text-[#EAEFEA] hover:bg-[#EAEFEA] dark:hover:bg-[#1B2421]") transition"
                           href="@Url.Action("Index", new { page = currentPage - 1, search = ViewBag.Search, category = ViewBag.Category, dateRange = ViewBag.DateRange })">
                            <i class="fa-solid fa-chevron-left text-[10px]"></i>
                        </a>
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <a class="px-3 py-1 rounded-lg text-xs font-semibold @(p == currentPage ? "bg-[#49665A] text-white shadow-sm" : "border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] hover:bg-[#EAEFEA] dark:hover:bg-[#1B2421]") transition"
                               href="@Url.Action("Index", new { page = p, search = ViewBag.Search, category = ViewBag.Category, dateRange = ViewBag.DateRange })">
                                @p
                            </a>
                        }
                        <a class="px-2.5 py-1 rounded-lg border border-[#D5DDD8] dark:border-[#2B3833] @(currentPage >= totalPages ? "opacity-30 pointer-events-none" : "hover:text-[#1A2621] dark:hover:text-[#EAEFEA] hover:bg-[#EAEFEA] dark:hover:bg-[#1B2421]") transition"
                           href="@Url.Action("Index", new { page = currentPage + 1, search = ViewBag.Search, category = ViewBag.Category, dateRange = ViewBag.DateRange })">
                            <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* ══════════════════════════════════════════════════════════════
   📋 UNIFIED EXPENSE MODAL (ADD / EDIT) - STANDALONE POPUP MODAL
   ══════════════════════════════════════════════════════════════ *@
<div id="expenseModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto hidden" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="max-w-lg w-full bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] rounded-2xl p-6 text-[#1A2621] dark:text-[#EAEFEA] shadow-2xl my-auto text-start relative" onclick="event.stopPropagation()">

        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[#E5E9E7] dark:border-[#2B3833] mb-4">
            <div class="flex items-center gap-3">
                <div id="modalIconContainer" class="w-10 h-10 rounded-xl bg-[#49665A]/10 border border-[#49665A]/20 flex items-center justify-center text-[#49665A] text-base">
                    <i id="modalIcon" class="fa-solid fa-plus-circle"></i>
                </div>
                <div>
                    <h2 class="text-sm sm:text-base font-bold text-[#1A2621] dark:text-[#EAEFEA] m-0" id="expenseModalLabel">
                        @T("إضافة مصروف جديد", "Add New Expense")
                    </h2>
                    <p class="text-[11px] text-[#6B7D75] dark:text-[#9CA8A3] m-0" id="expenseModalSubtitle">
                        @T("أدخل بيانات المصروف والفئة وطريقة السداد", "Enter expense details, category, and payment method")
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeExpenseModal()" class="w-8 h-8 rounded-lg border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3] hover:text-[#1A2621] dark:hover:text-[#EAEFEA] flex items-center justify-center text-sm cursor-pointer transition-colors bg-transparent" aria-label="Close">✕</button>
        </div>

        <!-- Modal Form -->
        <form id="expenseForm" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="expenseId" value="0" />
            <input type="hidden" name="ReceiptAttachmentPath" id="expenseReceiptPath" value="" />

            <!-- Title -->
            <div>
                <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("عنوان المصروف", "Expense Title") *
                </label>
                <input type="text" name="Title" id="expenseTitle" required
                       class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition"
                       placeholder="@T("مثال: أدوات ومستلزمات طبية", "e.g. Dental Restorative Materials")" />
            </div>

            <!-- Category & Amount -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                        @T("الفئة", "Category") *
                    </label>
                    <select name="Category" id="expenseCategory" required
                            class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition">
                        @foreach (var cat in categories)
                        {
                            <option value="@((int)cat)">@CategoryLabel(cat)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                        @T("المبلغ (JOD)", "Amount (JOD)") *
                    </label>
                    <input type="number" name="Amount" id="expenseAmount" step="0.01" min="0.01" required
                           class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition"
                           placeholder="0.00" />
                </div>
            </div>

            <!-- Date & Payment Method -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                        @T("تاريخ المصروف", "Expense Date") *
                    </label>
                    <input type="date" name="ExpenseDate" id="expenseDate" required
                           class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                        @T("طريقة الدفع", "Payment Method") *
                    </label>
                    <select name="PaymentMethod" id="expensePayment" required
                            class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition">
                        <option value="Cash">💵 @T("نقدي", "Cash")</option>
                        <option value="Credit Card">💳 @T("بطاقة ائتمانية", "Credit Card")</option>
                        <option value="Bank Transfer">🏦 @T("تحويل بنكي", "Bank Transfer")</option>
                    </select>
                </div>
            </div>

            <!-- Vendor -->
            <div>
                <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("المورد / الجهة المستفيدة", "Vendor / Payee")
                </label>
                <input type="text" name="VendorOrPayee" id="expenseVendor"
                       class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition"
                       placeholder="@T("اسم المورد، الشركة، أو الشخص المستلم", "Supplier, company or payee name")" />
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("ملاحظات", "Notes")
                </label>
                <textarea name="Notes" id="expenseNotes" rows="2"
                          class="w-full bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] rounded-xl px-3 py-2 text-xs focus:ring-1 focus:ring-[#49665A] transition resize-y"
                          placeholder="@T("تفاصيل إضافية عن المصروف...", "Additional details...")"></textarea>
            </div>

            <!-- Receipt Upload -->
            <div>
                <label class="block text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA] mb-1.5">
                    @T("إيصال أو فاتورة الدفع (PDF/Image)", "Receipt Attachment (PDF/Image)")
                </label>
                <div id="currentReceiptDisplay" class="mb-2 text-xs text-[#6B7D75] dark:text-[#9CA8A3] hidden"></div>
                <div class="bg-[#F8FAF9] dark:bg-[#151E1B] border-2 border-dashed border-[#D5DDD8] dark:border-[#2B3833] hover:border-[#49665A] rounded-xl p-3.5 text-center cursor-pointer transition"
                     onclick="document.getElementById('receiptFileInput').click()">
                    <i class="fa-solid fa-cloud-arrow-up text-lg text-[#49665A] mb-1 block"></i>
                    <div class="text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA]" id="receiptHint">
                        @T("انقر لرفع الإيصال (PDF, PNG, JPG - حد أقصى 5MB)", "Click to upload receipt (PDF, PNG, JPG - max 5MB)")
                    </div>
                </div>
                <input type="file" id="receiptFileInput" name="receiptFile" accept=".pdf,.png,.jpg,.jpeg,.webp" class="hidden"
                       onchange="document.getElementById('receiptHint').textContent = this.files[0]?.name || '@T("انقر لرفع الإيصال", "Click to upload receipt")'" />
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <button type="button" class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5 cursor-pointer" onclick="closeExpenseModal()">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </button>
                <button type="submit" id="modalSubmitBtn" class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5 cursor-pointer border-0">
                    <i class="fa-solid fa-check text-xs"></i>
                    <span id="modalSubmitText">@T("حفظ", "Save")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // ── Date Range Filter Pills ──────────────────────────────────────────────
    function setDateRange(val) {
        document.getElementById("hidDateRange").value = val;
        document.querySelectorAll(".date-pill").forEach(b => {
            const isActive = b.getAttribute("onclick")?.includes("'" + val + "'");
            if (isActive) {
                b.classList.add("bg-[#49665A]", "text-white", "shadow-sm");
                b.classList.remove("bg-[#F4F7F5]", "hover:bg-[#EAEFEA]", "dark:bg-[#151E1B]", "dark:hover:bg-[#202B27]", "border-[#D5DDD8]", "text-[#6B7D75]");
            } else {
                b.classList.remove("bg-[#49665A]", "text-white", "shadow-sm");
                b.classList.add("bg-[#F4F7F5]", "hover:bg-[#EAEFEA]", "dark:bg-[#151E1B]", "dark:hover:bg-[#202B27]", "border-[#D5DDD8]", "text-[#6B7D75]");
            }
        });
        const customRow = document.getElementById("customDateRow");
        if (customRow) {
            customRow.classList.toggle("hidden", val !== "custom");
        }
    }

    // ── Open Create Modal ───────────────────────────────────────────────────
    function openCreateModal() {
        const form = document.getElementById("expenseForm");
        form.action = "@Url.Action("Create")";

        document.getElementById("expenseModalLabel").textContent = "@T("إضافة مصروف جديد", "Add New Expense")";
        document.getElementById("expenseModalSubtitle").textContent = "@T("أدخل بيانات المصروف والفئة وطريقة السداد", "Enter expense details, category, and payment method")";
        document.getElementById("modalIcon").className = "fa-solid fa-plus-circle";
        document.getElementById("modalSubmitText").textContent = "@T("إضافة المصروف", "Add Expense")";

        document.getElementById("expenseId").value = "0";
        document.getElementById("expenseReceiptPath").value = "";
        document.getElementById("expenseTitle").value = "";
        document.getElementById("expenseCategory").selectedIndex = 0;
        document.getElementById("expenseAmount").value = "";
        document.getElementById("expenseDate").value = new Date().toISOString().split('T')[0];
        document.getElementById("expensePayment").value = "Cash";
        document.getElementById("expenseVendor").value = "";
        document.getElementById("expenseNotes").value = "";
        document.getElementById("receiptFileInput").value = "";
        document.getElementById("receiptHint").textContent = "@T("انقر لرفع الإيصال (PDF, PNG, JPG - حد أقصى 5MB)", "Click to upload receipt (PDF, PNG, JPG - max 5MB)")";

        const currentReceipt = document.getElementById("currentReceiptDisplay");
        currentReceipt.classList.add("hidden");
        currentReceipt.innerHTML = "";

        const modalEl = document.getElementById("expenseModal");
        if (modalEl) {
            modalEl.classList.remove("hidden");
            document.body.classList.add("overflow-hidden");
        }
    }

    function closeExpenseModal() {
        const modalEl = document.getElementById("expenseModal");
        if (modalEl) {
            modalEl.classList.add("hidden");
            document.body.classList.remove("overflow-hidden");
        }
    }

    // ── Open Edit Modal ─────────────────────────────────────────────────────
    async function openEditModal(id) {
        try {
            const res = await fetch("/Expenses/GetExpense/" + id);
            if (!res.ok) throw new Error("Failed to load expense");
            const e = await res.json();

            const form = document.getElementById("expenseForm");
            form.action = "@Url.Action("Edit")";

            document.getElementById("expenseModalLabel").textContent = "@T("تعديل المصروف", "Edit Expense")";
            document.getElementById("expenseModalSubtitle").textContent = "@T("تحديث بيانات وسجلات المصروف", "Update expense records and details")";
            document.getElementById("modalIcon").className = "fa-solid fa-pen-to-square";
            document.getElementById("modalSubmitText").textContent = "@T("حفظ التعديلات", "Save Changes")";

            document.getElementById("expenseId").value = e.id;
            document.getElementById("expenseReceiptPath").value = e.receiptAttachmentPath || "";
            document.getElementById("expenseTitle").value = e.title || "";
            document.getElementById("expenseCategory").value = e.category;
            document.getElementById("expenseAmount").value = e.amount;
            document.getElementById("expenseDate").value = e.expenseDate;
            document.getElementById("expensePayment").value = e.paymentMethod || "Cash";
            document.getElementById("expenseVendor").value = e.vendorOrPayee || "";
            document.getElementById("expenseNotes").value = e.notes || "";
            document.getElementById("receiptFileInput").value = "";
            document.getElementById("receiptHint").textContent = "@T("اضغط لاستبدال الإيصال الحالي", "Click to replace current receipt")";

            const currentReceipt = document.getElementById("currentReceiptDisplay");
            if (e.receiptAttachmentPath) {
                currentReceipt.classList.remove("hidden");
                currentReceipt.innerHTML = '<i class="fa-solid fa-paperclip me-1 text-[#49665A]"></i><a href="' + e.receiptAttachmentPath + '" target="_blank" class="text-emerald-400 hover:underline">@T("معاينة الإيصال الحالي", "View current receipt")</a>';
            } else {
                currentReceipt.classList.add("hidden");
                currentReceipt.innerHTML = "";
            }

            const modalEl = document.getElementById("expenseModal");
            if (modalEl) {
                modalEl.classList.remove("hidden");
                document.body.classList.add("overflow-hidden");
            }
        } catch (err) {
            alert("@T("تعذر تحميل بيانات المصروف", "Failed to load expense data.")");
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const modalEl = document.getElementById("expenseModal");
        if (modalEl) {
            modalEl.addEventListener("click", function (e) {
                if (e.target === this) {
                    closeExpenseModal();
                }
            });
        }
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                closeExpenseModal();
            }
        });
    });
</script>
}
