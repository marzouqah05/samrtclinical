@model IEnumerable<WebApplication1.Models.Department>

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("الأقسام", "Departments");
}

<div dir="@(_isAr ? "rtl" : "ltr")" class="space-y-5">

    <!-- ── Page Header ── -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-lg font-bold text-[#202725] m-0 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-sm shrink-0">
                    <i class="fa-solid fa-sitemap"></i>
                </span>
                @T("إدارة الأقسام", "Departments Management")
            </h2>
            <p class="text-xs text-[#727A76] m-0 mt-1 ms-10">@T("نظرة عامة وتحكم في أقسام عيادتك الصحية.", "Overview and control of your healthcare clinic departments.")</p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
            <!-- Total count pill -->
            <div class="inline-flex items-center gap-2 bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-xl px-4 py-2 shadow-sm">
                <span class="w-7 h-7 rounded-md bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-xs">
                    <i class="fa-solid fa-building"></i>
                </span>
                <span class="text-sm font-bold text-[#1A2621] dark:text-[#EAEFEA]">@Model.Count()</span>
                <span class="text-xs text-[#6B7D75] dark:text-[#9CA8A3]">@T("قسم", "Departments")</span>
            </div>

            @if (!User.IsInRole("Doctor"))
            {
                <!-- 📥 Import Departments Button -->
                <button type="button"
                        class="inline-flex items-center gap-2 px-3.5 py-2 bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] text-[#49665A] dark:text-[#EAEFEA] text-xs font-semibold rounded-xl hover:bg-[#F6F7F5] dark:hover:bg-[#202B27] transition shadow-sm"
                        data-bs-toggle="modal" data-bs-target="#importDepartmentsModal"
                        title="@T("استيراد بيانات الأقسام من CSV أو Excel", "Bulk import departments from CSV or Excel")">
                    <i class="fa-solid fa-file-import text-xs"></i>
                    <span>@T("استيراد الأقسام", "Import Departments")</span>
                </button>

                <!-- 📥 Import Specialties Button -->
                <button type="button"
                        class="inline-flex items-center gap-2 px-3.5 py-2 bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] text-[#2E7D5B] dark:text-[#A7D7C5] text-xs font-semibold rounded-xl hover:bg-[#F6F7F5] dark:hover:bg-[#202B27] transition shadow-sm"
                        data-bs-toggle="modal" data-bs-target="#importSpecialtiesModal"
                        title="@T("استيراد بيانات التخصصات من CSV أو Excel", "Bulk import specialties from CSV or Excel")">
                    <i class="fa-solid fa-tags text-xs"></i>
                    <span>@T("استيراد التخصصات", "Import Specialties")</span>
                </button>

                <a asp-action="Create"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-[#49665A] text-white text-xs font-semibold rounded-xl hover:bg-[#3D574D] transition-colors shadow-sm">
                    <i class="fa-solid fa-plus text-xs"></i>
                    @T("إضافة قسم جديد", "Add New Department")
                </a>
            }
        </div>
    </div>

    @* ─── Notification Alerts ─── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-xl shadow-sm border-0 d-flex align-items-center mb-4 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20" role="alert">
            <i class="fa-solid fa-circle-check fs-5 @(_isAr ? "ms-3" : "me-3") text-emerald-600 dark:text-emerald-400"></i>
            <div class="text-xs">
                <strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]
            </div>
            <button type="button" class="btn-close dark:invert @(_isAr ? "me-auto ms-0" : "ms-auto me-0")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-xl shadow-sm border-0 d-flex align-items-center mb-4 bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5 @(_isAr ? "ms-3" : "me-3") text-amber-600 dark:text-amber-400"></i>
            <div class="text-xs">
                <strong>@T("تنبيه:", "Notice:")</strong> @TempData["Warning"]
            </div>
            <button type="button" class="btn-close dark:invert @(_isAr ? "me-auto ms-0" : "ms-auto me-0")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null || TempData["DeleteError"] != null)
    {
        var errorMsg = TempData["Error"] ?? TempData["DeleteError"];
        <div class="alert alert-danger alert-dismissible fade show rounded-xl shadow-sm border-0 d-flex align-items-center mb-4 bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20" role="alert">
            <i class="fa-solid fa-circle-exclamation fs-5 @(_isAr ? "ms-3" : "me-3") text-rose-600 dark:text-rose-400"></i>
            <div class="text-xs">
                <strong>@T("خطأ:", "Error:")</strong> @errorMsg
            </div>
            <button type="button" class="btn-close dark:invert @(_isAr ? "me-auto ms-0" : "ms-auto me-0")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ── Departments Table ── -->
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden">
        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-start">
                    <thead>
                        <tr class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[11px] font-semibold uppercase tracking-wider text-[#5C6E66] dark:text-[#9CA8A3]">
                            <th class="py-3 px-5 text-start">
                                @T("رمز القسم", "Dept Code")
                            </th>
                            <th class="py-3 px-5 text-start">
                                @T("اسم القسم", "Department Name")
                            </th>
                            <th class="py-3 px-5 text-start">
                                @T("وحدة الرعاية", "Care Unit")
                            </th>
                            <th class="py-3 px-5 text-end">
                                @T("الإجراءات", "Actions")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                <!-- Code Badge -->
                                <td class="py-3.5 px-5">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#49665A]/10 text-[#49665A] border border-[#49665A]/20">
                                        <i class="fa-solid fa-layer-group text-[9px]"></i>
                                        @item.DepartmentAbbr
                                    </span>
                                </td>
                                <!-- Department Name with Avatar -->
                                <td class="py-3.5 px-5">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-[#49665A]/10 text-[#49665A] flex items-center justify-center text-sm font-bold shrink-0">
                                            @(item.DepartmentName?.Substring(0, 1).ToUpper() ?? "D")
                                        </div>
                                        <span class="text-xs font-semibold text-[#1A2621] dark:text-[#EAEFEA]">@item.DepartmentName</span>
                                    </div>
                                </td>
                                <!-- Care Unit -->
                                <td class="py-3.5 px-5 text-xs text-[#6B7D75] dark:text-[#9CA8A3]">
                                    @T("وحدة الرعاية التخصصية", "Medical Specialty Care Unit")
                                </td>
                                <!-- Actions -->
                                <td class="py-3.5 px-5 text-end">
                                    <div class="inline-flex items-center gap-1.5">
                                        <a asp-action="Details" asp-route-id="@item.DepartmentId"
                                           class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-medium transition"
                                           title="@T("تفاصيل", "Details")">
                                            <i class="fa-solid fa-eye text-[#49665A] text-[10px]"></i>
                                            @T("تفاصيل", "Details")
                                        </a>
                                        @if (!User.IsInRole("Doctor"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.DepartmentId"
                                               class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#F4F7F5] hover:bg-[#EAEFEA] dark:bg-[#151E1B] dark:hover:bg-[#202B27] border border-[#D5DDD8] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] text-xs font-medium transition"
                                               title="@T("تعديل", "Edit")">
                                                <i class="fa-solid fa-pen text-[#49665A] text-[10px]"></i>
                                                @T("تعديل", "Edit")
                                            </a>
                                            @if (User.IsAdminOrOwner())
                                            {
                                                <form asp-action="Delete" asp-route-id="@item.DepartmentId" method="post" class="inline m-0 d-inline" onsubmit="return confirm('@T($"هل أنت متأكد من رغبتك في حذف قسم {item.DepartmentName} بشكل نهائي؟", $"Are you sure you want to permanently delete {item.DepartmentName}?")');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="inline-flex items-center justify-center w-7 h-7 rounded-lg border border-rose-300 dark:border-rose-500/30 text-rose-500 hover:bg-rose-500/10 text-xs transition"
                                                            title="@T("حذف", "Delete")">
                                                        <i class="fa-solid fa-trash text-[10px]"></i>
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center text-[#6B7D75] dark:text-[#9CA8A3]">
                <i class="fa-solid fa-building-circle-xmark text-3xl block mb-3 text-[#6B7D75]/40 dark:text-[#9CA8A3]/40"></i>
                <p class="text-sm font-semibold text-[#1A2621] dark:text-[#EAEFEA] m-0">@T("لا توجد أقسام طبية", "No Medical Departments Found")</p>
                <p class="text-xs text-[#6B7D75] dark:text-[#9CA8A3] mt-1 mb-4">@T("يبدو أنه لا توجد أقسام نشطة حالياً.", "It looks like there are no active departments right now.")</p>
                @if (!User.IsInRole("Doctor"))
                {
                    <a asp-action="Create"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-[#49665A] text-white text-xs font-semibold rounded-xl hover:bg-[#3D574D] transition shadow-sm">
                        <i class="fa-solid fa-plus text-xs"></i>
                        @T("إنشاء أول قسم", "Create First Department")
                    </a>
                }
            </div>
        }
    </div>
</div>

@* ─── 📥 Import Departments Modal ─── *@
<div class="modal fade" id="importDepartmentsModal" tabindex="-1" aria-labelledby="importDepartmentsModalLabel" aria-hidden="true" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl p-6 sm:p-7 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 overflow-hidden text-start">
            
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                    </div>
                    <div>
                        <h5 class="text-slate-900 dark:text-white font-bold text-lg m-0" id="importDepartmentsModalLabel">
                            @T("استيراد بيانات الأقسام", "Bulk Import Departments")
                        </h5>
                        <p class="text-slate-500 dark:text-slate-400 font-normal text-xs sm:text-sm m-0 mt-0.5">
                            @T("رفع ملف CSV أو Excel لتسجيل بيانات الأقسام دفعة واحدة", "Upload CSV or Excel file to record multiple department records at once")
                        </p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border-0 bg-transparent cursor-pointer" data-bs-dismiss="modal" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form method="post" enctype="multipart/form-data" asp-action="Import" id="importDepartmentsForm">
                @Html.AntiForgeryToken()

                <!-- Template Download Card -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 rounded-xl p-3.5 flex items-center justify-between gap-3 mb-5">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold font-mono text-xs">
                            CSV
                        </div>
                        <div class="min-w-0">
                            <div class="text-slate-900 dark:text-slate-100 font-semibold text-xs sm:text-sm truncate">
                                @T("قالب بيانات الأقسام القياسي", "Standard Departments Template")
                            </div>
                            <div class="text-slate-500 dark:text-slate-400 font-normal text-xs mt-0.5 truncate">
                                @T("تحميل ملف CSV بالأعمدة المطلوبة", "Download CSV template with required columns")
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("DownloadTemplate")" class="bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-50 dark:hover:bg-slate-700 text-xs font-semibold px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 transition shrink-0">
                        <i class="fa-solid fa-download text-xs"></i>
                        <span>@T("تحميل القالب", "Download Template")</span>
                    </a>
                </div>

                <!-- Modern Dropzone Component -->
                <div class="mb-5">
                    <div id="deptDropzone"
                         class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-500 rounded-xl p-7 text-center cursor-pointer transition bg-slate-50/60 dark:bg-slate-800/30 group">
                        
                        <input type="file" id="deptFileInput" name="file" class="hidden" accept=".csv, .xlsx, .xls" required onchange="handleDeptFileSelected(this)" />
                        
                        <!-- Empty / Prompt State -->
                        <div id="deptDropzonePrompt" class="py-2">
                            <div class="w-10 h-10 mx-auto mb-2.5 rounded-full bg-slate-100 dark:bg-slate-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/50 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 flex items-center justify-center transition">
                                <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                            </div>
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                                <span class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">@T("اضغط لتصفح الملف", "Click to browse")</span>
                                @T("أو اسحب وأفلت الملف هنا", "or drag and drop your file here")
                            </p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 m-0">
                                @T("الصيغ المدعومة: .csv, .xlsx", "Supported formats: .csv, .xlsx")
                            </p>
                        </div>

                        <!-- Selected File State -->
                        <div id="deptDropzoneFileSelected" class="hidden flex items-center justify-between p-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-start shadow-sm">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-9 h-9 rounded-lg bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-file-csv text-base"></i>
                                </div>
                                <div class="min-w-0">
                                    <p id="deptSelectedFileName" class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 truncate m-0"></p>
                                    <p id="deptSelectedFileSize" class="text-[11px] text-slate-500 dark:text-slate-400 m-0 mt-0.5"></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="event.stopPropagation(); document.getElementById('deptFileInput').click();" class="px-2.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors border-0 bg-transparent cursor-pointer">
                                    @T("تغيير", "Change")
                                </button>
                                <button type="button" onclick="event.stopPropagation(); removeDeptSelectedFile();" class="p-1.5 text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors border-0 bg-transparent cursor-pointer" title="@T("إزالة الملف", "Remove file")">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Required Specifications as Modern Badges -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/50 p-4 mb-6">
                    <div class="flex items-center gap-2 mb-2.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">
                            @T("الأعمدة المطلوبة في الملف ومواصفاتها:", "Required Columns Specifications:")
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">DepartmentName</span>
                            <span class="text-[11px] opacity-75">(@T("مطلوب (3 - 100 حرفاً)", "Required (3 - 100 chars)"))</span>
                        </div>
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">DepartmentCode</span>
                            <span class="text-[11px] opacity-75">(@T("رمز فريد (مثل DENT, CARD, PED)", "Unique Code (e.g. DENT, CARD, PED)"))</span>
                        </div>
                    </div>
                </div>

                <!-- Modal Actions Footer -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <button type="button" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium px-4 py-2.5 rounded-lg text-sm transition cursor-pointer" data-bs-dismiss="modal">
                        @T("إلغاء", "Cancel")
                    </button>
                    <button type="submit"
                            class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-5 py-2.5 rounded-lg text-sm shadow-sm inline-flex items-center gap-2 transition active:scale-95 border-0 cursor-pointer">
                        <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                        <span>@T("بدء الاستيراد", "Start Import")</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ─── 📥 Import Specialties Modal ─── *@
<div class="modal fade" id="importSpecialtiesModal" tabindex="-1" aria-labelledby="importSpecialtiesModalLabel" aria-hidden="true" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl p-6 sm:p-7 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 overflow-hidden text-start">
            
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-tags text-lg"></i>
                    </div>
                    <div>
                        <h5 class="text-slate-900 dark:text-white font-bold text-lg m-0" id="importSpecialtiesModalLabel">
                            @T("استيراد بيانات التخصصات", "Bulk Import Specialties")
                        </h5>
                        <p class="text-slate-500 dark:text-slate-400 font-normal text-xs sm:text-sm m-0 mt-0.5">
                            @T("رفع ملف CSV أو Excel لتسجيل بيانات التخصصات الطبية دفعة واحدة", "Upload CSV or Excel file to record multiple medical specialties at once")
                        </p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border-0 bg-transparent cursor-pointer" data-bs-dismiss="modal" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form method="post" enctype="multipart/form-data" asp-action="ImportSpecialties" id="importSpecialtiesForm">
                @Html.AntiForgeryToken()

                <!-- Template Download Card -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 rounded-xl p-3.5 flex items-center justify-between gap-3 mb-5">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold font-mono text-xs">
                            CSV
                        </div>
                        <div class="min-w-0">
                            <div class="text-slate-900 dark:text-slate-100 font-semibold text-xs sm:text-sm truncate">
                                @T("قالب بيانات التخصصات القياسي", "Standard Specialties Template")
                            </div>
                            <div class="text-slate-500 dark:text-slate-400 font-normal text-xs mt-0.5 truncate">
                                @T("تحميل ملف CSV بالأعمدة المطلوبة", "Download CSV template with required columns")
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("DownloadSpecialtiesTemplate")" class="bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-50 dark:hover:bg-slate-700 text-xs font-semibold px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 transition shrink-0">
                        <i class="fa-solid fa-download text-xs"></i>
                        <span>@T("تحميل القالب", "Download Template")</span>
                    </a>
                </div>

                <!-- Modern Dropzone Component -->
                <div class="mb-5">
                    <div id="specialtyDropzone"
                         class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-500 rounded-xl p-7 text-center cursor-pointer transition bg-slate-50/60 dark:bg-slate-800/30 group">
                        
                        <input type="file" id="specialtyFileInput" name="file" class="hidden" accept=".csv, .xlsx, .xls" required onchange="handleSpecialtyFileSelected(this)" />
                        
                        <!-- Empty / Prompt State -->
                        <div id="specialtyDropzonePrompt" class="py-2">
                            <div class="w-10 h-10 mx-auto mb-2.5 rounded-full bg-slate-100 dark:bg-slate-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/50 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 flex items-center justify-center transition">
                                <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                            </div>
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                                <span class="text-emerald-600 dark:text-emerald-400 font-medium hover:underline">@T("اضغط لتصفح الملف", "Click to browse")</span>
                                @T("أو اسحب وأفلت الملف هنا", "or drag and drop your file here")
                            </p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 m-0">
                                @T("الصيغ المدعومة: .csv, .xlsx", "Supported formats: .csv, .xlsx")
                            </p>
                        </div>

                        <!-- Selected File State -->
                        <div id="specialtyDropzoneFileSelected" class="hidden flex items-center justify-between p-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-start shadow-sm">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-9 h-9 rounded-lg bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-file-csv text-base"></i>
                                </div>
                                <div class="min-w-0">
                                    <p id="specialtySelectedFileName" class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 truncate m-0"></p>
                                    <p id="specialtySelectedFileSize" class="text-[11px] text-slate-500 dark:text-slate-400 m-0 mt-0.5"></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="event.stopPropagation(); document.getElementById('specialtyFileInput').click();" class="px-2.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors border-0 bg-transparent cursor-pointer">
                                    @T("تغيير", "Change")
                                </button>
                                <button type="button" onclick="event.stopPropagation(); removeSpecialtySelectedFile();" class="p-1.5 text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors border-0 bg-transparent cursor-pointer" title="@T("إزالة الملف", "Remove file")">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Required Specifications as Modern Badges -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/50 p-4 mb-6">
                    <div class="flex items-center gap-2 mb-2.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">
                            @T("الأعمدة المطلوبة في الملف ومواصفاتها:", "Required Columns Specifications:")
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">SpecializationName:</span>
                            <span class="text-[11px] opacity-75">@T("اسم التخصص الطبي", "Medical Specialization Name")</span>
                        </div>
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-slate-600 dark:text-slate-400">Description:</span>
                            <span class="text-[11px] opacity-75">@T("وصف التخصص الطبي (اختياري)", "Specialization Description (Optional)")</span>
                        </div>
                    </div>
                </div>

                <!-- Modal Actions Footer -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <button type="button" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium px-4 py-2.5 rounded-lg text-sm transition cursor-pointer" data-bs-dismiss="modal">
                        @T("إلغاء", "Cancel")
                    </button>
                    <button type="submit"
                            class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-5 py-2.5 rounded-lg text-sm shadow-sm inline-flex items-center gap-2 transition active:scale-95 border-0 cursor-pointer">
                        <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                        <span>@T("بدء الاستيراد", "Start Import")</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            bindDropzone('deptDropzone', 'deptFileInput', handleDeptFileSelected);
            bindDropzone('specialtyDropzone', 'specialtyFileInput', handleSpecialtyFileSelected);
        });

        function bindDropzone(dropzoneId, inputId, selectCallback) {
            const dropzone = document.getElementById(dropzoneId);
            const fileInput = document.getElementById(inputId);

            if (dropzone && fileInput) {
                dropzone.addEventListener('click', function (e) {
                    if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                        fileInput.click();
                    }
                });

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                dropzone.addEventListener('drop', function (e) {
                    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        selectCallback(fileInput);
                    }
                });
            }
        }

        function formatFileSize(bytes) {
            const sizeKb = (bytes / 1024).toFixed(1);
            const sizeMb = (bytes / (1024 * 1024)).toFixed(2);
            return bytes > 1024 * 1024 ? `${sizeMb} MB` : `${sizeKb} KB`;
        }

        function handleDeptFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const nameEl = document.getElementById('deptSelectedFileName');
                const sizeEl = document.getElementById('deptSelectedFileSize');
                const promptEl = document.getElementById('deptDropzonePrompt');
                const selectedEl = document.getElementById('deptDropzoneFileSelected');

                if (nameEl) nameEl.textContent = file.name;
                if (sizeEl) sizeEl.textContent = formatFileSize(file.size);

                if (promptEl) promptEl.classList.add('hidden');
                if (selectedEl) {
                    selectedEl.classList.remove('hidden');
                    selectedEl.classList.add('flex');
                }
            }
        }

        function removeDeptSelectedFile() {
            const fileInput = document.getElementById('deptFileInput');
            const promptEl = document.getElementById('deptDropzonePrompt');
            const selectedEl = document.getElementById('deptDropzoneFileSelected');

            if (fileInput) fileInput.value = '';
            if (promptEl) promptEl.classList.remove('hidden');
            if (selectedEl) {
                selectedEl.classList.add('hidden');
                selectedEl.classList.remove('flex');
            }
        }

        function handleSpecialtyFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const nameEl = document.getElementById('specialtySelectedFileName');
                const sizeEl = document.getElementById('specialtySelectedFileSize');
                const promptEl = document.getElementById('specialtyDropzonePrompt');
                const selectedEl = document.getElementById('specialtyDropzoneFileSelected');

                if (nameEl) nameEl.textContent = file.name;
                if (sizeEl) sizeEl.textContent = formatFileSize(file.size);

                if (promptEl) promptEl.classList.add('hidden');
                if (selectedEl) {
                    selectedEl.classList.remove('hidden');
                    selectedEl.classList.add('flex');
                }
            }
        }

        function removeSpecialtySelectedFile() {
            const fileInput = document.getElementById('specialtyFileInput');
            const promptEl = document.getElementById('specialtyDropzonePrompt');
            const selectedEl = document.getElementById('specialtyDropzoneFileSelected');

            if (fileInput) fileInput.value = '';
            if (promptEl) promptEl.classList.remove('hidden');
            if (selectedEl) {
                selectedEl.classList.add('hidden');
                selectedEl.classList.remove('flex');
            }
        }
    </script>
}