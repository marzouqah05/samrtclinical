@model WebApplication1.Models.Department

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("حذف القسم", "Delete Department");
}

<div dir="@(_isAr ? "rtl" : "ltr")" class="py-4">
    <div class="max-w-2xl mx-auto">

        <!-- Back Navigation Link -->
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1.5">
                <i class="bi @(_isAr ? "bi-arrow-right" : "bi-arrow-left")"></i>
                <span>@T("العودة إلى قائمة الأقسام", "Back to Departments List")</span>
            </a>
        </div>

        <!-- Main Card Container -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833]">

            <!-- Header Matching Appointment Form -->
            <div class="d-flex align-items-center gap-3 pb-4 mb-4 border-bottom border-[#DDE3DF] dark:border-[#2B3833]">
                <div class="bg-danger-subtle text-danger p-3 rounded-circle d-flex align-items-center justify-content-center shrink-0" style="width: 52px; height: 52px;">
                    <i class="bi bi-trash3-fill fs-4 text-danger"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                        @T("حذف القسم", "Delete Department")
                    </h2>
                    <p class="small text-muted text-[#727A76] dark:text-[#9CA8A3] m-0 mt-1">
                        @T("يرجى مراجعة تفاصيل القسم قبل الحذف النهائي من النظام.", "Review details before permanently removing this department.")
                    </p>
                </div>
            </div>

            <!-- Standardized Warning Alert -->
            <div class="alert alert-danger-subtle border-0 rounded-3 d-flex align-items-center gap-2 mb-4 p-3 text-danger">
                <i class="bi bi-exclamation-triangle-fill fs-5 shrink-0 text-danger"></i>
                <div class="small">
                    <span class="fw-semibold">@T("تحذير:", "Warning:")</span>
                    <span>@T("هل أنت متأكد من حذف هذا القسم؟ لا يمكن التراجع عن هذا الإجراء وسيتم إزالة بيانات القسم.", "Are you sure you want to permanently remove this department? This action cannot be undone.")</span>
                </div>
            </div>

            <!-- Department Key-Value Summary Grid -->
            <div class="bg-light dark:bg-[#151E1B] p-4 rounded-3 border border-light-subtle dark:border-[#2B3833] mb-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-secondary small fw-medium mb-1 d-block">
                            <i class="bi bi-hospital me-1"></i>@T("اسم القسم", "Department Name")
                        </label>
                        <div class="fw-bold text-[#202725] dark:text-[#EAEFEA] fs-6">
                            @Model.DepartmentName
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-secondary small fw-medium mb-1 d-block">
                            <i class="bi bi-tag me-1"></i>@T("اختصار القسم", "Abbreviation / Code")
                        </label>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary px-3 py-1.5 rounded-pill fw-semibold">
                                @(string.IsNullOrEmpty(Model.DepartmentAbbr) ? "-" : Model.DepartmentAbbr)
                            </span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-secondary small fw-medium mb-1 d-block">
                            <i class="bi bi-person-badge me-1"></i>@T("الأطباء المسجلون بالقسم", "Associated Doctors")
                        </label>
                        <div>
                            <span class="badge bg-primary-subtle text-primary px-3 py-1.5 rounded-pill fw-semibold">
                                @(Model.Doctors?.Count ?? 0) @T("طبيب مسجل", "Doctor(s)")
                            </span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-secondary small fw-medium mb-1 d-block">
                            <i class="bi bi-check-circle me-1"></i>@T("حالة السجل", "Record Status")
                        </label>
                        <div>
                            <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-semibold">
                                @T("نشط بالنظام", "Active in System")
                            </span>
                        </div>
                    </div>
                </div>

                @if (Model.Doctors != null && Model.Doctors.Any())
                {
                    <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center gap-2 mt-3 mb-0 p-3 small text-warning-emphasis bg-warning-subtle">
                        <i class="bi bi-info-circle-fill fs-5 shrink-0 text-warning"></i>
                        <div>
                            @T("تنبيه: هذا القسم مرتبط بأطباء حاليين. يمنع النظام حذف الأقسام التي تحتوي على أطباء إلا بعد إعادة تعيينهم.",
                               "Notice: This department has active doctors assigned. You must reassign them before the department can be deleted.")
                        </div>
                    </div>
                }
            </div>

            <!-- Actions Footer -->
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DepartmentId" />

                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-[#DDE3DF] dark:border-[#2B3833]">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        @T("إلغاء", "Cancel")
                    </a>
                    <button type="submit" class="btn btn-danger px-4 rounded-pill d-inline-flex align-items-center gap-1.5 shadow-sm">
                        <i class="bi bi-trash3 me-1"></i>
                        <span>@T("حذف القسم", "Delete Department")</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>