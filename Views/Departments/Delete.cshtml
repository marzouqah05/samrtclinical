@model WebApplication1.Models.Department
@using System.Globalization

@{
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = isArabic ? "حذف القسم" : "Delete Department";
}

<div class="container-fluid px-4 py-4" style="max-width: 850px;">
    <!-- Back Link -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi @(isArabic ? "bi-arrow-right" : "bi-arrow-left")"></i>
            <span>@(isArabic ? "الرجوع لقائمة الأقسام" : "Back to Departments List")</span>
        </a>
    </div>

    <!-- Main Card -->
    <div class="card border border-light-subtle shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-body p-4 p-md-5">

            <!-- Header Section -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-danger-subtle text-danger p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-trash3-fill fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">@(isArabic ? "حذف القسم" : "Delete Department")</h4>
                    <p class="text-muted small mb-0">
                        @(isArabic ? "يرجى مراجعة تفاصيل القسم قبل تأكيد الحذف النهائي." : "Review details before permanently removing this department.")
                    </p>
                </div>
            </div>

            <!-- Danger Warning Banner -->
            <div class="alert alert-danger border-0 rounded-3 d-flex align-items-start gap-2 mb-4 p-3 bg-danger bg-opacity-10 text-danger">
                <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
                <div class="small">
                    <strong>@(isArabic ? "تحذير:" : "Warning:")</strong>
                    @(isArabic ? " هل أنت متأكد من رغبتك في حذف هذا القسم؟ لا يمكن التراجع عن هذا الإجراء." : " Are you sure you want to permanently remove this department? This action cannot be undone.")
                </div>
            </div>

            <!-- Department Info Box -->
            <div class="bg-light border rounded-3 p-3 mb-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block mb-1">
                            <i class="bi bi-building me-1"></i> @(isArabic ? "اسم القسم" : "Department Name")
                        </span>
                        <span class="fw-bold text-dark fs-6">@Model.DepartmentName</span>
                    </div>

                    <div class="col-sm-6">
                        <span class="text-muted small d-block mb-1">
                            <i class="bi bi-tag me-1"></i> @(isArabic ? "رمز / اختصار القسم" : "Abbreviation / Code")
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 fs-6">
                            @(string.IsNullOrEmpty(Model.DepartmentAbbr) ? (isArabic ? "لا يوجد" : "N/A") : Model.DepartmentAbbr)
                        </span>
                    </div>
                </div>

                @if (Model.Doctors != null && Model.Doctors.Any())
                {
                    <div class="alert alert-warning border-0 rounded-3 mt-3 mb-0 d-flex align-items-center gap-2 small">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>
                            @(isArabic 
                                ? $"تنبيه: يوجد {Model.Doctors.Count} طبيب مرتبط بهذا القسم. يجب نقلهم قبل إمكانية الحذف." 
                                : $"Notice: This department has {Model.Doctors.Count} active doctor(s) assigned. Reassign them before deleting.")
                        </span>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DepartmentId" />

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        @(isArabic ? "إلغاء" : "Cancel")
                    </a>
                    <button type="submit" class="btn btn-danger px-4 rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-trash3"></i>
                        <span>@(isArabic ? "تأكيد الحذف" : "Delete Department")</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>