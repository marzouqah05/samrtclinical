@model WebApplication1.Models.Department
@using System.Globalization

@{
    Layout = "_Layout";
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = isArabic ? "حذف القسم" : "Delete Department";
}

<div class="container-fluid py-4" style="max-width: 720px;">
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small fw-medium">
            <i class="bi @(isArabic ? "bi-arrow-right" : "bi-arrow-left") me-1"></i>
            @(isArabic ? "الرجوع لقائمة الأقسام" : "Back to Departments List")
        </a>
    </div>

    <div class="card border rounded-4 shadow-sm bg-white p-4">
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-3 p-3 bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                <i class="bi bi-trash3-fill fs-5"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-dark">@(isArabic ? "حذف القسم" : "Delete Department")</h5>
                <p class="text-muted small mb-0">
                    @(isArabic ? "إزالة هذا القسم نهائياً من النظام." : "Permanently remove this department from the system.")
                </p>
            </div>
        </div>

        <!-- Warning Box -->
        <div class="alert alert-warning border-0 rounded-3 small text-dark mb-4 py-2 px-3 bg-warning-subtle">
            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
            <strong>@(isArabic ? "تحذير:" : "Warning:")</strong>
            @(isArabic
                ? " هل أنت متأكد من رغبتك في حذف هذا القسم نهائياً؟ لا يمكن التراجع عن هذا الإجراء."
                : " Are you sure you want to permanently delete this department? This action cannot be undone.")
        </div>

        <!-- Details Box -->
        <div class="bg-light rounded-3 p-3 mb-4 border">
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label text-muted small mb-1">
                        @(isArabic ? "اسم القسم" : "Department Name")
                    </label>
                    <div class="fw-semibold text-dark">@Model.DepartmentName</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label text-muted small mb-1">
                        @(isArabic ? "رمز / اختصار القسم" : "Abbreviation / Code")
                    </label>
                    <div>
                        <span class="badge bg-secondary-subtle text-secondary">
                            @(string.IsNullOrEmpty(Model.DepartmentAbbr) ? (isArabic ? "لا يوجد" : "N/A") : Model.DepartmentAbbr)
                        </span>
                    </div>
                </div>
            </div>

            @if (Model.Doctors != null && Model.Doctors.Any())
            {
                <div class="mt-3 pt-3 border-top text-muted small">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    @if (isArabic)
                    {
                        <span>تنبيه: يوجد <strong>@Model.Doctors.Count</strong> طبيب مرتبط بهذا القسم. يجب نقلهم قبل إمكانية الحذف.</span>
                    }
                    else
                    {
                        <span>Notice: This department has <strong>@Model.Doctors.Count</strong> active doctor(s) assigned. Reassign them before deleting.</span>
                    }
                </div>
            }
        </div>

        <!-- Footer Actions -->
        <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 pt-2 border-top">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DepartmentId" />
            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                @(isArabic ? "إلغاء" : "Cancel")
            </a>
            <button type="submit" class="btn btn-danger px-4 rounded-pill">
                <i class="bi bi-trash3 me-1"></i>
                @(isArabic ? "تأكيد الحذف" : "Delete Department")
            </button>
        </form>
    </div>
</div>