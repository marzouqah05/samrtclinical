@using System.Globalization
@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("استيراد بيانات الأقسام", "Bulk Import Departments");
}

<div class="container py-4" style="max-width: 720px; direction: rtl; text-align: right;">
    <div class="mb-3">
        <a asp-controller="Departments" asp-action="Index" class="btn btn-sm btn-link text-body-secondary text-decoration-none d-inline-flex align-items-center gap-2">
            <i class="bi @(_isAr ? "bi-arrow-right" : "bi-arrow-left")"></i>
            <span>@T("العودة إلى قائمة الأقسام", "Back to Departments List")</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <!-- Cloud Header -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; background-color: #e8f5e9; color: #2e7d32;">
                <i class="bi bi-cloud-arrow-up-fill fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-dark">@T("استيراد الأقسام (Bulk Import)", "Bulk Import Departments")</h5>
                <span class="text-muted small">@T("رفع ملف CSV أو Excel لتسجيل البيانات دفعة واحدة", "Upload CSV or Excel file to record multiple records at once")</span>
            </div>
        </div>

        <form method="post" enctype="multipart/form-data" asp-controller="Departments" asp-action="Import">
            @Html.AntiForgeryToken()

            <!-- Template Download Section -->
            <div class="border rounded-3 p-3 mb-3 bg-white d-flex justify-content-between align-items-center" style="border-color: #e5e7eb !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #e8f5e9; color: #2e7d32;">
                        <i class="bi bi-file-earmark-spreadsheet-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">@T("قالب الأقسام الجاهز", "Departments Ready Template")</div>
                        <div class="text-muted small">@T("تحميل ملف CSV بالأعمدة المطلوبة", "Download CSV template with required columns")</div>
                    </div>
                </div>
                <div>
                    <a href="@Url.Action("DownloadTemplate", "Departments")" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-pill bg-white text-secondary fw-semibold border shadow-sm">
                        <i class="bi bi-download me-1 text-success"></i> @T("تحميل القالب", "Download Template")
                    </a>
                </div>
            </div>

            <!-- File Input -->
            <div class="mb-3">
                <label class="form-label fw-bold text-dark small mb-1">* @T("اختر ملف CSV أو Excel:", "Select CSV or Excel file:")</label>
                <input type="file" name="file" class="form-control form-control-lg fs-6 rounded-3" accept=".csv, .xlsx, .xls" required />
            </div>

            <!-- Required Columns Guide -->
            <div class="rounded-3 p-3 mb-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                <div class="d-flex align-items-center gap-2 mb-2 text-dark fw-bold small">
                    <i class="bi bi-info-circle-fill text-secondary"></i>
                    <span>@T("الأعمدة المطلوبة في الملف:", "Required Columns in File:")</span>
                </div>
                <div class="row g-2 text-secondary small">
                    <div class="col-12">
                        <span class="fw-bold text-dark">DepartmentName:</span> @T("اسم القسم الطبي (3 - 100 حرفاً)", "Department Name (3 - 100 chars)")
                    </div>
                    <div class="col-12">
                        <span class="fw-bold text-dark">DepartmentCode:</span> @T("رمز القسم الفريد (مثل DENT, CARD, PED)", "Unique Code (e.g. DENT, CARD, PED)")
                    </div>
                </div>
            </div>

            <!-- Buttons at Bottom -->
            <div class="d-flex justify-content-start align-items-center gap-2 pt-3 border-top">
                <button type="submit" class="btn text-white px-4 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #198754; border-color: #198754;">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <span>@T("بدء الاستيراد", "Start Import")</span>
                </button>
                <a href="@Url.Action("Index", "Departments")" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                    @T("إلغاء", "Cancel")
                </a>
            </div>
        </form>
    </div>
</div>
