@model WebApplication1.Models.ClinicSettingsViewModel
@using System.Globalization

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("ساعات العمل والمواعيد", "Working Hours & Slots");
}

@* ── Toast Notifications ──────────────────────────────────────────────── *@
@if (TempData["Success"] != null)
{
    <div class="mb-4 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center justify-between gap-3 shadow-sm">
        <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-circle-check text-sm shrink-0"></i>
            <div><strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]</div>
        </div>
        <button type="button" class="text-emerald-400 hover:text-emerald-300 text-xs" onclick="this.parentElement.remove()">✕</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center justify-between gap-3 shadow-sm">
        <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-circle-exclamation text-sm shrink-0"></i>
            <div><strong>@T("خطأ:", "Error:")</strong> @TempData["Error"]</div>
        </div>
        <button type="button" class="text-rose-400 hover:text-rose-300 text-xs" onclick="this.parentElement.remove()">✕</button>
    </div>
}

<div class="container-fluid py-4 max-w-4xl mx-auto space-y-6" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Header Bar ──────────────────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a asp-controller="Settings" asp-action="Index" class="text-xs font-semibold text-[#727A76] dark:text-[#9CA8A3] hover:underline flex items-center gap-1">
                    <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left") text-[10px]"></i>
                    <span>@T("مركز الإعدادات", "Settings Hub")</span>
                </a>
                <span class="text-[#727A76] dark:text-[#9CA8A3]">/</span>
                <span class="text-xs font-semibold text-[#49665A] dark:text-emerald-400">@T("ساعات العمل", "Working Hours")</span>
            </div>
            <h1 class="text-lg sm:text-xl font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                @T("إعدادات دوام العيادة وجدولة المواعيد", "Operating Hours & Slot Configuration")
            </h1>
            <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0 mt-1">
                @T("تحديد أوقات بدء ونهاية الدوام، مدة الموعد الافتراضية، أيام العمل، وخاصية التأكيد التلقائي",
                   "Configure daily clinic shift hours, default appointment length, working days, and auto-confirmation")
            </p>
        </div>
        <a asp-controller="Settings" asp-action="Index"
           class="px-3.5 py-2 border border-[#DDE3DF] dark:border-[#2B3833] bg-transparent hover:bg-gray-100 dark:hover:bg-[#151E1B] text-[#727A76] dark:text-[#EAEFEA] text-xs font-semibold rounded-xl transition flex items-center gap-1.5 self-start sm:self-center">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            <span>@T("العودة للإعدادات", "Back to Hub")</span>
        </a>
    </div>

    <form asp-controller="Settings" asp-action="UpdateWorkingHours" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-2xl shadow-sm p-6 space-y-6">

            @* Section Title *@
            <div class="flex items-center gap-3 pb-4 border-b border-[#DDE3DF] dark:border-[#2B3833]">
                <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 border border-[#49665A]/20 flex items-center justify-center text-[#49665A] text-base shrink-0">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                        @T("جدول المواعيد والدوام اليومي", "Daily Shift & Slot Settings")
                    </h2>
                    <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0">
                        @T("تتحكم هذه الإعدادات في حجز المواعيد والتقويم اليومي للأطباء", "Controls patient calendar booking intervals and doctor shift boundaries")
                    </p>
                </div>
            </div>

            @* Working Hours Inputs *@
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="WorkingHoursStart" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        @T("بداية الدوام اليومي", "Opening Time") <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="WorkingHoursStart" type="time"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" required />
                </div>

                <div>
                    <label asp-for="WorkingHoursEnd" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        @T("نهاية الدوام اليومي", "Closing Time") <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="WorkingHoursEnd" type="time"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" required />
                </div>

                <div>
                    <label asp-for="DefaultSlotDurationMinutes" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                        @T("مدة الكشف الافتراضية (بالدقائق)", "Slot Duration (Minutes)") <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="DefaultSlotDurationMinutes" type="number" step="5" min="5" max="240"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:ring-1 focus:ring-[#49665A] outline-none transition" required />
                </div>
            </div>

            @* ── Working Days Selection ───────────────────────────────── *@
            <div class="pt-4 border-t border-[#DDE3DF] dark:border-[#2B3833] space-y-3">
                <div class="flex items-center justify-between">
                    <label class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] m-0">
                        @T("أيام العمل الأسبوعية", "Weekly Working Days")
                    </label>
                    <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400" id="activeDaysCount">
                        <!-- Populated by JS -->
                    </span>
                </div>

                @{
                    var selectedDays = (Model.WorkingDays ?? "Sunday, Monday, Tuesday, Wednesday, Thursday")
                        .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                        .Select(d => d.Trim())
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);

                    var dayNames = new[]
                    {
                        ("Sunday",    "الأحد",    "Sun"),
                        ("Monday",    "الاثنين",  "Mon"),
                        ("Tuesday",   "الثلاثاء", "Tue"),
                        ("Wednesday", "الأربعاء", "Wed"),
                        ("Thursday",  "الخميس",   "Thu"),
                        ("Friday",    "الجمعة",   "Fri"),
                        ("Saturday",  "السبت",    "Sat"),
                    };
                }

                <div class="flex flex-wrap gap-2.5" id="dayGrid">
                    @foreach (var (en, ar, shortEn) in dayNames)
                    {
                        var isActive = selectedDays.Contains(en);
                        <button type="button"
                                class="day-toggle-btn min-w-[54px] py-2 px-3 text-xs rounded-xl transition-all duration-150 text-center select-none cursor-pointer flex items-center justify-center @(isActive ? "bg-emerald-600 hover:bg-emerald-500 text-white font-bold border border-emerald-400 shadow-md shadow-emerald-900/30 scale-[1.02]" : "bg-[#151E1B] hover:bg-[#1B2421] border border-[#2B3833] text-[#727A76] font-medium opacity-60 hover:opacity-100")"
                                data-day="@en"
                                data-active="@(isActive ? "true" : "false")"
                                onclick="toggleDay(this)">
                            <i class="fa-solid fa-check text-[10px] me-1 check-icon @(isActive ? "" : "hidden")"></i>
                            <span class="day-text">@(_isAr ? ar : shortEn)</span>
                        </button>
                    }
                </div>
                <input type="hidden" asp-for="WorkingDays" id="hiddenWorkingDays" />
                <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0">
                    @T("انقر على اليوم لتفعيله (يوم عمل أخضر) أو تعطيله (عطلة أسبوعية) في مواعيد الحجز والتقويم", "Click any day to toggle between active working day (emerald green) and off day (muted)")
                </p>
            </div>

            @* ── Auto-Confirm Toggle ──────────────────────────────────── *@
            <div class="p-4 rounded-xl border flex items-center justify-between gap-4 bg-[#F6F7F5] dark:bg-[#151E1B] border-[#DDE3DF] dark:border-[#2B3833]">
                <div>
                    <h3 class="text-xs sm:text-sm font-bold m-0 text-[#202725] dark:text-[#EAEFEA]">
                        @T("تأكيد المواعيد الجديدة تلقائياً", "Auto-Confirm New Bookings")
                    </h3>
                    <p class="text-[11px] sm:text-xs m-0 mt-1 text-[#727A76] dark:text-[#9CA8A3]">
                        @T("يتم تحويل حالة الموعد الجديد إلى 'مؤكد' فور الحجز دون الحاجة لتأكيد يدوي من الاستقبال.",
                           "New appointments automatically transition to 'Confirmed' state upon booking without manual receptionist review.")
                    </p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer shrink-0">
                    <input asp-for="AutoConfirmAppointments" type="checkbox" class="sr-only peer" />
                    <div class="w-11 h-6 bg-gray-300 dark:bg-[#2B3833] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#49665A]"></div>
                </label>
            </div>
        </div>

        @* ── Actions Footer ───────────────────────────────────────────── *@
        <div class="flex items-center justify-between pt-2">
            <a asp-controller="Settings" asp-action="Index"
               class="px-4 py-2.5 border border-[#DDE3DF] dark:border-[#2B3833] bg-transparent hover:bg-gray-100 dark:hover:bg-[#151E1B] text-[#727A76] dark:text-[#EAEFEA] text-xs font-semibold rounded-xl transition flex items-center gap-1.5">
                <i class="fa-solid fa-xmark text-xs"></i>
                <span>@T("إلغاء", "Cancel")</span>
            </a>
            <button type="submit"
                    class="px-5 py-2.5 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl shadow-sm transition flex items-center gap-2">
                <i class="fa-solid fa-floppy-disk text-xs"></i>
                <span>@T("حفظ ساعات العمل", "Save Working Hours")</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const activeClasses = [
        "bg-emerald-600",
        "hover:bg-emerald-500",
        "text-white",
        "font-bold",
        "border",
        "border-emerald-400",
        "shadow-md",
        "shadow-emerald-900/30",
        "scale-[1.02]"
    ];

    const inactiveClasses = [
        "bg-[#151E1B]",
        "hover:bg-[#1B2421]",
        "border",
        "border-[#2B3833]",
        "text-[#727A76]",
        "font-medium",
        "opacity-60",
        "hover:opacity-100"
    ];

    function toggleDay(btn) {
        const isCurrentlyActive = btn.getAttribute("data-active") === "true";
        const nextState = !isCurrentlyActive;
        btn.setAttribute("data-active", nextState ? "true" : "false");

        const checkIcon = btn.querySelector(".check-icon");

        if (nextState) {
            // Switch to Active Emerald Styling
            btn.classList.remove(...inactiveClasses);
            btn.classList.add(...activeClasses);
            if (checkIcon) checkIcon.classList.remove("hidden");
        } else {
            // Switch to Inactive Styling
            btn.classList.remove(...activeClasses);
            btn.classList.add(...inactiveClasses);
            if (checkIcon) checkIcon.classList.add("hidden");
        }

        updateHiddenDays();
    }

    function updateHiddenDays() {
        const buttons = Array.from(document.querySelectorAll("#dayGrid .day-toggle-btn"));
        const activeDays = buttons
            .filter(b => b.getAttribute("data-active") === "true")
            .map(b => b.getAttribute("data-day"));

        const hidden = document.getElementById("hiddenWorkingDays");
        if (hidden) {
            hidden.value = activeDays.join(", ");
        }

        const countLabel = document.getElementById("activeDaysCount");
        if (countLabel) {
            countLabel.textContent = activeDays.length + " " + (activeDays.length === 1 ? "@T("يوم عمل نشط", "Active Working Day")" : "@T("أيام عمل نشطة", "Active Working Days")");
        }
    }

    document.addEventListener("DOMContentLoaded", updateHiddenDays);
</script>
}
