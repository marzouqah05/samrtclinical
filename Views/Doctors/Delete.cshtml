@model Doctor

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("حذف الطبيب", "Delete Doctor");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>

    body {
        background: #f5f7fb;
    }

    .delete-container {
        max-width: 850px;
        margin: auto;
    }

    .delete-card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .delete-header {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        padding: 40px;
        color: white;
        text-align: center;
    }

    .delete-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        font-size: 40px;
        margin-bottom: 20px;
    }

    .delete-header h2 {
        margin: 0;
        font-weight: bold;
    }

    .delete-header p {
        margin-top: 10px;
        opacity: 0.9;
    }

    .delete-body {
        padding: 35px;
    }

    .doctor-card {
        background: #f8fafc;
        border-radius: 24px;
        padding: 30px;
    }

    .doctor-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #10b981;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 40px;
        font-weight: bold;
        margin: auto;
        margin-bottom: 20px;
    }

    .doctor-name {
        text-align: center;
        margin-bottom: 35px;
    }

        .doctor-name h3 {
            margin-bottom: 8px;
            font-weight: bold;
        }

    .specialization-badge {
        background: #dcfce7;
        color: #16a34a;
        padding: 8px 16px;
        border-radius: 30px;
        display: inline-block;
        font-size: 13px;
        font-weight: 600;
    }

    .info-item {
        margin-bottom: 22px;
    }

    .info-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .info-value {
        font-size: 17px;
        font-weight: 600;
        color: #0f172a;
    }

    .warning-box {
        background: #fee2e2;
        color: #b91c1c;
        padding: 18px;
        border-radius: 18px;
        margin-top: 30px;
    }

    .delete-btn {
        background: #ef4444;
        border: none;
        border-radius: 16px;
        padding: 14px 28px;
        font-weight: 600;
        transition: 0.3s;
    }

        .delete-btn:hover {
            background: #dc2626;
            transform: translateY(-2px);
        }

    .back-btn {
        border-radius: 16px;
        padding: 14px 24px;
    }

</style>

<div class="delete-container" dir="@(_isAr ? "rtl" : "ltr")">

    <div class="delete-card">

        <!-- Header -->
        <div class="delete-header">

            <div class="delete-icon">

                <i class="fa-solid fa-user-doctor"></i>

            </div>

            <h2>@T("حذف الطبيب", "Delete Doctor")</h2>

            <p>
                @T("هل أنت متأكد من حذف هذا الطبيب نهائياً؟", "Are you sure you want to permanently delete this doctor?")
            </p>

        </div>

        <!-- Body -->
        <div class="delete-body">

            <div class="doctor-card">

                <!-- Doctor -->
                <div class="doctor-name">

                    <div class="doctor-avatar">

                        @Model.DoctorName.Substring(0, 1).ToUpper()

                    </div>

                    <h3>
                        @(_isAr ? "د." : "Dr.") @Model.DoctorName
                    </h3>

                    <span class="specialization-badge">
                        @Model.Specialization
                    </span>

                </div>

                <!-- Information -->
                <div class="row">

                    <!-- Doctor Number -->
                    <div class="col-md-6 info-item">

                        <div class="info-label">
                            @T("رقم الطبيب", "Doctor Number")
                        </div>

                        <div class="info-value">
                            @Model.DoctorNumber
                        </div>

                    </div>

                    <!-- Consultation Fee -->
                    <div class="col-md-6 info-item">

                        <div class="info-label">
                            @T("كشفية الطبيب", "Consultation Fee")
                        </div>

                        <div class="info-value">
                            $@Model.ConsultationFee
                        </div>

                    </div>

                    <!-- Department -->
                    <div class="col-md-12 info-item">

                        <div class="info-label">
                            @T("القسم", "Department")
                        </div>

                        <div class="info-value">
                            @Model.Department?.DepartmentName
                        </div>

                    </div>

                </div>

            </div>

            <!-- Warning -->
            <div class="warning-box">

                <i class="fa-solid fa-triangle-exclamation"></i>

                @T("لا يمكن التراجع عن هذا الإجراء. حذف هذا الطبيب قد يؤثر على المواعيد والجدولة الطبية.", "This action cannot be undone. Deleting this doctor may affect appointments and medical scheduling.")

            </div>

            <!-- Buttons -->
            <form asp-action="Delete" class="mt-4">

                <input type="hidden" asp-for="DoctorId" />

                <div class="d-flex gap-3">

                    <button type="submit"
                            class="btn btn-danger delete-btn">

                        <i class="fa-solid fa-trash"></i>
                        @T("حذف الطبيب", "Delete Doctor")

                    </button>

                    <a asp-action="Index"
                       class="px-4 py-2.5 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-xmark text-xs"></i>
                        <span>@T("إلغاء", "Cancel")</span>
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>