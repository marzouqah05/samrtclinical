@using System.Globalization
@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("استيراد بيانات الأطباء", "Bulk Import Doctors");
}

<div class="max-w-4xl mx-auto py-6 px-4" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="mb-4">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left") text-xs"></i>
            <span>@T("العودة إلى قائمة الأطباء", "Back to Doctors List")</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flex items-center justify-between p-4 mb-6 rounded-xl border border-emerald-500/20 bg-emerald-50/80 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-200 shadow-sm backdrop-blur-sm">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200 m-0">@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center justify-between p-4 mb-6 rounded-xl border border-rose-500/20 bg-rose-50/80 dark:bg-rose-950/30 text-rose-900 dark:text-rose-200 shadow-sm backdrop-blur-sm">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-rose-500/20 flex items-center justify-center text-rose-600 dark:text-rose-400 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <p class="text-sm font-semibold text-rose-800 dark:text-rose-200 m-0">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl p-6 sm:p-8 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 overflow-hidden">
        <!-- Header -->
        <div class="flex items-center gap-3.5 mb-6">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
            </div>
            <div>
                <h2 class="text-slate-900 dark:text-white font-bold text-lg m-0">
                    @T("استيراد بيانات الأطباء دفعة واحدة", "Bulk Import Doctors")
                </h2>
                <p class="text-slate-500 dark:text-slate-400 font-normal text-xs sm:text-sm m-0 mt-0.5">
                    @T("رفع ملف CSV أو Excel لإضافة وتحديث بيانات الأطباء سريعاً", "Upload CSV or Excel file to quickly import or update doctor records")
                </p>
            </div>
        </div>

        <form method="post" enctype="multipart/form-data" asp-action="Import" id="importDoctorsStandaloneForm">
            @Html.AntiForgeryToken()

            <!-- Template Download Banner -->
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold font-mono text-xs">
                        CSV
                    </div>
                    <div>
                        <div class="text-slate-900 dark:text-slate-100 font-semibold text-sm">
                            @T("قالب بيانات الأطباء القياسي", "Standard Doctors Data Template")
                        </div>
                        <div class="text-slate-500 dark:text-slate-400 font-normal text-xs mt-0.5">
                            @T("حمّل القالب المعتمد للتعرف على صيغة الأعمدة والبيانات المطلوبة", "Download the verified template to match required column headers and formatting")
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("DownloadTemplate")" class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 font-medium text-xs transition-colors shrink-0">
                    <i class="fa-solid fa-download text-xs text-emerald-600 dark:text-emerald-400"></i>
                    <span>@T("تحميل قالب CSV", "Download CSV Template")</span>
                </a>
            </div>

            <!-- Dropzone Component -->
            <div class="mb-6">
                <div id="doctorStandaloneDropzone"
                     class="relative border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-500 rounded-2xl p-8 text-center cursor-pointer transition bg-slate-50/50 dark:bg-slate-800/30 group">
                    
                    <input type="file" id="doctorStandaloneFileInput" name="file" class="hidden" accept=".csv, .xlsx, .xls" required onchange="handleStandaloneFileSelected(this)" />
                    
                    <!-- Empty / Prompt State -->
                    <div id="standalonePrompt" class="py-2">
                        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-slate-100 dark:bg-slate-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/50 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 flex items-center justify-center transition">
                            <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
                        </div>
                        <p class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                            <span class="text-emerald-600 dark:text-emerald-400 font-semibold hover:underline">@T("اضغط لتصفح الملف", "Click to browse")</span>
                            @T("أو اسحب وأفلت الملف هنا", "or drag and drop your file here")
                        </p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 m-0">
                            @T("الصيغ المدعومة: .csv, .xlsx (الحد الأقصى 10MB)", "Supported formats: .csv, .xlsx (Max 10MB)")
                        </p>
                    </div>

                    <!-- Selected File State -->
                    <div id="standaloneSelected" class="hidden flex items-center justify-between p-3.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-start shadow-sm">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-file-csv text-lg"></i>
                            </div>
                            <div class="min-w-0">
                                <p id="standaloneFileName" class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate m-0"></p>
                                <p id="standaloneFileSize" class="text-xs text-slate-500 dark:text-slate-400 m-0 mt-0.5"></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button" onclick="event.stopPropagation(); document.getElementById('doctorStandaloneFileInput').click();" class="px-2.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-lg transition-colors border-0 bg-transparent cursor-pointer">
                                @T("تغيير", "Change")
                            </button>
                            <button type="button" onclick="event.stopPropagation(); removeStandaloneSelected();" class="p-1.5 text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors border-0 bg-transparent cursor-pointer" title="@T("إزالة الملف", "Remove file")">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Required Specifications as Pill Badges -->
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/50 p-4 mb-6">
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">
                        @T("الأعمدة المطلوبة في الملف ومواصفاتها:", "Required Columns Specifications:")
                    </span>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">FullName</span>
                        <span class="text-[11px] opacity-75">(@T("مطلوب", "Required"))</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">Specialization</span>
                        <span class="text-[11px] opacity-75">(@T("مطلوب", "Required"))</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">Phone</span>
                        <span class="text-[11px] opacity-75">(@T("مطلوب", "Required"))</span>
                    </div>
                    <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                        <span class="font-bold text-slate-600 dark:text-slate-400">DepartmentName</span>
                        <span class="text-[11px] opacity-75">(@T("اختياري / ينشأ تلقائياً", "Optional / Auto-created"))</span>
                    </div>
                </div>
            </div>

            <!-- Actions Footer -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                <a asp-action="Index" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-4 py-2.5 rounded-lg text-sm transition cursor-pointer inline-flex items-center">
                    @T("إلغاء", "Cancel")
                </a>
                <button type="submit"
                        class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-5 py-2.5 rounded-lg shadow-sm inline-flex items-center gap-2 border-0 cursor-pointer text-sm transition active:scale-95">
                    <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                    <span>@T("بدء الاستيراد", "Start Import")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dropzone = document.getElementById('doctorStandaloneDropzone');
            const fileInput = document.getElementById('doctorStandaloneFileInput');

            if (dropzone && fileInput) {
                dropzone.addEventListener('click', function (e) {
                    if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                        fileInput.click();
                    }
                });

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                dropzone.addEventListener('drop', function (e) {
                    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        handleStandaloneFileSelected(fileInput);
                    }
                });
            }
        });

        function handleStandaloneFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const nameEl = document.getElementById('standaloneFileName');
                const sizeEl = document.getElementById('standaloneFileSize');
                const promptEl = document.getElementById('standalonePrompt');
                const selectedEl = document.getElementById('standaloneSelected');

                if (nameEl) nameEl.textContent = file.name;
                if (sizeEl) {
                    const sizeKb = (file.size / 1024).toFixed(1);
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                    sizeEl.textContent = file.size > 1024 * 1024 ? `${sizeMb} MB` : `${sizeKb} KB`;
                }

                if (promptEl) promptEl.classList.add('hidden');
                if (selectedEl) {
                    selectedEl.classList.remove('hidden');
                    selectedEl.classList.add('flex');
                }
            }
        }

        function removeStandaloneSelected() {
            const fileInput = document.getElementById('doctorStandaloneFileInput');
            const promptEl = document.getElementById('standalonePrompt');
            const selectedEl = document.getElementById('standaloneSelected');

            if (fileInput) fileInput.value = '';
            if (promptEl) promptEl.classList.remove('hidden');
            if (selectedEl) {
                selectedEl.classList.add('hidden');
                selectedEl.classList.remove('flex');
            }
        }
    </script>
}
