@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("استيراد بيانات الأطباء", "Bulk Import Doctors");
}

<div class="container py-4" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm btn-link text-body-secondary text-decoration-none d-inline-flex align-items-center gap-2">
            <i class="bi @(_isAr ? "bi-arrow-right" : "bi-arrow-left")"></i>
            <span>@T("العودة إلى قائمة الأطباء", "Back to Doctors List")</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="modal-dialog modal-dialog-centered modal-lg m-auto">
        <div class="modal-content border-0 shadow rounded-4 p-4 bg-white">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-cloud-arrow-up-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            @T("استيراد الأطباء (Bulk Import)", "Bulk Import Doctors")
                        </h5>
                        <p class="text-muted small mb-0">
                            @T("رفع ملف CSV أو Excel لتسجيل البيانات دفعة واحدة", "Upload CSV or Excel file to record multiple records at once")
                        </p>
                    </div>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data" asp-action="Import">
                @Html.AntiForgeryToken()

                <!-- Template Download Box -->
                <div class="border rounded-3 p-3 mb-4 bg-white" style="border-color: #e2e8f0 !important;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3" style="width: 100%;">
                        <!-- Right side: Green File Icon + Title -->
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success bg-opacity-10 text-success rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                                <i class="bi bi-file-earmark-spreadsheet-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark fs-6 mb-0">@T("قالب الأطباء الجاهز", "Doctors Ready Template")</div>
                                <div class="text-muted small">@T("تحميل ملف CSV بالأعمدة المطلوبة", "Download CSV template with required columns")</div>
                            </div>
                        </div>

                        <!-- Left side: Download Button -->
                        <div class="flex-shrink-0">
                            <a href="@Url.Action("DownloadTemplate")" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill fw-semibold border bg-white text-dark shadow-sm">
                                <i class="bi bi-download me-1 text-success"></i> @T("تحميل القالب", "Download Template")
                            </a>
                        </div>
                    </div>
                </div>

                <!-- File Input -->
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark small mb-1">* @T("اختر ملف CSV أو Excel:", "Select CSV or Excel file:")</label>
                    <input type="file" name="file" class="form-control form-control-lg fs-6 rounded-3" accept=".csv, .xlsx, .xls" required />
                </div>

                <!-- Required Columns Guide -->
                <div class="rounded-3 p-3 mb-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                    <div class="d-flex align-items-center gap-2 mb-2 text-dark fw-bold small">
                        <i class="bi bi-info-circle-fill text-secondary"></i>
                        <span>@T("الأعمدة المطلوبة في الملف:", "Required Columns in File:")</span>
                    </div>
                    <div class="row g-2 text-secondary small">
                        <div class="col-md-6">
                            <span class="fw-bold text-dark">FullName:</span> @T("اسم الطبيب بالكامل (3 - 150 حرفاً)", "Doctor Full Name (3 - 150 characters)")
                        </div>
                        <div class="col-md-6">
                            <span class="fw-bold text-dark">Specialization:</span> @T("التخصص الطبي للطبيب", "Medical Specialization")
                        </div>
                        <div class="col-md-6">
                            <span class="fw-bold text-dark">Phone:</span> @T("رقم هاتف الطبيب للتواصل", "Doctor Phone / Mobile")
                        </div>
                        <div class="col-md-6">
                            <span class="fw-bold text-dark">DepartmentName:</span> @T("اسم القسم التابع له (تلقائي إن لم يتوفر)", "Department Name (auto-created if not found)")
                        </div>
                    </div>
                </div>

                <!-- Action Buttons Footer -->
                <div class="d-flex justify-content-start align-items-center gap-2 pt-2 border-top">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <span>@T("بدء الاستيراد", "Start Import")</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        @T("إلغاء", "Cancel")
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
