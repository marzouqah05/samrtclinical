@model IEnumerable<WebApplication1.Models.Doctor>
@using System.Text.Json

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("إدارة الأطباء", "Doctors Management");

    List<string>? importErrors = null;
    if (TempData["ImportErrors"] != null)
    {
        try
        {
            importErrors = JsonSerializer.Deserialize<List<string>>(TempData["ImportErrors"]!.ToString()!);
        }
        catch { }
    }
}

<style>
    /* Theme overrides handled via utility classes */
</style>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" dir="@(_isAr ? "rtl" : "ltr")">

    <!-- الترويسة وأزرار العمليات المجمعة -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h2 class="text-[#202725] dark:text-[#EAEFEA] font-bold text-xl m-0 flex items-center gap-2">
                <i class="fa-solid fa-user-doctor text-[#49665A]"></i>
                <span>@T("إدارة الأطباء", "Doctors Management")</span>
            </h2>
            <p class="text-[#727A76] dark:text-[#9CA8A3] text-xs m-0 mt-1">@T("عرض وبحث وإدارة أطباء العيادة وتخصصاتهم واستيراد الملفات", "View, search, and manage clinic physicians, specialties, and bulk files")</p>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
            @if (!User.IsDoctor())
            {
                <!-- 📥 Import Doctors Button -->
                <button type="button" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 dark:border-slate-700/80 font-medium px-4 py-2 rounded-lg text-sm transition inline-flex items-center gap-2 shadow-sm cursor-pointer" data-bs-toggle="modal" data-bs-target="#importDoctorsModal" title="@T("استيراد بيانات الأطباء من CSV", "Bulk import doctors from CSV")">
                    <i class="fa-solid fa-file-import text-slate-500 dark:text-slate-400"></i>
                    <span>@T("استيراد أطباء", "Import Doctors")</span>
                </button>

                <!-- 📤 Export Doctors Button -->
                <a asp-action="Export" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 dark:border-slate-700/80 font-medium px-4 py-2 rounded-lg text-sm transition inline-flex items-center gap-2 shadow-sm" title="@T("تصدير جميع الأطباء إلى CSV", "Export all doctors to CSV")">
                    <i class="fa-solid fa-file-excel text-emerald-500"></i>
                    <span>@T("تصدير CSV", "Export to CSV")</span>
                </a>

                @if (User.IsAdminOrOwner())
                {
                    <!-- ➕ Add Doctor Button -->
                    <a asp-action="Create" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-5 py-2.5 rounded-lg shadow-sm transition active:scale-95 inline-flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-plus text-xs"></i>
                        <span>@T("إضافة طبيب جديد", "Add New Doctor")</span>
                    </a>
                }
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 text-xs font-semibold">
                    <i class="fa-solid fa-hospital-user text-xs"></i>
                    <span>@T("أطباء وزملائي في نفس القسم والتخصص", "My Department Colleagues")</span>
                </span>
            }
        </div>
    </div>

    @* ─── Notification Alerts ─── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-xl shadow-sm border-0 d-flex align-items-center mb-4 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20" role="alert">
            <i class="fa-solid fa-circle-check fs-5 @(_isAr ? "ms-3" : "me-3") text-emerald-600 dark:text-emerald-400"></i>
            <div class="text-xs">
                <strong>@T("تم بنجاح!", "Success!")</strong> @TempData["Success"]
            </div>
            <button type="button" class="btn-close dark:invert @(_isAr ? "me-auto ms-0" : "ms-auto me-0")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-xl shadow-sm border-0 d-flex align-items-center mb-4 bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5 @(_isAr ? "ms-3" : "me-3") text-amber-600 dark:text-amber-400"></i>
            <div class="text-xs">
                <strong>@T("تنبيه:", "Notice:")</strong> @TempData["Warning"]
            </div>
            <button type="button" class="btn-close dark:invert @(_isAr ? "me-auto ms-0" : "ms-auto me-0")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-xl shadow-sm border-0 d-flex align-items-center mb-4 bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20" role="alert">
            <i class="fa-solid fa-circle-exclamation fs-5 @(_isAr ? "ms-3" : "me-3") text-rose-600 dark:text-rose-400"></i>
            <div class="text-xs">
                <strong>@T("خطأ:", "Error:")</strong> @TempData["Error"]
            </div>
            <button type="button" class="btn-close dark:invert @(_isAr ? "me-auto ms-0" : "ms-auto me-0")" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* ─── Detailed Import Error Log (if any rows were skipped) ─── *@
    @if (importErrors != null && importErrors.Any())
    {
        <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm p-4 mb-4 border-s-4 border-s-amber-400">
            <div class="d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#doctorImportErrorsCollapse" style="cursor: pointer;">
                <div class="font-bold text-xs text-[#1A2621] dark:text-[#EAEFEA] d-flex align-items-center gap-2">
                    <i class="fa-solid fa-list-check text-amber-500"></i>
                    <span>@T("تفاصيل الصفوف المستبعدة أثناء استيراد الأطباء", "Details of Skipped Rows During Import") (@importErrors.Count)</span>
                </div>
                <span class="px-2.5 py-1 rounded-lg text-[11px] bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#9CA8A3]">@T("اضغط للتفاصيل", "Click to view") <i class="fa-solid fa-chevron-down ms-1"></i></span>
            </div>
            <div class="collapse mt-3" id="doctorImportErrorsCollapse">
                <ul class="list-group list-group-flush small" style="max-height: 220px; overflow-y: auto;">
                    @foreach (var err in importErrors)
                    {
                        <li class="list-group-item bg-transparent text-rose-600 dark:text-rose-400 px-0 py-1 d-flex align-items-start gap-2 border-b border-[#E5E9E7] dark:border-[#2B3833]">
                            <i class="fa-solid fa-circle-xmark mt-1 text-xs"></i>
                            <span class="text-xs">@err</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @* ─── Scoped Department Banner for Doctor Role ─── *@
    @if (User.IsDoctor() && ViewBag.IsDoctorScoped == true)
    {
        <div class="mb-6 p-4 rounded-2xl bg-[#49665A]/10 border border-[#49665A]/25 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#49665A]/20 text-[#49665A] dark:text-[#83a89a] flex items-center justify-center text-base shrink-0">
                    <i class="fa-solid fa-hospital-user"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                        @T($"قسمي: {ViewBag.ScopedDepartmentName} - الزملاء والتخصصات", $"My Department: {ViewBag.ScopedDepartmentName} Colleagues & Specialties")
                    </h3>
                    <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0 mt-0.5">
                        @T("عرض مخصص للزملاء والكوادر الطبية التابعة لقسمك الطبي المعتمد فقط لتعزيز التعاون وسهولة التحويل.", "Scoped view displaying solely colleagues and clinical staff in your department.")
                    </p>
                </div>
            </div>
            <span class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#49665A] text-white shrink-0 shadow-2xs">
                @Model.Count() @T("أطباء زملاء", "Colleagues")
            </span>
        </div>
    }

    @* ─── Department Filter Tabs for Admin/Owner/Receptionist ─── *@
    @if (!User.IsDoctor() && ViewBag.Departments is List<WebApplication1.Models.Department> depts && depts.Any())
    {
        int? selectedDeptId = ViewBag.SelectedDepartmentId as int?;
        <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-4 scrollbar-none">
            <a asp-action="Index" asp-route-departmentId="" asp-route-search="@ViewContext.HttpContext.Request.Query["search"]"
               class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition shrink-0 inline-flex items-center gap-1.5 @(!selectedDeptId.HasValue || selectedDeptId == 0 ? "bg-[#49665A] text-white shadow-2xs" : "bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] text-[#727A76] dark:text-[#9CA8A3] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                <i class="fa-solid fa-layer-group text-[10px]"></i>
                <span>@T("جميع الأقسام", "All Departments")</span>
            </a>
            @foreach (var dept in depts)
            {
                bool isSelected = selectedDeptId == dept.DepartmentId;
                <a asp-action="Index" asp-route-departmentId="@dept.DepartmentId" asp-route-search="@ViewContext.HttpContext.Request.Query["search"]"
                   class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition shrink-0 inline-flex items-center gap-1.5 @(isSelected ? "bg-[#49665A] text-white shadow-2xs" : "bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] text-[#727A76] dark:text-[#9CA8A3] hover:text-[#202725] dark:hover:text-[#EAEFEA]")">
                    <span>@dept.DepartmentName</span>
                </a>
            }
        </div>
    }

    <!-- شريط البحث -->
    <form method="get" class="flex items-center gap-2 max-w-md w-full mb-6">
        @if (ViewBag.SelectedDepartmentId != null)
        {
            <input type="hidden" name="departmentId" value="@ViewBag.SelectedDepartmentId" />
        }
        <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#8A9992] dark:text-[#727A76]"></i>
            <input type="text" name="search" value="@ViewContext.HttpContext.Request.Query["search"]"
                   placeholder="@T("ابحث بالاسم أو التخصص أو القسم...", "Search by name, specialization, department...")" 
                   class="w-full ps-9 pe-4 py-2.5 text-xs bg-[#F8FAF9] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] rounded-xl text-[#1A2621] dark:text-[#EAEFEA] placeholder-[#8A9992] dark:placeholder-[#727A76] focus:outline-none focus:ring-1 focus:ring-[#49665A]" />
        </div>
        <button type="submit" class="px-4 py-2.5 bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shrink-0">
            <i class="fa-solid fa-magnifying-glass text-[10px]"></i>
            <span>@T("بحث", "Search")</span>
        </button>
    </form>

    <!-- جدول الأطباء -->
    <div class="bg-white dark:bg-[#1B2421] border border-[#E5E9E7] dark:border-[#2B3833] text-[#1A2621] dark:text-[#EAEFEA] rounded-2xl shadow-sm overflow-hidden w-full">
        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs table-auto border-collapse">
                <thead>
                    <tr class="bg-[#F4F7F5] dark:bg-[#151E1B] border-b border-[#E5E9E7] dark:border-[#2B3833] text-[11px] uppercase tracking-wider text-[#5C6E66] dark:text-[#9CA8A3] font-semibold">
                        <th class="ps-6 text-start w-[32%] py-3.5">@T("اسم الطبيب", "Doctor Name")</th>
                        <th class="text-start w-[28%] py-3.5">@T("التخصص والتخصص الفرعي", "Specialization & Sub-Specialty")</th>
                        <th class="text-start w-[20%] py-3.5">@T("القسم", "Department")</th>
                        <th class="pe-6 text-end w-[20%] py-3.5">@(User.IsDoctor() ? T("معلومات الزميل", "Colleague Info") : T("الإجراءات", "Actions"))</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-b border-[#E5E9E7] dark:border-[#2B3833] hover:bg-[#F9FBFA] dark:hover:bg-white/[0.02] transition">
                                <!-- قسم الاسم مع أيكون دكتور مصغر تفاعلي -->
                                <td class="ps-6 py-3.5">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-xl bg-[#49665A]/10 border border-[#49665A]/20 text-[#49665A] flex items-center justify-center shrink-0">
                                            <i class="fa-solid fa-user-doctor text-xs"></i>
                                        </div>
                                        <div>
                                            <div class="text-[#1A2621] dark:text-[#EAEFEA] font-semibold text-xs">Dr. @item.DoctorName</div>
                                            <div class="text-[#6B7D75] dark:text-[#9CA8A3] text-[10px]">ID: #@item.DoctorNumber</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- التخصص والتخصص الفرعي -->
                                <td class="py-3.5 text-[#1A2621] dark:text-[#EAEFEA] text-xs font-medium">
                                    <div class="flex flex-col gap-1">
                                        <span>@item.Specialization</span>
                                        @if (item.Specialty != null)
                                        {
                                            <span class="inline-flex items-center gap-1 text-[10px] text-blue-600 dark:text-blue-400 font-medium">
                                                <i class="fa-solid fa-certificate text-[9px]"></i>
                                                <span>@item.Specialty.Name</span>
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- القسم -->
                                <td class="py-3.5">
                                    @if (item.Department != null)
                                    {
                                        <span class="px-2.5 py-1 rounded-full bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#5C6E66] dark:text-[#9CA8A3] text-[11px] font-medium inline-flex items-center gap-1.5">
                                            <i class="fa-solid fa-building-medical text-[10px] text-[#49665A]"></i>
                                            <span>@item.Department.DepartmentName</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full bg-[#F4F7F5] dark:bg-[#151E1B] border border-[#D5DDD8] dark:border-[#2B3833] text-[#6B7D75] dark:text-[#727A76] text-[11px] font-medium inline-flex items-center gap-1.5">
                                            @T("غير مخصص", "Unassigned")
                                        </span>
                                    }
                                </td>

                                <!-- أزرار التحكم أو معلومات الزميل -->
                                <td class="py-3.5 text-end">
                                    @if (User.IsDoctor())
                                    {
                                        <div class="pe-6 flex items-center justify-end gap-2">
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-[#49665A]/10 text-[#49665A] dark:text-[#9CA8A3] border border-[#49665A]/20">
                                                <i class="fa-solid fa-stethoscope text-[10px]"></i>
                                                <span>@T("طبيب زميل في القسم", "Department Colleague")</span>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="inline-flex items-center gap-1.5 pe-6">
                                            <a asp-action="Edit" asp-route-id="@item.DoctorId"
                                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-white"
                                               title="@T("تعديل", "Edit")">
                                                <i class="fa-solid fa-pen text-[10px]"></i>
                                                <span>@T("تعديل", "Edit")</span>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.DoctorId"
                                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm bg-white border border-slate-200 text-cyan-600 hover:bg-cyan-50 hover:text-cyan-700 dark:bg-slate-800 dark:border-slate-700 dark:text-cyan-400 dark:hover:bg-slate-700 dark:hover:text-cyan-300"
                                               title="@T("تفاصيل", "Details")">
                                                <i class="fa-solid fa-circle-info text-[10px]"></i>
                                                <span>@T("تفاصيل", "Details")</span>
                                            </a>

                                            @if (User.IsAdminOrOwner())
                                            {
                                                <form asp-action="Delete" asp-route-id="@item.DoctorId" method="post" class="inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition shadow-sm bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 hover:text-rose-700 dark:bg-rose-950/40 dark:border-rose-900/50 dark:text-rose-400 dark:hover:bg-rose-900/60 dark:hover:text-rose-200"
                                                            onclick="return confirm('@T("هل أنت متأكد من حذف الدكتور بشكل نهائي?", "Are you sure you want to permanently delete Dr. " + item.DoctorName + "?")');" title="@T("حذف", "Delete")">
                                                        <i class="fa-solid fa-trash-can text-[10px]"></i>
                                                        <span>@T("حذف", "Delete")</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-[#6B7D75] dark:text-[#9CA8A3] py-12">
                                <i class="fa-solid fa-user-slash text-3xl d-block mb-3 opacity-40"></i>
                                <span class="text-xs">@T("لا يوجد أطباء مطابقون لمعايير البحث.", "No doctor records matched your search criteria.")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@* ─── 📥 Import Doctors Modal (Strict SaaS Medical UI) ─── *@
<div class="modal fade" id="importDoctorsModal" tabindex="-1" aria-labelledby="importDoctorsModalLabel" aria-hidden="true" dir="@(_isAr ? "rtl" : "ltr")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl p-6 sm:p-8 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 overflow-hidden text-start">
            
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
                    </div>
                    <div>
                        <h5 class="text-slate-900 dark:text-white font-bold text-lg m-0" id="importDoctorsModalLabel">
                            @T("استيراد بيانات الأطباء دفعة واحدة", "Bulk Import Doctors")
                        </h5>
                        <p class="text-slate-500 dark:text-slate-400 font-normal text-xs sm:text-sm m-0 mt-0.5">
                            @T("رفع ملف CSV أو Excel لإضافة وتحديث بيانات الأطباء سريعاً", "Upload CSV or Excel file to quickly import or update doctor records")
                        </p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border-0 bg-transparent cursor-pointer" data-bs-dismiss="modal" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form method="post" enctype="multipart/form-data" asp-action="Import" id="importDoctorsForm">
                @Html.AntiForgeryToken()

                <!-- Template Download Banner -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold font-mono text-xs">
                            CSV
                        </div>
                        <div>
                            <div class="text-slate-900 dark:text-slate-100 font-semibold text-sm">
                                @T("قالب بيانات الأطباء القياسي", "Standard Doctors Data Template")
                            </div>
                            <div class="text-slate-500 dark:text-slate-400 font-normal text-xs mt-0.5">
                                @T("حمّل القالب المعتمد للتعرف على صيغة الأعمدة والبيانات المطلوبة", "Download the verified template to match required column headers and formatting")
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("DownloadTemplate")" class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-white hover:bg-slate-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 font-medium text-xs transition-colors shrink-0">
                        <i class="fa-solid fa-download text-xs text-emerald-600 dark:text-emerald-400"></i>
                        <span>@T("تحميل قالب CSV", "Download CSV Template")</span>
                    </a>
                </div>

                <!-- Dropzone Component -->
                <div class="mb-6">
                    <div id="doctorDropzone"
                         class="relative border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-500 rounded-2xl p-8 text-center cursor-pointer transition bg-slate-50/50 dark:bg-slate-800/30 group">
                        
                        <input type="file" id="doctorFileInput" name="file" class="hidden" accept=".csv, .xlsx, .xls" required onchange="handleDoctorFileSelected(this)" />
                        
                        <!-- Empty / Prompt State -->
                        <div id="doctorDropzonePrompt" class="py-2">
                            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-slate-100 dark:bg-slate-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/50 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 flex items-center justify-center transition">
                                <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
                            </div>
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">
                                <span class="text-emerald-600 dark:text-emerald-400 font-semibold hover:underline">@T("اضغط لتصفح الملف", "Click to browse")</span>
                                @T("أو اسحب وأفلت الملف هنا", "or drag and drop your file here")
                            </p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 m-0">
                                @T("الصيغ المدعومة: .csv, .xlsx (الحد الأقصى 10MB)", "Supported formats: .csv, .xlsx (Max 10MB)")
                            </p>
                        </div>

                        <!-- Selected File State -->
                        <div id="doctorDropzoneFileSelected" class="hidden flex items-center justify-between p-3.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-start shadow-sm">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-file-csv text-lg"></i>
                                </div>
                                <div class="min-w-0">
                                    <p id="doctorSelectedFileName" class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate m-0"></p>
                                    <p id="doctorSelectedFileSize" class="text-xs text-slate-500 dark:text-slate-400 m-0 mt-0.5"></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="event.stopPropagation(); document.getElementById('doctorFileInput').click();" class="px-2.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-lg transition-colors border-0 bg-transparent cursor-pointer">
                                    @T("تغيير", "Change")
                                </button>
                                <button type="button" onclick="event.stopPropagation(); removeDoctorSelectedFile();" class="p-1.5 text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors border-0 bg-transparent cursor-pointer" title="@T("إزالة الملف", "Remove file")">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Required Specifications as Pill Badges -->
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-800/50 p-4 mb-6">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">
                            @T("الأعمدة المطلوبة في الملف ومواصفاتها:", "Required Columns Specifications:")
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-2.5">
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">FullName</span>
                            <span class="text-[11px] opacity-75">(@T("مطلوب", "Required"))</span>
                        </div>
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">Specialization</span>
                            <span class="text-[11px] opacity-75">(@T("مطلوب", "Required"))</span>
                        </div>
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">Phone</span>
                            <span class="text-[11px] opacity-75">(@T("مطلوب", "Required"))</span>
                        </div>
                        <div class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 gap-1.5">
                            <span class="font-bold text-slate-600 dark:text-slate-400">DepartmentName</span>
                            <span class="text-[11px] opacity-75">(@T("اختياري / ينشأ تلقائياً", "Optional / Auto-created"))</span>
                        </div>
                    </div>
                </div>

                <!-- Modal Actions Footer -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <button type="button" class="border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 px-4 py-2.5 rounded-lg text-sm transition cursor-pointer" data-bs-dismiss="modal">
                        @T("إلغاء", "Cancel")
                    </button>
                    <button type="submit" id="btnSubmitDoctorImport"
                            class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-5 py-2.5 rounded-lg shadow-sm inline-flex items-center gap-2 border-0 cursor-pointer text-sm transition active:scale-95">
                        <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                        <span>@T("بدء الاستيراد", "Start Import")</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dropzone = document.getElementById('doctorDropzone');
            const fileInput = document.getElementById('doctorFileInput');

            if (dropzone && fileInput) {
                dropzone.addEventListener('click', function (e) {
                    if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                        fileInput.click();
                    }
                });

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/20');
                    });
                });

                dropzone.addEventListener('drop', function (e) {
                    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        handleDoctorFileSelected(fileInput);
                    }
                });
            }
        });

        function handleDoctorFileSelected(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const nameEl = document.getElementById('doctorSelectedFileName');
                const sizeEl = document.getElementById('doctorSelectedFileSize');
                const promptEl = document.getElementById('doctorDropzonePrompt');
                const selectedEl = document.getElementById('doctorDropzoneFileSelected');

                if (nameEl) nameEl.textContent = file.name;
                if (sizeEl) {
                    const sizeKb = (file.size / 1024).toFixed(1);
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                    sizeEl.textContent = file.size > 1024 * 1024 ? `${sizeMb} MB` : `${sizeKb} KB`;
                }

                if (promptEl) promptEl.classList.add('hidden');
                if (selectedEl) {
                    selectedEl.classList.remove('hidden');
                    selectedEl.classList.add('flex');
                }
            }
        }

        function removeDoctorSelectedFile() {
            const fileInput = document.getElementById('doctorFileInput');
            const promptEl = document.getElementById('doctorDropzonePrompt');
            const selectedEl = document.getElementById('doctorDropzoneFileSelected');

            if (fileInput) fileInput.value = '';
            if (promptEl) promptEl.classList.remove('hidden');
            if (selectedEl) {
                selectedEl.classList.add('hidden');
                selectedEl.classList.remove('flex');
            }
        }
    </script>
}