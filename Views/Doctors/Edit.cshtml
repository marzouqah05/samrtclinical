@model WebApplication1.Models.Doctor

@{
    var _isAr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => _isAr ? ar : en;
    ViewData["Title"] = T("تعديل الطبيب", "Edit Doctor");
}

<div class="max-w-3xl mx-auto px-4 py-8" dir="@(_isAr ? "rtl" : "ltr")">

    @* ── Back Navigation Link ── *@
    <div class="mb-5">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-medium text-[#727A76] dark:text-[#9CA8A3] hover:text-[#202725] dark:hover:text-[#EAEFEA] transition-colors">
            <i class="fa-solid @(_isAr ? "fa-arrow-right" : "fa-arrow-left")"></i>
            <span>@T("العودة إلى قائمة الأطباء", "Back to Doctors List")</span>
        </a>
    </div>

    @* ── Outer Card Wrapper ── *@
    <div class="bg-white dark:bg-[#1B2421] border border-[#DDE3DF] dark:border-[#2B3833] rounded-2xl shadow-sm max-w-3xl mx-auto overflow-hidden">

        @* ── Form Card Header ── *@
        <div class="px-6 py-5 border-b border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#49665A]/10 border border-[#49665A]/20 flex items-center justify-center text-[#49665A] text-base shrink-0">
                <i class="fa-solid fa-user-pen"></i>
            </div>
            <div>
                <h1 class="text-sm sm:text-base font-bold text-[#202725] dark:text-[#EAEFEA] m-0">
                    @T("تعديل بيانات الطبيب", "Edit Doctor Profile")
                </h1>
                <p class="text-xs text-[#727A76] dark:text-[#9CA8A3] m-0">
                    @T("تحديث معلومات الطبيب والتخصص وتعيين القسم.", "Update doctor information, specialization, and department.")
                </p>
            </div>
        </div>

        @* ── Form Inner Body ── *@
        <form asp-action="Edit" method="post" class="p-6 sm:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DoctorId" />
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs"></div>

            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-[#49665A] dark:text-[#9CA8A3] mb-4 block">
                    @T("معلومات الطبيب", "Doctor Information")
                </span>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Doctor Number -->
                    <div>
                        <label asp-for="DoctorNumber" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("رقم الطبيب", "Doctor Number") *
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-id-card absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="DoctorNumber"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                                   placeholder="@T("أدخل رقم الطبيب", "Enter doctor number")" />
                        </div>
                        <span asp-validation-for="DoctorNumber" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Doctor Name -->
                    <div>
                        <label asp-for="DoctorName" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("اسم الطبيب", "Doctor Name") *
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="DoctorName"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                                   placeholder="@T("أدخل اسم الطبيب", "Enter doctor name")" />
                        </div>
                        <span asp-validation-for="DoctorName" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Specialization -->
                    <div>
                        <label asp-for="Specialization" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("التخصص", "Specialization") *
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-stethoscope absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="Specialization"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                                   placeholder="@T("أدخل التخصص", "Enter specialization")" />
                        </div>
                        <span asp-validation-for="Specialization" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Consultation Fee -->
                    <div>
                        <label asp-for="ConsultationFee" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("رسوم الكشفية (د.أ)", "Consultation Fee (JOD)")
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-money-bill-wave absolute start-3.5 top-1/2 -translate-y-1/2 text-xs text-[#727A76]"></i>
                            <input asp-for="ConsultationFee" type="number" step="0.01"
                                   class="w-full ps-9 pe-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] placeholder-[#727A76] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition"
                                   placeholder="@T("أدخل الرسوم", "Enter fee")" />
                        </div>
                        <span asp-validation-for="ConsultationFee" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Department Assignment -->
                    <div>
                        <label asp-for="DepartmentId" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("تعيين القسم", "Department Assignment") *
                        </label>
                        <select asp-for="DepartmentId" id="doctorDepartmentSelect" asp-items="ViewBag.DepartmentId"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition">
                            <option value="">@T("-- اختر القسم --", "-- Select Department --")</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>

                    <!-- Specialty Assignment (Cascading from Department) -->
                    <div>
                        <label asp-for="SpecialtyId" class="block text-xs font-semibold text-[#202725] dark:text-[#EAEFEA] mb-1.5">
                            @T("التخصص الفرعي / الدقيق", "Sub-Specialty")
                        </label>
                        <select asp-for="SpecialtyId" id="doctorSpecialtySelect" asp-items="ViewBag.SpecialtyId"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-[#DDE3DF] dark:border-[#2B3833] bg-[#F6F7F5] dark:bg-[#151E1B] text-[#202725] dark:text-[#EAEFEA] text-xs focus:outline-none focus:ring-1 focus:ring-[#49665A] transition">
                            <option value="">@T("-- اختر التخصص الفرعي (اختياري) --", "-- Select Sub-Specialty (Optional) --")</option>
                        </select>
                        <span asp-validation-for="SpecialtyId" class="text-rose-400 text-[11px] mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-[#E5E9E7] dark:border-[#2B3833] mt-6">
                <a asp-action="Index"
                   class="px-4 py-2 rounded-xl border border-[#D5DDD8] dark:border-[#2B3833] bg-transparent hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#6B7D75] hover:text-rose-600 dark:text-[#9CA8A3] dark:hover:text-rose-400 text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-xmark text-xs"></i>
                    <span>@T("إلغاء", "Cancel")</span>
                </a>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-[#49665A] hover:bg-[#3D574D] text-white text-xs font-semibold shadow-sm transition flex items-center gap-1.5">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>@T("تحديث الطبيب", "Update Doctor")</span>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deptSelect = document.getElementById('doctorDepartmentSelect');
            const specSelect = document.getElementById('doctorSpecialtySelect');

            if (!deptSelect || !specSelect) return;

            function loadSpecialties(deptId, selectedSpecId) {
                specSelect.innerHTML = '<option value="">@T("-- جاري التحميل... --", "-- Loading... --")</option>';
                if (!deptId) {
                    specSelect.innerHTML = '<option value="">@T("-- اختر التخصص الفرعي (اختياري) --", "-- Select Sub-Specialty (Optional) --")</option>';
                    return;
                }

                fetch('/Departments/GetSpecialtiesByDepartment?departmentId=' + encodeURIComponent(deptId))
                    .then(res => res.json())
                    .then(data => {
                        specSelect.innerHTML = '<option value="">@T("-- اختر التخصص الفرعي (اختياري) --", "-- Select Sub-Specialty (Optional) --")</option>';
                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const opt = document.createElement('option');
                                opt.value = item.id;
                                opt.textContent = item.name;
                                if (selectedSpecId && item.id == selectedSpecId) {
                                    opt.selected = true;
                                }
                                specSelect.appendChild(opt);
                            });
                        }
                    })
                    .catch(err => {
                        console.error('Error fetching specialties:', err);
                        specSelect.innerHTML = '<option value="">@T("-- اختر التخصص الفرعي (اختياري) --", "-- Select Sub-Specialty (Optional) --")</option>';
                    });
            }

            deptSelect.addEventListener('change', function () {
                loadSpecialties(this.value, null);
            });

            if (deptSelect.value && (!specSelect.options || specSelect.options.length <= 1)) {
                loadSpecialties(deptSelect.value, '@(Model?.SpecialtyId?.ToString() ?? "")');
            }
        });
    </script>
}