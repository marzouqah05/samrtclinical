## .NET / ASP.NET Core .gitignore

# Build output
bin/
obj/

# User-specific files
*.user
*.suo
.vs/

# NuGet packages
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Secrets (never commit these)
appsettings.Production.json
secrets.json
